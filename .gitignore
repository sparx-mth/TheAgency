# Common local artifacts (keep the existing per-run rules above).
# Anchor output roots so package directories such as falcon_pegasus/runs/,
# source models/, and archived data/examples remain available for versioning.
# Ignore these entire root directories, including all nested files and folders.
/run/
/runs/
/run_artifacts/
/artifacts/
/outputs/
/results/
/recordings/
/videos/
/bags/
/rosbags/
/weights/
/models/
/checkpoints/
/datasets/
/nav_debug_frame_*.png

# Additional virtual environments, Python tooling, and download caches.
.venvs/
.venv-*/
.venv_*/
venv-*/
venv_*/
.conda/
.ruff_cache/
.pyright/
.uv_cache/
.huggingface/
.torch/

# Downloaded/exported model formats not covered by the existing weight rules.
*.safetensors
*.gguf
*.ggml
*.tflite
*.keras
*.h5
*.hdf5
pytorch_model*.bin
flax_model*.msgpack
saved_model.pb

# Video recordings and ROS bag storage; keep ordinary images and map fixtures.
*.[mM][pP]4
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM][oO][vV]
*.[wW][eE][bB][mM]
*.m4v
*.mpeg
*.mpg
*.h264
*.h265
*.bag
*.bag.active
*.bag.orig
*.db3
*.db3-shm
*.db3-wal

# Runtime logs, process state, and experiment-tracker output.
*.log
*.log.*
*.pid
*.pid.lock
wandb/
mlruns/
mlartifacts/
lightning_logs/
events.out.tfevents.*

# ROS workspace products. build/ is already ignored above.
/install/
/devel/
/log/
**/*_ws/install/
**/*_ws/devel/
**/*_ws/log/
.catkin_tools/
.colcon/
.ros/

# Local environment secrets; example/template files stay trackable.
.env.*
!.env.example
!.env.sample
!.env.template

# Temporary, interrupted-download, and editor backup files.
/tmp/
/temp/
.tmp/
.temp/
.history/
*.tmp
*.temp
*.part
*.partial
*.crdownload
*.swp
*.swo
*.bak
*~

# OS metadata.
.DS_Store
.AppleDouble
._*
Thumbs.db
Desktop.ini

# Small, intentional evidence/fixtures may be versioned outside output roots.
!docs/**/*.log
!docs/**/*.log.*
!**/tests/fixtures/**/*.log
!**/tests/fixtures/**/*.log.*

