# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
pre_baseline/docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/latest/usage/project/#working-with-version-control
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
myenv/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

isaac_sim/cache/*
isaac_sim/data/*
isaac_sim/documents/*  
isaac_sim/logs/*

orb_slam_module

sparx_agency/robots/ROBOTICAN/examples/src/*.csv
sparx_agency/robots/src/interfaces/ROBOTICAN/examples/src/keyboard_contorl/csv/*
sparx_agency/robots/src/interfaces/ROBOTICAN/examples/src/keyboard_contorl/__pycache__/
sparx_agency/robots/src/interfaces/ROBOTICAN/examples/src/paths/*
src/room_mapping/2025_12_25___09_40_51/
xtend_capture_out/*

gz-sim-environment
ROBOTICAN/examples
ORB-SLAM3-ROS2-Docker

# NOTE: no bare `*.png` here. The repo commits images routinely (1200+ tracked
# diagrams, calibration shots, README figures), which survived a former bare rule
# only because git ignores the ignore rule for already-tracked files. All it did
# was silently swallow NEW ones -- docs/diagrams/launch_demo.drawio.png is still
# untracked because of it. Generated images are ignored by their output dir
# instead (isaac_sim/, xtend_capture_out/, depth_optical/ ... below).
sparx_agency/build/
sparx_agency/log/
sparx_agency/install/
sparx_agency/tasks/planning/3D_planning/gibson/extracted/*
sparx_agency/tasks/localization/ros2/depth_optical/bags_files/*
sparx_agency/theagency_venv/*
requirements/active.txt


# ROS2 Bags
rosbag2_*/
*.mcap
# Bag metadata by NAME, never a bare `*.yaml`. A bare rule matched every config in
# the repo -- maps, mission presets, camera calibrations, bridge configs. The 42
# tracked ones survived only because git ignores the ignore rule for a file that is
# already tracked, so the rule silently swallowed exactly one thing: any config a
# developer ADDED. That failure is invisible locally (the file is right there and
# the node runs) and only surfaces as a missing file on the drone.
metadata.yaml
# Runtime log directories. Common log extensions are also ignored below, with
# exceptions for intentional documentation and test-fixture logs. Do not add
# blanket JSON/YAML/PNG rules: those extensions also contain project sources.
**/logs/
sparx_agency/tasks/planning/falcon/bridge/bridge.log

sparx_agency/tasks/common/bearings_placeholder.csv
sparx_agency/tasks/localization/data/
sparx_agency/tasks/localization/ros2/depth_optical/
/graphify-out/
/.claude/
CLAUDE.md


# VLA TensorRT build artifacts (large, per-machine, SM/TRT-version locked).
# Exported ONNX, built engines, calibration caches, timing caches and head-param
# dumps are regenerated by each VLA's trt/ tooling, never committed. The committed
# scheduler-parity golden (core/.../trt/tests/*.npz) and trt/configs/*.json stay
# tracked (only the engines/ output tree and these extensions are ignored).
# One rule per VLA -- glob the whole layer so a new VLA is covered on day one.
sparx_agency/tasks/planning/vlas/*/trt/engines/
sparx_agency/tasks/planning/navdp/engines/
*.onnx
*.engine
*.plan
*.ckpt
*.calib
*.cache

# Model weights are downloaded/built on the target, never committed: the YOLO(-World)
# and other checkpoints (e.g. yolov8s-worldv2.pt, auto-downloaded by ultralytics into
# the CWD on first run) and PyTorch state dicts.
*.pt
*.pth
*.weights

# Vendor ROBOTICAN/Sphera message sources, staged into the Docker build context
# by docker/devcontainer/stage_vendor_msgs.sh (old single-Dockerfile setup) or
# docker/stage_vendor_msgs.sh (modular bake.hcl setup). Delivered by the vendor
# outside this repo (~/rqs_iai_ws/src/rooster_interfaces) -- never committed here.
docker/devcontainer/vendor/
docker/vendor/
/sparx_agency/theagency_venv/

# FALCON flight logs (thought journal); see tasks/planning/falcon/run_falcon.sh
sparx_agency/tasks/planning/falcon/logs/

# Simulated flight recordings (chase-camera video); see
# tasks/planning/sim_flight_recording/run_flight.sh -- these are regenerated
# per run and copied out of the container, never committed.
*.mp4

# Surveyed-map previews are regenerated by survey_scene.py --preview; the .npz
# map itself IS committed (a few kB, and it makes a campaign reproducible).
sparx_agency/robots/PEGASUS/maps/*.png
sparx_agency/robots/PEGASUS/maps/*.ply

# Obstacle-duplication recipes from augment_scene.py -- regenerated per device
# (they reference this device's own scene-graph paths), never committed.
sparx_agency/robots/PEGASUS/scenes/

# Adversarial QA working directory (the /verify skill). Copilot runs there
# unattended with tools allowed, so it is deliberately outside the repo's tracked
# surface: nothing it writes can be committed by accident, and a probe asserting
# a bug we have since fixed cannot masquerade as a repo test. Tests that earn
# their place are rewritten to repo convention and land in the `tests/` directory
# beside the code they cover -- see the skill's promotion step.
.verify_scratch/

# Augmented scene layouts: per-run clutter placements (randomised obstacle poses)
# generated against a base Isaac scene. They are regenerated per campaign and are
# large, so they stay local; a hand-authored scene definition in this directory is
# still tracked.
sparx_agency/robots/PEGASUS/scenes/*_augmented.json
run_state/
