{
  "name": "ROS 2 Humble + Gazebo (TheAgency)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "user1",
      "USER_UID": "1000",
      "USER_GID": "1000",
      "ROS_DISTRO": "humble",
      "TARGETARCH": "amd64"
    }
  },
  
  "overrideCommand": [
    "/bin/sleep",
    "infinity"
  ],
  "userEnvProbe": "loginInteractiveShell",
  "remoteUser": "user1",
  "updateRemoteUserUID": true,

  "workspaceFolder": "/home/ws",
  "workspaceMount": "source=${localWorkspaceFolder}/sparx_agency,target=/home/ws,type=bind,consistency=cached",
  
  "mounts": [
    "source=${localWorkspaceFolder}/sparx_agency/../cache/humble/build,target=/home/ws/build,type=bind",
    "source=${localWorkspaceFolder}/sparx_agency/../cache/humble/install,target=/home/ws/install,type=bind",
    "source=${localWorkspaceFolder}/sparx_agency/../cache/humble/log,target=/home/ws/log,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/home/user1/.Xauthority,target=/user1/.Xauthority,type=bind",
    "source=${localWorkspaceFolder}/.gazebo,target=/home/ws/.gazebo,type=bind",
    "source=${localWorkspaceFolder}/.ignition,target=/home/ws/.ignition,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer,target=/home/ws/.devcontainer,type=bind",
    "source=${localWorkspaceFolder}/.vscode,target=/home/ws/.vscode,type=bind"
  ],
  "containerEnv": {
  "DISPLAY": ":1",
  "XAUTHORITY": "/tmp/.Xauthority",
  "QT_X11_NO_MITSHM": "1",
  "IGNITION_GUI_PLUGIN_PATH": "/usr/lib/x86_64-linux-gnu/ignition/ignition-gazebo6/gui-plugins",
  "LIBGL_ALWAYS_INDIRECT": "0",
  "XDG_RUNTIME_DIR": "/tmp/runtime-user1",
  "HOME": "/home/user1",
  "XDG_CONFIG_HOME": "/user1/.config",
   "__NV_PRIME_RENDER_OFFLOAD": "1",
  "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
  "NVIDIA_DRIVER_CAPABILITIES": "all"
  },
  "runArgs": [
  "--net=host",
   "--gpus", "all,\"capabilities=graphics,compute,utility,display\"",
  "--device", "/dev/dri:/dev/dri",
  "--group-add", "992",  // check in host using `getent group render`. Replace with your host 'render' GID
  "--group-add", "44"   //  check in host using `getent group video` . Replace with your host 'video' GID
  ],
  "runtime": "nvidia",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "redhat.vscode-xml"
      ]
    }
  },
  "postCreateCommand": "mkdir -p /tmp/runtime-user1 && chmod 700 /tmp/runtime-user1"
}