<?xml version="1.0" ?>
<robot name="turtlebot3_common_properties" xmlns:xacro="http://ros.org/wiki/xacro">
  <material name="light_black">
    <color rgba="0.0 0.0 0.0 0.0"/>
  </material>
  <material name="dark">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
</robot>   