<launch>
  <!--
    falcon_pegasus.launch — the whole FALCON stack, pointed at Isaac Sim.

    This is upstream's exploration.launch with its simulator amputated. The
    planner and the trajectory server are unmodified FALCON binaries; what
    changes is where their inputs come from and where their output goes:

      upstream                          here
      ==============================    ====================================
      map_render_node  -> depth image   Isaac Sim's RGBD camera, over TCP
      poscmd_2_odom    -> odometry      Isaac Sim's PhysX ground truth, over TCP
      poscmd_2_odom    <- pos_cmd       an outer-loop tracker driving PX4 SITL

    poscmd_2_odom is the one that matters. Upstream it feeds the position
    command straight back as the aircraft's state, so the aircraft is *defined*
    to be exactly where the planner asked — no lag, no drift, no tracking error.
    Replacing it with a real airframe is the whole point of this launch file, and
    it is why an outer-loop controller had to be written at all.

    Usage:
      roslaunch falcon_pegasus falcon_pegasus.launch run:=3_open_plan

    Start this BEFORE the Isaac Sim side: the bridge binds the sockets and the
    aircraft connects to them, because Kit takes minutes to load a stage and the
    ROS stack takes seconds.
  -->

  <!-- Which of runs/*.yaml to fly. That one file carries both FALCON's
       map_config and the aircraft's spawn pose, so they cannot disagree. -->
  <arg name="run" default="3_open_plan"/>

  <!-- Where to read that file from. The run file describes its exploration area
       in five numbers under `map_config.area`; FALCON wants the eighteen of
       `map_config.map_size`. run_falcon_pegasus.sh derives them on the host
       before the container starts and points this at the result, so a bad area
       fails there with a sentence rather than here with a glog CHECK.

       The default is the run file itself, which is what a direct
       `roslaunch` inside the container gets, and a run file using the compact
       `area` block will NOT work that way, because nothing has expanded it. Use
       the script, or pass an already-expanded file.

       (No double hyphens in this comment: XML forbids them, and roslaunch
       reports it as "Invalid roslaunch XML syntax" against the whole file.) -->
  <arg name="run_config" default="$(find falcon_pegasus)/runs/$(arg run).yaml"/>

  <!-- Video of the map being built. Set record:=false to fly without one. -->
  <arg name="record" default="true"/>
  <arg name="log_dir" default="/falcon_logs"/>
  <arg name="video_out" default="$(arg log_dir)/$(arg run)_map.mp4"/>
  <arg name="video_fps" default="10.0"/>

  <!-- FALCON's velocity ceiling. Two constraints, and the tighter one is not the
       obvious one.

       It must stay below PX4's MPC_XY_VEL_MAX (2.0 m/s) or PX4 clips the
       reference silently. But it must also stay below what the AIRFRAME can
       actually follow, which is a lot less: FALCON's B-spline is a reference
       for a point mass, and a real multirotor reaches a commanded velocity
       through tilt, so it lags. Measured on Isaac Sim at 1.0 m/s the aircraft
       ran two to three metres behind the reference through every corner; at
       0.6 m/s it holds it. This is the single most useful dial if a run
       diverges. -->
  <arg name="max_linear_velocity" default="0.6"/>
  <arg name="max_linear_acceleration" default="0.8"/>
  <!-- Yaw is how FALCON aims the camera at the frontier it chose, so it is part
       of the plan, not a cosmetic. Kept in step with PX4's MPC_YAWRAUTO_MAX,
       which the Isaac side raises to 60 deg/s for exactly this reason. -->
  <arg name="max_yaw_velocity" default="0.9"/>

  <!-- Refuse to fly if the aircraft renders with a different camera than the
       mapper unprojects with. Only turn this off to reproduce a broken map. -->
  <arg name="strict_intrinsics" default="true"/>

  <!-- Watch it live in FALCON's own RViz: the occupancy voxels, the ESDF, the
       frontier clusters, the sampled viewpoints, the hierarchical grid and the
       executed trajectory, all on its own config.

       Needs an X display reachable from the container, which run_falcon_pegasus.sh
       arranges when it is given —rviz. It also turns on the bridge's TF, without
       which RViz has no `world` frame and every display sits empty, and widens the
       drawn box to the full flight band, without which the voxel view is one 20 cm
       slice. Costs a few percent of a CPU core in exploration_node, which shares a
       thread with the mapper, so it is off by default. -->
  <!-- Minimum free radius around a frontier viewpoint, metres. Must exceed the
       airframe radius (robots/PEGASUS AIRFRAME_RADIUS_M = 0.35). -->
  <arg name="viewpoint_clearance" default="0.45"/>
  <!-- Weight of the B-spline's obstacle term; see the param below. -->
  <arg name="obstacle_weight" default="100.0"/>

  <arg name="rviz" default="false"/>
  <!-- The z band RViz draws, and the reason the FLOOR is invisible if you get
       it wrong. Every publisher in map_server.cpp — occupancy grid, TSDF, ESDF
       and all three slices — iterates `vbox_min_idx_` to `vbox_max_idx_`, so
       vbox is a *view*, not a map bound: voxels outside it are fused, planned
       against and counted as coverage, and simply never published. Fusion is
       clipped by the MAP box only (tsdf.cpp clamps rays with
       `closestPointInMap` and skips voxels failing `isInMap`), and every
       runs/*.yaml puts map_min_z at -0.2 or -0.3, below the ground. So the
       floor has always been in the map; a band starting at 0.9 just never drew
       it, and "the drone is flying too high to see the floor" is the wrong
       diagnosis to reach for.

       Starts below the ground plane for that reason. -0.2 is the highest
       map_min_z any run uses, and map_server CHECKs map_min <= vbox_min, so
       this is the lowest value valid for every run. Costs about twice the
       voxel-view work of the old 0.9 band (26 z-layers instead of 14, at 2 Hz,
       in the thread that also services the depth callbacks) and it buys a
       ground plane you can judge altitude against.

       The floor is a solid sheet under everything, so a top-down RViz camera
       now shows the floor and nothing else; orbit down to eye level, or raise
       this back to 0.9, to read the map as a floor plan again. The recorded
       map video is unaffected — it draws the 20 cm cruise slab from
       runs/*.yaml, which is the cut that makes a top-down video legible. -->
  <arg name="viz_min_z" default="-0.2"/>
  <arg name="viz_max_z" default="2.3"/>
  <!-- Size of the drone mesh in RViz. 1.0 draws it at roughly the Iris's real
       0.7 m rotor span, so its footprint against the voxels is honest. -->
  <arg name="drone_scale" default="1.0"/>

  <!-- ── The clock FALCON plans on ────────────────────────────────────────
       TRUE, and that is the point of this deployment. Isaac Sim manages about
       0.63 of real time here, so on the wall clock FALCON issues a schedule
       advancing ~1.6 s for every second of flight the aircraft is given: a
       standing lag the tracker cannot close, regenerated by every replan.
       pegasus_bridge_node publishes /clock from the aircraft's own timestamps,
       so FALCON's timers, replan cadence and trajectory stamps all run at the
       rate the aircraft can actually fly.

       Upstream aborts on this: exploration_node.cpp opens with
       CHECK(!use_sim_time), a glog fatal, because THEIR simulator feeds the
       position command back as the state and runs on the wall clock. That check
       is patched out by patches/allow_sim_time.sh, which must be in the image.
       An unpatched image dies at start-up with "Please set use_sim_time to
       false" rather than degrading.

       Set it false to get the old behaviour back for a comparison; the bridge
       simply stops being the clock source and nothing else changes. -->
  <!-- ── Replan from the aircraft, not from the plan ──────────────────────
       FALCON's replan branch reads its start state off its own PREVIOUS
       trajectory and never looks at odometry (exploration_fsm.cpp, "Replan
       from non-static state"). For upstream's poscmd_2_odom simulator that is
       an identity, because the command IS the state. For a real airframe the
       two diverge, the new curve starts where the aircraft is not, and the
       error is invisible to the planner so it accumulates instead of decaying.
       Seen as the aircraft never catching the point FALCON believes it is at,
       up to 9.5 m and growing.

       Above this gap, plan from the measured state instead. Below it, keep
       upstream's prediction, which is what makes consecutive curves join
       smoothly. 1.0 m is comfortably beyond normal tracking (0.12 m
       cross-track in healthy flight) and well inside the corridor widths here.
       patches/replan_from_measured_state.sh defaults it to 1e9, i.e. inert, so
       an unpatched image and an unset parameter both behave as upstream. -->
  <arg name="replan_start_tolerance" default="1.0"/>
  <param name="/exploration_node/replan_start_tolerance"
         value="$(arg replan_start_tolerance)"/>

  <!-- The second re-anchor trigger: the aircraft has STOPPED while the plan
       still expects it moving. This is the emergency-stop / unsafe-hold / wedged
       case — where the position gap has often not grown yet, so the tolerance
       above would not fire, yet planning a fresh curve from a future point a
       stopped aircraft will never reach is exactly the deadlock to avoid. When
       measured speed is below this while the predicted start still carries
       velocity, FALCON replans from where the aircraft actually is. Defaults to
       -1 (inert) in the patch, so an unset value is upstream behaviour. -->
  <arg name="replan_stopped_speed" default="0.10"/>
  <param name="/exploration_node/replan_stopped_speed"
         value="$(arg replan_stopped_speed)"/>

  <arg name="use_sim_time" default="true"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- ── FALCON's own configuration, exactly as exploration.launch loads it ──
       exploration_node uses a private node handle but every parameter name it
       reads is absolute, so all of this has to go on the GLOBAL parameter
       server. <param> tags inside a <node> block would never reach it. -->
  <rosparam command="load" file="$(find exploration_manager)/config/robot/uav_model_simulator.yaml"/>
  <rosparam command="load" file="$(find voxel_mapping)/config/voxel_mapping.yaml"/>
  <rosparam command="load" file="$(find pathfinding)/config/astar.yaml"/>
  <rosparam command="load" file="$(find fast_planner)/config/fast_planner.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/frontier_finder.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/hgrid.yaml"/>
  <rosparam command="load" file="$(find exploration_utils)/config/perception_utils.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/exploration_manager.yaml"/>

  <!-- ── This run: FALCON's map_config plus the aircraft's spawn pose ─────── -->
  <rosparam command="load" file="$(arg run_config)"/>

  <!-- ── Flight envelope ──────────────────────────────────────────────────── -->
  <param name="/uav_model/dynamics_parameters/max_linear_velocity" value="$(arg max_linear_velocity)"/>
  <param name="/uav_model/dynamics_parameters/max_linear_acceleration" value="$(arg max_linear_acceleration)"/>
  <param name="/uav_model/dynamics_parameters/max_yaw_velocity" value="$(arg max_yaw_velocity)"/>

  <!-- The camera the Isaac aircraft actually renders with: FALCON's own
       reference sensor, so these are the values already in
       uav_model_simulator.yaml and are restated only to make the contract
       explicit. The bridge compares them against what the aircraft announces
       and refuses to run on a mismatch. -->
  <param name="/uav_model/sensing_parameters/image_width" value="640"/>
  <param name="/uav_model/sensing_parameters/image_height" value="480"/>
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fx" value="320.0"/>
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fy" value="320.0"/>
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cx" value="320.0"/>
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cy" value="240.0"/>

  <!-- How far the depth stream is trusted, and therefore how big the known
       bubble around the aircraft is. Upstream's 5 m suits the small rooms FALCON
       ships configured for; here it left the aircraft with a 5 m disc of known
       space in a 30 m room, and the coverage tour's next cell was outside it.
       The simulated camera sees far further than this, so raising it costs only
       raycasting time. -->
  <param name="/voxel_mapping/tsdf/raycast_max" value="8.0"/>

  <!-- How much room a frontier VIEWPOINT must have before FALCON will fly to it.
       Upstream's 0.21 m is smaller than this airframe's own radius (0.35 m to
       the rotor tips), so the planner was free to choose observation points the
       drone physically cannot occupy, and then route to them correctly. That is
       the "FALCON does not know how big the drone is" problem in its most
       concrete form, and unlike the B-spline's clearance below it costs nothing
       in doorways: it constrains where the aircraft STOPS to look, not the
       corridor it flies down to get there. -->
  <param name="/frontier_finder/min_candidate_clearance" value="$(arg viewpoint_clearance)"/>

  <!-- Upstream's obstacle clearance for the B-spline, restated because it is
       the wrong dial to reach for and this is where you would reach for it.
       Raising it to 0.9 m to stop the aircraft clipping a wall did stop that,
       and also made every office doorway impassable — a 0.9 m corridor of free
       space cannot contain a trajectory required to stay 0.9 m from both sides,
       so the aircraft parked in a room it had entered and FALCON replanned
       a hold until the budget ran out. The wall clipping had a different
       cause (an exploration box edge lying ON the wall) and a different fix
       (inset the box; see any runs/*.yaml). -->
  <param name="/bspline_opt/safe_distance" value="0.7"/>

  <!-- How hard the optimiser is allowed to pull away from walls, which turns out
       to be the dial that `safe_distance` is mistaken for. That clearance is not
       a constraint: it is the knee of a soft penalty, ``(dist - safe)^2`` when
       ``dist < safe``, summed against smoothness (20), start (100) and end (50).
       So raising the DISTANCE makes the optimiser fight itself everywhere and
       shuts doorways; raising the WEIGHT makes it win where there is room to win
       and lose where the endpoints demand a thread, which is the behaviour we
       actually want out of a corridor.

       This is the soft half of what the Gazebo stack did with a hard wall
       dilation plus a wall-proximity cost that centred routes in corridors. The
       hard half has no equivalent here — FALCON's A* searches the raw occupancy
       grid, so dilating by the airframe radius means changing its C++ — but the
       soft half is one parameter, and centring the trajectory is most of the
       benefit when the tracker is following it to within tens of centimetres. -->
  <param name="/bspline_opt/pos/distance" value="$(arg obstacle_weight)"/>

  <!-- Draw the occupancy slab at cruise height so the recorder gets a
       horizontal cut of the map rather than a projection of the whole slab. -->
  <param name="/voxel_mapping/occupancy_grid_slice_height" value="1.4"/>

  <!-- The visualisation box is a 20 cm slab at cruise height (see any
       runs/*.yaml) because that is all the map recorder draws and every extra
       layer is another full pass over the voxel grid at 2 Hz. RViz wants the
       whole flight band or the voxels look like a single contour line — and it
       wants the ground plane under that band, or there is no floor to see — so
       the slab is widened back out when RViz is running and only then. Nothing
       here changes what is mapped; see viz_min_z above. -->
  <group if="$(arg rviz)">
    <param name="/map_config/map_size/vbox_min_z" value="$(arg viz_min_z)"/>
    <param name="/map_config/map_size/vbox_max_z" value="$(arg viz_max_z)"/>
  </group>

  <!-- ── A* search budgets ────────────────────────────────────────────────
       Upstream allows the default profile ONE MILLISECOND and the coarse one a
       tenth of that (pathfinding/config/astar.yaml). Those budgets are sized for
       the 30 x 30 m rooms FALCON ships configured for. This building is
       28 x 72 m, and the coverage tour routinely sends the aircraft to the far
       end of it: a 40 m route at 1 m resolution is a few thousand nodes, and
       every edge is validated at 10 cm intervals, so it is tens of milliseconds
       of work whatever the machine.

       Measured with the upstream budgets: the aircraft explored its local area
       for 80 seconds, the tour picked a cell 40 m away, every search timed out,
       and the FSM sat in PLAN_TRAJ emitting trajectories that went nowhere while
       the aircraft held station perfectly. It looks exactly like a wedged
       aircraft, and is not.

       Raised, but bounded, and the bound is the important half. The planner
       runs inside the same single-threaded node that services the depth
       callbacks and the 20 Hz collision check, so time spent searching is time
       the map is not updated and the current trajectory is not re-checked.
       Measured, and this is why they are back near upstream's: at a 250 ms
       MEDIUM budget the aircraft flew into two walls it had already mapped,
       because the 20 Hz callback that would have stopped it was waiting behind a
       search. Bigger budgets DO let the aircraft cross the building, and cost
       more than crossing the building is worth. The price paid instead is that
       a long route sometimes cannot be planned, the trajectory id stops
       advancing, and the run ends as `planner_stopped` — a detected, clean
       ending with everything flown up to it intact.
       MEDIUM is the long-route profile and only runs when DEFAULT has already
       failed, which is why it still gets the most. -->
  <param name="/astar/profile/default/max_search_time" value="0.005"/>
  <param name="/astar/profile/coarse/max_search_time" value="0.002"/>
  <param name="/astar/profile/coarse2/max_search_time" value="0.005"/>
  <param name="/astar/profile/medium/max_search_time" value="0.050"/>

  <!-- How big the drone is, as far as the route planner is concerned.
       Upstream A* tests a single voxel per node and has no notion of a radius,
       so it will route a 0.7 m aircraft through a 0.3 m gap; the B-spline
       optimiser then cannot thread that route and the FSM loops on
       "Collision detected on the trajectory before publishing" until the
       aircraft's stall watchdog ends the run. Added by
       patches/inflate_astar_by_airframe.sh, which defaults both to 0 so an
       unpatched or baseline image behaves exactly as upstream.

       Inflation is XY only; the rotor disc is horizontal, and inflating z
       would eat most of the 1.2 m exploration band for an airframe 0.15 m tall.

       AIRFRAME_RADIUS_M, so the planner can never route somewhere the aircraft
       physically does not fit. Note what this costs: the room warren's doors are
       0.8-0.9 m, which leaves one to two free voxels through them at 0.1 m
       resolution. If `2_room_warren` stops finding routes into the rooms, this
       is the number to lower, and lowering it needs no rebuild. -->
  <!-- 0.35. It was briefly dropped to 0.20 to compensate for collider fusion
       making the map more conservative ("No path" errors went 215 to 2358 with
       fusion on, and FALCON stopped planning). Restored with fusion, because
       fusion is off by default again: lowering the padding without the fuller
       map it was compensating for just lets the aircraft plan closer to things.
       Lower it again only together with the collider-fusion flag. -->
  <arg name="astar_inflate" default="0.35"/>
  <param name="/astar/inflate_radius" value="$(arg astar_inflate)"/>
  <!-- Inflation is suppressed within this of the search start. An aircraft that
       has drifted against a wall is inside its own skirt, and without this
       exemption it has no valid start node and can never plan away from it,
       so the dilation meant to stop it wedging would itself become the wedge.
       Wider than the inflation, by about one coarse A* step. -->
  <param name="/astar/start_clearance" value="0.50"/>

  <!-- traj_server's open-loop take-off ramp, disabled. Upstream uses it to walk
       the position setpoint 1 m up and 1 m forward before any trajectory
       exists; here the aircraft has already climbed to cruise altitude under
       PX4 by the time FALCON's odometry starts, so the pre-trajectory command
       must be a plain hover at the init pose. -->
  <param name="/traj_server/init_dx" value="0.0"/>
  <param name="/traj_server/init_dy" value="0.0"/>
  <param name="/traj_server/init_dz" value="0.0"/>

  <!-- ── FALCON, unmodified ───────────────────────────────────────────────── -->
  <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
    <remap from="/odom_world" to="/uav_simulator/odometry"/>
    <remap from="/voxel_mapping/depth_image" to="/uav_simulator/depth_image"/>
    <remap from="/transformer/sensor_pose_topic" to="/uav_simulator/sensor_pose"/>
  </node>

  <node pkg="fast_planner" name="traj_server" type="traj_server" output="screen"/>

  <!-- ── The simulator that replaces uav_simulator ────────────────────────── -->
  <node pkg="falcon_pegasus" name="pegasus_bridge" type="pegasus_bridge_node.py" output="screen">
    <param name="strict_intrinsics" value="$(arg strict_intrinsics)"/>
    <param name="publish_tf" value="$(arg rviz)"/>
  </node>

  <!-- FALCON's own RViz config, unmodified: exploration_manager/config/rviz.rviz.
       Several of its displays point at topics from rigs that are not running here
       (VINS, AirSim, a motion-capture pose); they simply stay empty. -->
  <!-- The aircraft itself, in RViz. FALCON's own rviz config already has the
       displays for /odom_visualization/{pose,robot,path} and they sit empty
       without this, which is why the map appears and the drone does not. Scaled
       to the real airframe so "is it about to touch that wall" is answerable by
       looking: the mesh is the size of the thing that would hit it. -->
  <node if="$(arg rviz)" pkg="odom_visualization" name="odom_visualization"
        type="odom_visualization" output="log">
    <remap from="~odometry" to="/uav_simulator/odometry"/>
    <param name="robot_scale" value="$(arg drone_scale)"/>
    <param name="frame_id" value="world"/>
    <param name="color/r" value="0.1"/>
    <param name="color/g" value="1.0"/>
    <param name="color/b" value="0.3"/>
    <param name="color/a" value="1.0"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" name="rviz" type="rviz" output="log"
        args="-d $(find exploration_manager)/config/rviz.rviz"/>

  <node if="$(arg record)" pkg="falcon_pegasus" name="map_recorder"
        type="map_recorder_node.py" output="screen">
    <param name="output" value="$(arg video_out)"/>
    <param name="fps" value="$(arg video_fps)"/>
    <param name="title" value="FALCON exploration - $(arg run)"/>
  </node>
</launch>
