<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS config for ros1_bridge (Foxy) ↔ Gazebo sim (Humble).

  CRITICAL: Do NOT restrict NetworkInterfaceAddress to "lo" —
  the loopback interface is not multicast-capable, which breaks
  SPDP participant discovery between containers.

  With ‑‑net=host every container shares the host stack, so
  standard multicast on the default interface works fine.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <General>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>