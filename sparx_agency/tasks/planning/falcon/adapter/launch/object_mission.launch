    <arg name="esdf_occ_thresh"              value="$(arg esdf_occ_thresh)" />
    <arg name="resample_min_spacing_m"       value="$(arg resample_min_spacing_m)" />
    <arg name="simplify_debug"               value="$(arg simplify_debug)" />
    <arg name="simplify_merge"               value="$(arg simplify_merge)" />
