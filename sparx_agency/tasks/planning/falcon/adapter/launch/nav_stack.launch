<launch>
  <!--
    nav_stack.launch  (v8 — bev_publisher v4 wiring)

    Shared FALCON nav-stack core. Used directly for the Gazebo sim, and
    included by real_drone.launch (which only adds the pose/depth bridge
    nodes in front of it) for the real drone.
    ════════════════════════════════════════════════════════════════════
    v8 vs v7:
      - bev_publisher upgraded to v4: height-weighted column projection,
        3D neighbour confirm, door/window protection, and wall completion.
        Every pipeline stage is now a bev_* arg; the defaults already
        de-noise the map, so overriding any of them is optional.
      - bev_publish_hz 2.0 -> 10.0. The publish timer caps how often the
        grid is recomputed and republished, so 10 Hz is needed to meet the
        mapping-loop rate.
      - Removed the dead z_slab_min / z_slab_max params. v4 uses the full
        weighted column (z_floor / z_ceil / z_peak) instead of a thin slab.
        bev_z_peak defaults to cruise_z so the weighting peak always tracks
        the flight altitude.
      - Dropped the redundant occ_topic / free_topic params from the bev
        node — it already defaults to exactly those two FALCON topics.

    v7 vs v5:
      - Camera intrinsics are now <arg>s (cam_fx, cam_fy, cam_cx, cam_cy,
        cam_width, cam_height, cam_min_depth, cam_max_depth). Defaults
        are the xtend drone K-matrix values for the 504x392 stream.
        Override from real_drone.launch or the command line per camera.

    v5 vs v4:
      - Added `bridge_camera_info` arg (default false). sensor_gate
        will neither subscribe to camera_info nor republish it. FALCON
        reads camera intrinsics from rosparam below, so the topic was
        redundant. Set to true to restore the v4 behaviour.

    v4 vs v3:
      - Added `pose_topic`, `depth_topic`, `camera_info_topic` args.
      - sensor_gate receives those topic names via private params.
  -->

  <!-- ══════════════════════════════════════════════════════════════
       USER-FACING ARGS
       ══════════════════════════════════════════════════════════════ -->
  <arg name="map_name" default="hospital" />
  <arg name="drone_ns" default="/simple_drone" />
  <arg name="gated_ns" default="/gated_drone" />

  <!-- v4: input topic overrides. Defaults preserve the v3 sjtu_drone
       layout, so leaving these unset gives identical Gazebo behaviour. -->
  <arg name="pose_topic"
       default="$(arg drone_ns)/gt_pose" />
  <arg name="depth_topic"
       default="$(arg drone_ns)/front_depth/depth/image_raw" />
  <arg name="camera_info_topic"
       default="$(arg drone_ns)/front_depth/depth/camera_info" />

  <!-- v5: when false, sensor_gate ignores camera_info entirely. -->
  <arg name="bridge_camera_info" default="false" />

  <!-- RGB/depth transport for navdp_click (and, via real_drone.launch, for
       mapping_sync). frame_path (default): the drone wrote .jpg/.npy to disk and
       publishes std_msgs/String "<path> <sec> <nsec>"; the nodes load the files.
       topic: raw sensor_msgs/Image straight off the wire (Gazebo sim or an old
       bag replay, where nothing writes frame files). When 'topic', the navdp_*
       image-topic defaults below flip to /xtend/rgb + /xtend/depth_m. -->
  <arg name="image_transport" default="frame_path" /><!-- frame_path | topic -->

  <!-- sensor_gate rotation freeze. Default true (the Gazebo path: sensor_gate's
       gated pose+depth feed falcon_adapter, so freezing both keeps that pair
       consistent across a turn). real_drone.launch sets this false: there the
       depth no longer reaches sensor_gate (it arrives as a frame-path the voxel
       feeder mapping_sync loads, and mapping_sync owns the AUTHORITATIVE freeze),
       so a depth-driven resume would never fire and would strand the gated pose. -->
  <arg name="sensor_gate_freeze_on_turning_mode" default="true" />

  <!-- Camera intrinsics — loaded from a camera_calibration_parsers
       YAML (camera_config_file) when set; the cam_* args below act as
       both the literal fallback (when camera_config_file:='') and the
       CLI override path (`roslaunch ... cam_fx:=...`).

       Source is the YAML's `projection_matrix.data` (the rectified
       3x4 P matrix), NOT camera_matrix.data. Reason: after image
       rectification and crop, the principal point and effective focal
       length live in the upper-left 3x3 block of P; K still describes
       the unrectified raw sensor. Falcon consumes the rectified
       stream, so it needs P-derived intrinsics.

       P is a 12-element row-major array. The mapping is:
         fx = P[0]   cx = P[2]
         fy = P[5]   cy = P[6]
       The rest of P encodes the (zero here) stereo baseline and the
       0/0/0/1 homogeneous row, which we ignore for monocular use.

       Fallback literals match projection_matrix.data from
       config/camera_xtend_ros_calib_504_392_crop_resize.yaml.
       MUST match the actual depth stream — if image_width /
       image_height don't match, frames are silently dropped. -->
  <arg name="camera_config_file"
       default="$(find falcon_adapter)/config/camera_xtend_ros_calib_504_392_crop_resize.yaml"
       doc="Path to a camera_calibration_parsers YAML. Empty disables YAML loading." />
<!--   <arg name="cam_fx"        default="241.01587457199156" /> -->
<!--   <arg name="cam_fy"        default="273.842961729908" /> -->
<!--   <arg name="cam_cx"        default="224.89565972039185" /> -->
<!--   <arg name="cam_cy"        default="77.84205744139527" /> -->
<!--   <arg name="cam_width"     default="480" /> -->
<!--   <arg name="cam_height"    default="280" /> -->
<!--   <arg name="cam_min_depth" default="0.1" /> -->
<!--   <arg name="cam_max_depth" default="10.0" /> -->
  <arg name="cam_fx"        default="253.066668300591147" />
  <arg name="cam_fy"        default="287.535109816403349" />
  <arg name="cam_cx"        default="236.140442706411449" />
  <arg name="cam_cy"        default="81.734160313465040" />
  <arg name="cam_width"     default="504" />
  <arg name="cam_height"    default="294" />
  <arg name="cam_min_depth" default="0.1" />
  <arg name="cam_max_depth" default="10.0" />

  <!-- Goal -->
  <arg name="goal_x" default="4.0" />
  <arg name="goal_y" default="0.0" />

  <!-- ══════════════════════════════════════════════════════════════
       CONTROLLER SELECTION. "waypoint" (default) = the one-axis follower
       (pure X advance OR pure yaw, never both). "multi_axis" = the combined
       forward+lateral+yaw tracker that crabs (ROLL) for small offsets and yaws
       only past a deadband, so the noisy yaw axis is used sparingly. Both hold
       altitude (vz=0). Switch back to the legacy controller with controller:=waypoint. -->
  <arg name="controller"            default="pure_pursuit" /><!-- waypoint | multi_axis | pure_pursuit -->

  <!-- Multi-axis controller tuning (only used when controller:=multi_axis). All
       ~mx_* so they never collide with the one-axis params; cruise speed and the
       capture radius are shared with vel_x / pos_acquisition_radius. -->
  <arg name="mx_lateral_speed_max"      default="0.25" /><!-- max sideways (crab) speed (m/s); usually < cruise -->
  <arg name="mx_yaw_rate"               default="0.6" /><!-- saturation on the yaw rate during a turn (rad/s) -->
  <arg name="mx_slow_radius"            default="0.8" /><!-- start ramping speed down inside this range of the FINAL goal (m) -->
  <arg name="mx_arrive_speed_min"       default="0.08" /><!-- speed floor while outside pos_radius (m/s); never crawl to a noisy stop -->
  <arg name="mx_yaw_engage_deg"         default="25.0" /><!-- heading error above which yaw engages; below it the drone crabs (no yaw) -->
  <arg name="mx_yaw_release_deg"        default="10.0" /><!-- heading error below which yaw releases (hysteresis; < engage) -->
  <arg name="mx_yaw_kp"                 default="1.2" /><!-- proportional gain heading-error -> yaw rate (1/s), saturated to mx_yaw_rate -->
  <arg name="mx_travel_cone_deg"        default="80.0" /><!-- max body angle off forward the translation may point; yaw rotates the cone onto the target (perception safety) -->
  <arg name="mx_translate_suppress_deg" default="120.0" /><!-- heading error at/above which translation is throttled so the drone mostly yaws first (> cone) -->
  <arg name="mx_translate_suppress_floor" default="0.2" /><!-- fraction of speed kept when grossly mis-pointed (creeps, never fully stops) -->
  <arg name="mx_min_vx"                 default="0.06" /><!-- min forward speed that actually moves the platform (m/s) -->
  <arg name="mx_min_vy"                 default="0.06" /><!-- min lateral speed that actually moves the platform (m/s) -->
  <arg name="mx_min_wz_deg"             default="8.0" /><!-- min yaw rate that actually rotates the platform (deg/s) -->
  <arg name="mx_min_release_frac"       default="0.5" /><!-- below release_frac*min an axis is dropped to 0; between that and min it is snapped up to min -->
  <arg name="mx_hold_deadband"          default="0.18" /><!-- station-keeping: positional error below this is left uncorrected (ride out the standstill noise) (m) -->
  <arg name="mx_hold_kp"                default="0.8" /><!-- station-keeping correction gain (1/s) -->
  <arg name="mx_hold_speed_max"         default="0.2" /><!-- cap on the station-keeping correction speed (m/s) -->
  <arg name="mx_hold_reacquire_margin"  default="0.15" /><!-- drift past pos_radius+this while holding -> resume full pursuit (m) -->
  <arg name="mx_passed_bearing_deg"     default="110.0" /><!-- a NON-final waypoint whose bearing exceeds this is treated as passed/behind -->
  <arg name="mx_demo_mode"              default="fly_straight" /><!-- DemoMode requested (best-effort) for the multi-axis controller -->
  <arg name="mx_require_mode"           default="false" /><!-- gate motion on the demo mode being confirmed (false: proceed regardless) -->

  <!-- Pure-pursuit controller (only used when controller:=pure_pursuit): splines
       the final path (core HermiteSmoother) then tracks it with the core
       PurePursuitTracker on a moving lookahead. Tracker tuning ~pp_*, spline
       ~pp_smooth_*. Holonomic so it crabs+yaws toward the lookahead (linear.y on,
       altitude held). Reuses the multi-axis ~mx_demo_mode/~mx_require_mode. -->
  <arg name="pp_holonomic"            default="true" /><!-- velocity points at the lookahead (vx+vy); false = unicycle (yaw only) -->
  <arg name="pp_cruise_speed"         default="0.3" /><!-- nominal tracking speed (m/s) -->
  <arg name="pp_min_speed"            default="0.1" /><!-- speed floor before goal (m/s) -->
  <arg name="pp_max_speed"            default="0.5" /><!-- speed cap (m/s) -->
  <arg name="pp_base_lookahead"       default="0.6" /><!-- base lookahead distance (m) -->
  <arg name="pp_min_lookahead"        default="0.3" /><!-- min adaptive lookahead (m) -->
  <arg name="pp_max_lookahead"        default="1.5" /><!-- max adaptive lookahead (m) -->
  <arg name="pp_lookahead_speed_gain" default="0.5" /><!-- lookahead grows with speed by this gain -->
  <arg name="pp_goal_tolerance"       default="0.35" /><!-- distance to goal that counts as reached (m) -->
  <arg name="pp_path_tolerance"       default="0.8" /><!-- cross-track error that stops tracking as diverged (m) -->
  <arg name="pp_max_yaw_rate"         default="0.6" /><!-- yaw-rate cap (rad/s) -->
  <arg name="pp_curvature_speed_factor"     default="0.5" /><!-- slow down in curves -->
  <arg name="pp_curvature_lookahead_factor" default="0.8" /><!-- shorten lookahead in curves -->
  <arg name="pp_slow_down_distance"   default="1.0" /><!-- start decelerating this far from the goal (m) -->
  <arg name="pp_speed_smoothing"      default="0.3" /><!-- EMA on the commanded speed (0..1) -->
  <arg name="pp_yaw_rate_smoothing"   default="0.3" /><!-- EMA on the commanded yaw rate (0..1) -->
  <arg name="pp_sample_dt"            default="0.05" /><!-- tracker re-sampling of the trajectory (s) -->
  <arg name="pp_closest_search_back"    default="10" /><!-- closest-point search window (samples) -->
  <arg name="pp_closest_search_forward" default="120" />
  <!-- Hermite spline of the path -->
  <arg name="pp_smooth_dt"            default="0.02" /><!-- spline trajectory time step (s) -->
  <arg name="pp_smooth_min_point_spacing" default="0.05" /><!-- merge raw points closer than this (m) -->
  <arg name="pp_smooth_tangent_scale" default="0.5" /><!-- Hermite tangent magnitude scale -->
  <arg name="pp_smooth_nominal_speed" default="0.4" /><!-- spline timing speed (m/s); does not bound tracking -->
  <arg name="pp_smooth_arc_lut_samples" default="600" /><!-- arc-length LUT resolution -->
  <arg name="pp_smooth_zero_endpoint_velocity" default="false" /><!-- zero velocity at the path ends -->
  <!-- Per-axis minimum force (platform deadband) on the pure-pursuit output -->
  <arg name="pp_min_vx"               default="0.06" /><!-- min forward speed that moves the platform (m/s) -->
  <arg name="pp_min_vy"               default="0.06" /><!-- min lateral speed that moves the platform (m/s) -->
  <arg name="pp_min_wz_deg"           default="8.0" /><!-- min yaw rate that rotates the platform (deg/s) -->
  <arg name="pp_min_release_frac"     default="0.5" /><!-- below release_frac*min an axis is dropped to 0 -->
  <arg name="pp_viz_sample_dt"        default="0.1" /><!-- smooth-path viz sampling (s) -->
  <!-- Visualization topics consumed by the BEV viewer (bev_click_goal_node) -->
  <arg name="smooth_path_topic"       default="/path/smooth" /><!-- splined trajectory (Path) -->
  <arg name="lookahead_topic"         default="/path/lookahead" /><!-- current aim point (PointStamped) -->

  <!-- Speeds & radii -->
  <arg name="vel_x"                  default="0.3" />
  <arg name="yaw_rate"               default="0.7" />
  <arg name="pos_acquisition_radius" default="0.3" />
  <arg name="yaw_acquisition_radius" default="0.2" /><!-- now LIVE: cross-track tolerance (m) for the gentle predictive ADVANCE gate (was previously read by nobody) -->
  <arg name="yaw_lead_pct"           default="10.0" /><!-- deprecated (unused by the pulse->settle yaw loop); kept for config compatibility -->

  <!-- Yaw: pulse -> settle -> re-measure (slow turn, strong inertia, jumpy yaw) -->
  <arg name="yaw_settle_dwell_s"  default="0.8" /><!-- dwell (s) after a burst coasts to a stop so AprilTag yaw re-converges before re-measuring -->
  <arg name="yaw_coast_deg"       default="15.0" /><!-- physical yaw still swept after the command stops; the burst aims this much short of the target -->
  <arg name="yaw_burst_max_deg"   default="25.0" /><!-- per-burst increment: a big turn (e.g. 80deg) is split into ~25deg chunks, each followed by a stop + voxel update + re-measure, not one open-loop sweep -->
  <arg name="min_motion_ticks"    default="2" /><!-- min consecutive ctrl ticks for forward OR yaw; a lone 5Hz pulse can't overcome the deadband (drone neither turns nor moves) -->
  <arg name="cmd_commit_ticks"    default="2" /><!-- output guarantee: a stop (zero twist) never reaches the drone until the motion ran >=this many ticks; a lone motion->stop is held to the floor first -->
  <arg name="cmd_stop_eps"        default="0.001" /><!-- |vx| and |wz| both below this = "stop" for the commit gate -->
  <arg name="yaw_acquire_max_deg" default="35.0" /><!-- hardest heading error the gentle ADVANCE gate will ever accept -->

  <!-- ══════════════════════════════════════════════════════════════
       GRADED-PULSE YAW + MID-BURST FEEDBACK + ANTI-DEADLOCK (real-drone yaw).
       Needs ctrl_rate_hz:=10 for the 4deg/tick -> 8deg-min / 24deg-cap numbers.
       All default to the legacy behaviour at the core; enabled here. -->
  <arg name="yaw_graded_pulses"     default="true" /><!-- size each burst by tick count {2,4,6} (strong/med/weak), hard 6-tick cap, vary DURATION not magnitude -->
  <arg name="yaw_burst_grade_max_ticks" default="6" /><!-- max consecutive yaw ticks in one burst (6 ticks = 24deg @10Hz) -->
  <arg name="yaw_settle_dwell_per_tick" default="0.1" /><!-- extra settle (s) per burst tick: more continuous rotation -> more inertia -> longer stop before re-measuring -->
  <arg name="yaw_burst_live_feedback" default="true" /><!-- use the (estimator-denoised) live heading mid-burst to CUT a burst short on confirmed overshoot (one-way; never reverses in flight) -->
  <arg name="yaw_fb_reach_deg"      default="2.0" /><!-- remaining-in-burst-direction (deg) at/below which the live heading counts as having reached the target -->
  <arg name="yaw_fb_confirm_ticks"  default="2" /><!-- consecutive 'reached' ticks before cutting (rejects a single jumpy localization frame) -->
  <arg name="yaw_max_reversals"     default="3" /><!-- anti-deadlock: after this many burst-direction flips, FORCE advance (never ping-pong 10R/10L/10R); 0 = off -->
  <arg name="yaw_accept_growth_deg" default="4.0" /><!-- widen the accept band (deg) per reversal so an oscillating residual is swallowed -->
  <arg name="yaw_burst_max_ticks"   default="30" /><!-- legacy runaway guard on a burst (now also a rosparam) -->

  <!-- ══════════════════════════════════════════════════════════════
       POSE ESTIMATOR — fuses the ~10Hz noisy /gt_pose with the command being
       executed so the follower sees a DENOISED pose + yaw-rate: averages out
       hover drift when stopped, recovers the true rate while turning. Decoupled
       from the control loop (ingests every /gt_pose). use_pose_estimator:=false
       feeds the raw pose. -->
  <arg name="use_pose_estimator"    default="true" />
  <arg name="est_window_s"          default="0.6" /><!-- least-squares fit window (s); ~6 samples @10Hz -->
  <arg name="est_min_samples"       default="2" />
  <arg name="est_max_buffer_s"      default="1.5" />
  <arg name="est_wz_cmd_eps"        default="0.05" /><!-- |wz_cmd| (rad/s) above which the regime is TURNING -->
  <arg name="est_vx_cmd_eps"        default="0.03" /><!-- |vx_cmd| (m/s) above which the regime is FORWARD -->
  <arg name="est_ff_blend_min"      default="0.15" /><!-- feed-forward fraction when the axis is idle (trust the measured fit) -->
  <arg name="est_ff_blend_max"      default="0.6" /><!-- feed-forward fraction at full command (lean on the command in the noisy rotating regime) -->
  <arg name="est_dropout_s"         default="0.25" /><!-- measurement age (s) after which the estimate dead-reckons from the command -->
  <arg name="est_max_coast_s"       default="1.0" /><!-- cap on the dead-reckon horizon (s); beyond it the pose is HELD and the follower is told to wait -->
  <arg name="est_fresh_tau_s"       default="0.3" /><!-- confidence freshness decay constant -->

  <!-- Trajectory prediction (rollout of the follower) -> /path/predicted + score -->
  <arg name="predict_hz"          default="2.0" />
  <arg name="predict_horizon_s"   default="30.0" />
  <arg name="predict_yaw_tau_s"   default="0.5" /><!-- yaw inertia time constant used by the prediction motion model -->
  <arg name="predict_vx_tau_s"    default="0.3" />

  <!-- Map-settle: at bring-up and during every stop, hold in forward mode and
       wait for a fresh BEV (voxel) update before moving (turn -> stop -> update
       voxels -> turn). Proceeds after the timeout if none arrives. -->
  <arg name="require_map_update"  default="true" />
  <arg name="map_update_topic"    default="/falcon/bev_2d" /><!-- a fresh msg here = the map advanced -->
  <arg name="map_wait_timeout_s"  default="3.0" /><!-- proceed anyway if no update lands (never hang) -->
  <arg name="mapsettle_min_s"     default="0.5" /><!-- min bring-up settle before the first move -->
  <arg name="mapsettle_min_updates" default="2" /><!-- fresh voxel updates required before the FIRST move (running re-stops use 1) -->

  <!-- A* / path -->
  <arg name="waypoint_spacing_m"    default="1.5" />
  <arg name="inflate_radius_m"      default="0.2" />
  <arg name="unknown_blocked"       default="false" />
  <arg name="unknown_cost"          default="1.0" />
  <arg name="los_smoothing"         default="true" />
  <arg name="turn_penalty"          default="0.3" /><!-- was 0.0; discourage zig-zag/staircase corners so the path needs fewer in-place yaws -->
  <arg name="connectivity"          default="8" />
  <arg name="search_margin_m"       default="3.0" />
  <arg name="start_skip_m"          default="0.5" />
  <arg name="goal_snap_radius_m"    default="2.0" />
  <arg name="min_free_cells_to_plan" default="80" />
  <!-- Strict A* cadence: A* + the once-per-path APF post-process run ONLY on
       this timer (and on a goal click). The trajectory is frozen between ticks
       so the follower is not chasing a path that shifts every BEV frame. -->
  <arg name="plan_period_s"         default="5.0" />
  <!-- Optional mid-cycle replans: OFF so the trajectory stays frozen between
       plan_period_s cycles. Set true to react to obstacles faster than that. -->
  <arg name="replan_on_collision"   default="false" />
  <arg name="replan_on_bev"         default="false" />
  <arg name="replan_collision_confirm" default="3" /><!-- consecutive colliding BEV frames before a collision replan (debounces single-frame depth noise); 1 = legacy. Only used when replan_on_collision:=true -->

  <!-- Corner rounding: merge near-collinear vertices + chamfer moderate corners
       into two half-angle turns, so the stop-and-turn follower can glide through
       them instead of stopping to yaw. -->
  <arg name="corner_round"           default="false" />
  <arg name="corner_merge_deg"       default="8.0" /><!-- drop interior vertices that turn less than this -->
  <arg name="corner_max_turn_deg"    default="14.0" /><!-- corners gentler than this are already glide-able (pair with skip_yaw_thresh) -->
  <arg name="corner_chamfer_max_deg" default="28.0" /><!-- corners up to this are chamfered; sharper ones kept as genuine turns -->
  <arg name="corner_chamfer_dist_m"  default="0.5" />
  <arg name="corner_min_runup_m"     default="0.6" />

  <!-- Dynamics-aware replan: replan when the follower's PREDICTED stop-and-turn
       trajectory (/path/predicted) collides even if the geometric path does not.
       OFF by default with the other mid-cycle replans (keeps the 3 s freeze). -->
  <arg name="replan_on_predicted_collision" default="false" />
  <arg name="max_predicted_replans"         default="3" />

  <!-- APF safety recentring: recentre the planner's raw path off walls toward
       corridor centres via the repulsive field U_rep, so a corridor turn stops
       hugging the inside corner. These args are consumed by the path_corrector
       node (below), which works for ANY planner (A* or NavDP). The corrector
       publishes the SAFE path on /path/waypoints_safe; the trajectory_simplifier
       then cleans it into the flown /path/waypoints. For the BEV viewer:
       red = raw planner, magenta = safe (pre-cleanup), green = cleaned/flown.
       safety_correct:=false makes the corrector a passthrough (flies the raw path). -->
  <arg name="safety_correct"        default="true" />
  <arg name="apf_centering"         default="line_search" /><!-- line_search: move each waypoint to the lateral potential minimum (omnidirectional, scale-free, single-pass) | descent: legacy gradient descent -->
  <arg name="apf_gain"              default="0.5" /><!-- DESCENT MODE ONLY: repulsive-force scaling factor (line_search ignores it) -->
  <arg name="apf_max_total_shift_m" default="1.0" /><!-- hard cap on per-waypoint displacement; the main "visible shift" lever -->
  <arg name="apf_min_clearance_m"   default="0.2" /><!-- >0 also pushes waypoints to a min distance-to-wall -->
  <arg name="apf_debug"             default="true" /><!-- TEMP: per-waypoint orig/push/new logging each plan cycle -->
  <arg name="apf_collision_recheck" default="true" /><!-- revert to raw A* if the corrected path collides under inflation; false to view it -->
  <arg name="apf_treat_unknown_as_free" default="true" /><!-- recentre waypoints over UNKNOWN cells too (pushed only by known walls, like A*); false freezes them -->
  <arg name="apf_unknown_damping"   default="true" /><!-- dampen the correction near unknown cells (no opposing wall to balance the push); fades as the map fills -->
  <arg name="apf_unknown_radius_m"  default="0.5" /><!-- confidence-window radius (m): known-cell fraction within this of a waypoint scales its correction -->
  <arg name="publish_forces"        default="true" /><!-- publish F_rep=-grad U_rep at each waypoint as a visualization_msgs/MarkerArray (yellow ARROW) for RViz/BEV -->
  <arg name="force_arrow_scale"     default="0.5" /><!-- arrow length = scale * |F_rep|; raise for longer/clearer arrows -->
  <arg name="publish_force_field"   default="true" /><!-- also draw a coarse F_rep field over the free cells (gold), showing how hard each wall section pushes -->
  <arg name="force_field_stride"    default="4" /><!-- field arrow spacing in cells (4 = every 0.4m at 0.1m res); larger = sparser/cheaper -->

  <!-- ══════════════════════════════════════════════════════════════
       NavDP (point-goal policy) — REPLACES A* when use_navdp:=true.
       The operator clicks a pixel in the live RGB window; the NavDP
       server returns a body-frame trajectory; navdp_click_node anchors
       it at the current pose and publishes a world-frame Path on
       /path/waypoints — the SAME topic A* used, so waypoint_follower and
       bev_click_goal need no change. With use_navdp:=true the
       astar_planner node is NOT launched.

       navdp_click consumes the SAME frames FALCON's mapping does — now via the
       frame-path topics /xtend/depth_frame_path (+ /xtend/rgb_frame_path), tiny
       std_msgs/String "<path> <sec> <nsec>" messages it loads from disk — so its
       intrinsics MUST match that stream. The navdp_* intrinsic args below
       therefore DEFAULT to the shared cam_* (raw K on the real drone via
       real_drone.launch; sim_adapter's P-target in sim). Override per camera, or
       set navdp_camera_info_topic to auto-sync from a camera_info topic (K
       preferred; must describe the 504x294 stream — real drone only).
       ══════════════════════════════════════════════════════════════ -->
  <arg name="use_navdp"                default="false" />
  <!-- nav_mode = astar | navdp | combination. The 3-way mode selector. DEFAULT is
       'combination' (the A*+NavDP fusion runs automatically); use_navdp:=true is the
       legacy shim that selects 'navdp'; pass nav_mode:=astar for plain A* only.
         astar       : astar_planner -> /path/waypoints_astar
         navdp       : navdp_click   -> /path/waypoints_navdp (operator clicks a pixel)
         combination : astar_planner AND combination_planner run; A* plans the global
                       route, combination_planner hands NavDP the farthest visible A*
                       waypoint, flies the returned leg to its midpoint, re-infers, and
                       publishes the arbitrated raw path on /path/waypoints_combo. With
                       combination_start_enabled:=true (the default) the fusion is on
                       from the first tick (no signal needed); set it false to start on
                       A* and turn the fusion on later with a 'std_msgs/Bool True' on
                       combination_enable_topic. Needs the NavDP server up once enabled. -->
<!--   <arg name="nav_mode" default="$(eval 'navdp' if use_navdp else 'combination')" /> -->
  <arg name="nav_mode" default="astar" />
  <!-- vla = navdp | flownav. Selects which VLA policy serves nav_mode:=navdp:
         navdp   = navdp_click_node (point-goal; operator clicks a pixel; NavDP server :navdp_port)
         flownav = flownav_node     (image-goal toward ~flownav_goal_image;  FlowNav server :flownav_port) -->
  <arg name="vla" default="navdp" /><!-- navdp | flownav -->
  <arg name="navdp_port"               default="8888" />
  <arg name="navdp_rgb_topic"          default="$(eval '/xtend/rgb_frame_path' if arg('image_transport') == 'frame_path' else '/xtend/rgb')" />
  <arg name="navdp_depth_topic"        default="$(eval '/xtend/depth_frame_path' if arg('image_transport') == 'frame_path' else '/xtend/depth_m')" />
  <arg name="navdp_pose_topic"         default="/xtend/localization" />
  <arg name="navdp_pose_type"          default="pose_stamped" /><!-- pose_stamped (PoseStamped, e.g. /xtend/localization) | pose (bare Pose, e.g. /gt_pose or /simple_drone/gt_pose) -->
  <arg name="navdp_camera_info_topic"  default="" /><!-- e.g. /xtend/camera_info to auto-sync intrinsics; '' = use the navdp_* params below -->
  <arg name="navdp_fx"                 default="$(arg cam_fx)" />
  <arg name="navdp_fy"                 default="$(arg cam_fy)" />
  <arg name="navdp_cx"                 default="$(arg cam_cx)" />
  <arg name="navdp_cy"                 default="$(arg cam_cy)" />
  <arg name="navdp_img_width"          default="$(arg cam_width)" />
  <arg name="navdp_img_height"         default="$(arg cam_height)" />
  <arg name="navdp_render_cam_height"  default="0.5" /><!-- overlay-only ground-plane height (snapshot panel); 0.5m keeps the near waypoints in-frame at flight altitude. <=0 tracks live altitude; lower pulls in more near waypoints -->
  <arg name="navdp_depth_max_m"        default="5.0" /><!-- depth clip before uint16 encoding (server contract; do NOT exceed 6.55) -->
  <arg name="navdp_execute_fraction"   default="0.5" /><!-- fly only the first fraction of the NavDP route, then hold at the prefix end until the next ENTER re-infers (NavDP is accurate near the camera, drifts further out). 1.0 = whole route -->
  <arg name="navdp_full_path_topic"    default="/path/waypoints_navdp_full" /><!-- the FULL route, display-only (BEV viewer draws it blue-dashed while the near prefix flies) -->
  <arg name="navdp_display_mode"       default="full" /><!-- full = RGB + depth + snapshot panels | rgb_only = just the clickable RGB panel (lighter) -->

  <!-- ══════════════════════════════════════════════════════════════
       FLOWNAV (vla:=flownav) — image-goal VLA, drop-in for the navdp VLA.
       Reuses navdp_rgb_topic / navdp_pose_topic / navdp_pose_type / image_transport
       above (FlowNav needs NO depth and NO intrinsics). Requires the FlowNav TRT host
       server up (default 127.0.0.1:flownav_port) — see
       tasks/planning/flownav/server/flownav_trt_server.py. -->
  <arg name="flownav_port"             default="8889" /><!-- FlowNav server loopback port (distinct from navdp_port 8888) -->
  <arg name="flownav_goal_image"       default="" /><!-- path to the target RGB image to steer toward (set this for vla:=flownav) -->
  <arg name="flownav_goal_image_topic" default="" /><!-- optional sensor_msgs/Image live-goal topic (overrides the file) -->
  <arg name="flownav_rate_hz"          default="4.0" /><!-- continuous (reactive) inference rate -->
  <arg name="flownav_execute_fraction" default="1.0" /><!-- fraction of the predicted path to fly each tick (1.0 = whole) -->
  <arg name="flownav_arrival_distance" default="0.0" /><!-- >0: hold when the goal-distance head drops below this (tune from the node's logged distances); 0 = never auto-stop -->
  <arg name="flownav_display"          default="false" /><!-- open an OpenCV window: live RGB + predicted trajectory + goal-distance; whole frame turns GREEN once arrival_distance is met -->
  <arg name="flownav_path_topic"       default="/path/waypoints_flownav" /><!-- raw path -> path_corrector -->
  <arg name="flownav_full_path_topic"  default="/path/waypoints_flownav_full" /><!-- display-only full route -->

  <!-- ══════════════════════════════════════════════════════════════
       COMBINATION (nav_mode:=combination) — A* global route + NavDP local legs.
       combination_planner reuses the navdp_* intrinsic/transport/server args
       above (same camera stream + NavDP server); these knobs tune the fusion.
       ══════════════════════════════════════════════════════════════ -->
  <arg name="combination_enable_topic"          default="/combination/enable" /><!-- std_msgs/Bool: True = combine, False = follow A* -->
  <arg name="combination_start_enabled"         default="true" /><!-- true (default) = start combined for the whole run, no signal needed; false = start on A* and wait for a 'std_msgs/Bool True' on combination_enable_topic -->
  <arg name="combination_tick_hz"               default="5.0" /><!-- state-machine rate -->
  <arg name="combination_min_engage_fwd_m"      default="1.5" /><!-- CRUISE follows A* until a visible point is at least this far ahead, then STOPS and engages NavDP (a "reasonable distance" worth a leg) -->
  <arg name="combination_engage_confirm_ticks"  default="2" /><!-- hysteresis: require this many CONSECUTIVE engage-able detections before stopping, so depth/occlusion flicker can't cause stop/go lurching -->
  <arg name="combination_engage_settle_s"       default="1.0" /><!-- after stopping to engage, wait this long for the drone to brake to a clean, stationary frame before the first inference -->
  <arg name="combination_max_wait_s"            default="30.0" /><!-- when a re-infer is slow and the leg has been flown out, HOLD (stop) this long for the new route before giving up to A* (checked before each attempt; raise for a slow Jetson) -->
  <arg name="combination_navdp_timeout_s"       default="10.0" /><!-- NavDP HTTP step timeout for ONE inference; generous for a slow Jetson (the drone holds/flies the latched leg meanwhile, never moving un-commanded). Keep < max_wait_s so several attempts fit. -->
  <arg name="combination_leg_fraction"          default="0.5" /><!-- re-infer once the drone passes this fraction of the NavDP leg (0.5 = midpoint; the 2nd half buffers the inference latency) -->
  <arg name="combination_final_handoff_m"       default="1.5" /><!-- when the mission goal is the visible local goal and within this range, fly A* straight in (no NavDP tiny-leg jitter at the end) -->
  <arg name="combination_leg_timeout_s"         default="8.0" /><!-- watchdog: re-infer if a leg has been followed this long (prevents a deadlock if the flown path is shorter than the raw leg) -->
  <arg name="combination_require_unoccluded"    default="true" /><!-- a waypoint is "visible" only with clear line-of-sight (depth), not merely in-FOV; false = in-frame only -->
  <arg name="combination_visibility_depth_tol_m" default="0.5" /><!-- slack (m) on the depth occlusion test -->
  <arg name="combination_min_goal_fwd_m"        default="0.5" /><!-- ignore A* waypoints nearer than this (the drone is already on top of them) -->

  <!-- ══════════════════════════════════════════════════════════════
       PATH CORRECTOR (path_corrector_node) — planner-agnostic SAFETY.
       Subscribes to the active planner's RAW path, recentres it off
       walls against the BEV (the repulsive potential field, by default)
       and publishes the corrected, SAFE path on /path/waypoints_safe.
       The trajectory_simplifier (below) then cleans that path and owns the
       flown /path/waypoints. ~enabled (=safety_correct) false makes the
       corrector a passthrough. The APF / force-viz args live in the
       "APF safety recentring" block above and are consumed HERE now.
       ══════════════════════════════════════════════════════════════ -->
  <arg name="corrector" default="potential_field" /><!-- core PathCorrector strategy: potential_field | esdf (raises on an unknown name) -->
  <!-- Which raw path the corrector reads, by nav_mode (and vla for navdp):
       combination -> /path/waypoints_combo; navdp+vla=flownav -> /path/waypoints_flownav;
       navdp -> /path/waypoints_navdp; astar -> /path/waypoints_astar. The corrector
       owns /path/waypoints_safe; the trajectory_simplifier turns that into the
       flown /path/waypoints, so the follower still reads one topic. -->
  <arg name="planner_path_topic"
       default="$(eval '/path/waypoints_combo' if arg('nav_mode') == 'combination' else ('/path/waypoints_flownav' if (arg('nav_mode') == 'navdp' and arg('vla') == 'flownav') else ('/path/waypoints_navdp' if arg('nav_mode') == 'navdp' else '/path/waypoints_astar')))" />

  <!-- ESDF corrector knobs (used only when corrector:=esdf). Ascend each waypoint
       up the gradient of the distance-to-wall field toward the corridor / doorway
       centre. The shared safety knobs (apf_collision_recheck / apf_treat_unknown_as_free
       / apf_unknown_damping / apf_unknown_radius_m / apf_pin_last / inflate_radius_m)
       apply to whichever corrector is active. -->
  <arg name="esdf_target_clearance_m" default="0.0" /><!-- 0 = centre on the ESDF ridge (corridor middle); >0 = stop once this far from walls (a safety floor, like FALCON safe_distance) -->
  <arg name="esdf_max_total_shift_m"  default="1.0" /><!-- cap on a waypoint's total displacement off the planner path -->
  <arg name="esdf_max_step_m"         default="0.2" /><!-- cap on one ascent step -->
  <arg name="esdf_iterations"         default="12" /><!-- max ascent steps per waypoint -->
  <arg name="esdf_lateral_only"       default="true" /><!-- push perpendicular to the path (no fore/aft slide) -->
  <arg name="esdf_smooth_sigma_m"     default="0.1" /><!-- light blur on the distance field for a clean gradient (0 = none) -->
  <arg name="esdf_occ_thresh"         default="0.65" />

  <!-- Thin a dense input path to >= this spacing (m) BEFORE correcting, so the
       lateral corrector cannot push near-coincident neighbours opposite ways (the
       NavDP zig-zag). No-op for A*'s metre-scale waypoints; 0 disables it. -->
  <arg name="resample_min_spacing_m"  default="0.3" />

  <!-- ══════════════════════════════════════════════════════════════
       TRAJECTORY SIMPLIFIER (trajectory_simplifier_node) — CLEANUP, not safety.
       Runs AFTER the corrector: takes the safe path on /path/waypoints_safe and
       makes it cleaner/flyable, then publishes the flown /path/waypoints. Every
       geometry-changing pass is validated against the BEV (inflated line-of-sight)
       so cleanup never re-introduces a collision the corrector avoided. Set
       simplify:=false for a verbatim passthrough (corrector path flown directly).
       ══════════════════════════════════════════════════════════════ -->
  <arg name="simplify"               default="true" /><!-- false = passthrough: fly the corrector's path uncleaned -->
  <arg name="simplify_debug"         default="true" /><!-- per-cycle in->out waypoint-count logging -->
  <!-- 1) merge near-duplicate waypoints = the HARD FLOOR: no two points in the
          final route end up closer than this, even at a turn (a tight cluster the
          field left is noise, not several turns). A genuinely required tight corner
          survives because cutting it would clip an obstacle (BEV-checked). -->
  <arg name="simplify_merge"         default="true" />
  <arg name="simplify_merge_radius_m" default="0.20" />
  <!-- 2) flatten field-induced zig-zags: a middle point whose heading change
          exceeds zigzag_angle_deg is pulled zigzag_strength (0..1) toward the line
          between its neighbours (kept, not deleted). A corner that hugs a wall is
          left alone (its bypass line would clip, so the move is rejected). -->
  <arg name="simplify_zigzag"        default="true" />
  <arg name="simplify_zigzag_angle_deg" default="60.0" />
  <arg name="simplify_zigzag_strength"  default="0.5" />
  <arg name="simplify_zigzag_passes"    default="1" />
  <!-- 3) drop redundant collinear middles ("same plane"), but never create a leg
          longer than max_segment_m (so the path never gets too coarse). Raise
          max_segment_m to collapse straights harder; lower it to keep more points. -->
  <arg name="simplify_collinear"     default="true" />
  <arg name="simplify_collinear_angle_deg" default="10.0" /><!-- heading change below this = same plane -->
  <arg name="simplify_max_segment_m" default="3.0" />
  <!-- 4) min spacing on the straights = the SOFT FLOOR: thin straights to >= this,
          but allow genuine turns (heading change > turn_keep_deg) to sit closer
          where they must (down to, but never below, the hard merge floor in 1). -->
  <arg name="simplify_min_spacing"   default="true" />
  <arg name="simplify_min_spacing_m" default="1.0" />
  <arg name="simplify_turn_keep_deg" default="25.0" />

  <!-- Takeoff & cruise -->
  <arg name="auto_takeoff"      default="false" />
  <arg name="cruise_z"          default="1.0" />
  <arg name="freeze_during_yaw" default="false" />
  <arg name="maintain_altitude" default="true" />
  <arg name="use_posctrl"       default="true" />
  <arg name="ctrl_rate_hz"      default="10.0" /><!-- 10Hz = localization rate -> 4deg/tick so the graded-pulse min turn is ~8deg (2 ticks). The pose estimator denoises over its 0.6s window regardless, so 10Hz does not mean chasing noisy single readings. Set 5.0 for coarser/cheaper turns (min turn ~16deg). -->


  <arg name="forward_only"      default="false" />
  <arg name="cmd_log_path"      default="/tmp/cmd_log_{ts}.jsonl" />

  <!-- ══════════════════════════════════════════════════════════════
       BEV  (bev_publisher.py v4 — height-weighted column projection +
       3D neighbour reasoning + opening protection + wall completion).
       Each stage is a toggle; set a gate to its "off" value to isolate
       one idea. The defaults already de-noise the map out of the box.
       ══════════════════════════════════════════════════════════════ -->
  <!-- geometry / IO -->
  <arg name="bev_resolution"  default="0.10" />   <!-- m / cell; MUST match FALCON voxel_mapping resolution_fine (0.1). 0.15 was COARSER than FALCON's 0.1 voxels and quantized narrow openings: each wall cell absorbs ~half a cell, so a true 0.68 m turn gap read ~0.45 m (3 cells of 0.15). 0.10 recovers it to ~0.60 m (6 cells). -->
  <arg name="bev_xmin"        default="-6.0" />
  <arg name="bev_ymin"        default="-6.0" />
  <arg name="bev_xmax"        default="6.0" />
  <arg name="bev_ymax"        default="6.0" />
  <arg name="bev_bbox_margin" default="1.0" />    <!-- only used if the bbox_* args are removed (bounds then come from /map_config) -->
  <arg name="bev_publish_hz"  default="10.0" />   <!-- was 2.0; caps the recompute+publish rate -->
  <arg name="bev_occ_dilate"  default="0" />      <!-- extra OCC inflation in cells (planner also inflates) -->

  <!-- vertical column + height weighting (stage 1, the core de-noiser) -->
  <arg name="bev_z_floor"           default="1.00" />            <!-- column z-range considered -->
  <arg name="bev_z_ceil"            default="1.50" />
  <arg name="bev_z_peak"            default="$(arg cruise_z)" />  <!-- weight peaks at flight altitude -->
  <arg name="bev_weight_profile"    default="triangular" />      <!-- triangular | gaussian | flat -->
  <arg name="bev_weight_sigma"      default="0.50" />            <!-- gaussian width (profile=gaussian) -->
  <arg name="bev_voxel_size"        default="$(arg bev_resolution)" />  <!-- z-layer thickness -->
  <arg name="bev_occ_weight_thresh" default="2.0" />             <!-- min weighted column mass for OCC -->
  <arg name="bev_min_occ_voxels"    default="4" />               <!-- AND min raw voxel count for OCC -->
  <arg name="bev_min_free_voxels"   default="1" />               <!-- min voxels for a cell to read FREE -->

  <!-- 3D neighbour confirm (stage 2) — drops isolated DA3 speckle -->
  <arg name="bev_confirm_3d"           default="true" />
  <arg name="bev_neighbors_3d"         default="6" />            <!-- 6 | 18 | 26 -->
  <arg name="bev_min_occ_neighbors_3d" default="1" />            <!-- raise (e.g. 2) with conn=26 to kill streaks -->

  <!-- door / window protection (stage 3) — never wall an opening that is open at flight height -->
  <arg name="bev_protect_openings"  default="true" />
  <arg name="bev_door_band_m"       default="0.80" />           <!-- z-band around z_peak inspected for openness -->
  <arg name="bev_door_free_voxels"  default="2" />              <!-- free voxels in the band => it's an opening -->
  <arg name="bev_door_occ_tol"      default="0" />              <!-- max occupied voxels tolerated in the band -->

  <!-- wall completion (stage 4) — bridge FOV / occlusion gaps in wall lines -->
  <arg name="bev_wall_fill_mode"      default="directional" />  <!-- off | directional | count -->
  <arg name="bev_wall_fill_neighbors" default="5" />            <!-- count mode only -->
  <arg name="bev_wall_fill_iters"     default="1" />            <!-- max bridge width; keep small (1-2) -->

  <!-- temporal CONFIRMATION (now runs BEFORE wall completion; ON by default).
       A cell only reads OCC after it has been seen occupied, with enough
       confidence, across MULTIPLE clouds — this rejects the monocular-depth
       speckle FALCON leaks into corridor openings the camera is not aimed at.
       Was off on the assumption "FALCON already fuses in time"; that assumption
       is exactly what fails for these view-dependent artifacts, so it is now on.
       Set bev_temporal_filter:=false to restore the old single-frame behaviour. -->
  <arg name="bev_temporal_filter" default="true" />
  <arg name="bev_occ_conf_full" default="3.0" />  <!-- weighted column mass = full per-frame confidence; per-frame conf = occ_w/this clipped to [0,1]. MUST be > bev_occ_weight_thresh. RAISE to make persistent peripheral speckle harder to confirm. -->
  <arg name="bev_t_inc" default="1.0" />   <!-- evidence added per cloud, scaled by confidence -->
  <arg name="bev_t_dec" default="1.0" />   <!-- evidence bled per cloud a cell is seen FREE (opening recovery) -->
  <arg name="bev_t_max" default="5.0" />   <!-- evidence cap (memory of a confirmed wall) -->
  <arg name="bev_t_on"  default="2.0" />   <!-- evidence to confirm OCC; ~t_on/t_inc clouds of solid wall (~0.6s at FALCON's ~3Hz) -->
  <arg name="bev_t_off" default="0.5" />   <!-- evidence to clear (Schmitt lower rail) -->

  <!-- runtime -->
  <arg name="bev_always_recompute"       default="false" />     <!-- recompute every tick vs only on a new cloud -->
  <arg name="bev_skip_unchanged_publish" default="true" />

  <!-- FALCON speed / safety / frontier -->
  <arg name="max_vel"     default="0.25" />
  <arg name="max_acc"     default="0.25" />
  <arg name="max_yaw_vel" default="0.6" />
  <arg name="max_yaw_acc" default="0.5" />

  <arg name="obstacles_inflation"        default="0.85" />
  <arg name="safe_distance"              default="0.85" />
  <arg name="frontier_min_clearance"     default="0.50" />
  <arg name="frontier_min_occ_clearance" default="0.75" />
  <arg name="frontier_candidate_rmin"    default="1.0" />
  <arg name="frontier_candidate_rmax"    default="5.5" />

  <arg name="fsm_replan_thresh1"   default="2.0" />
  <arg name="fsm_replan_thresh2"   default="2.0" />
  <arg name="fsm_replan_thresh3"   default="2.0" />
  <arg name="fsm_replan_time"      default="60.0" />
  <arg name="fsm_thresh_replan"    default="60.0" />
  <arg name="fsm_thresh_no_replan" default="60.0" />

  <arg name="publish_mapping_inputs" default="true" />          <!-- sim keeps true -->
  <!-- ══════════════════════════════════════════════════════════════
       LOAD FALCON CONFIG
       ══════════════════════════════════════════════════════════════ -->
  <rosparam command="load" file="$(find exploration_manager)/config/robot/uav_model_simulator.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/map/$(arg map_name).yaml"/>
  <rosparam command="load" file="$(find voxel_mapping)/config/voxel_mapping.yaml"/>
  <rosparam command="load" file="$(find pathfinding)/config/astar.yaml"/>
  <rosparam command="load" file="$(find fast_planner)/config/fast_planner.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/frontier_finder.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/hgrid.yaml"/>
  <rosparam command="load" file="$(find exploration_utils)/config/perception_utils.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/exploration_manager.yaml"/>

  <!-- Camera intrinsics: the cam_* args are now fully resolved
       (either from the YAML's camera_matrix.data via $(eval) above,
       or from literal fallbacks / CLI overrides), so a flat
       arg-to-param mapping is all that's needed here. -->
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fx" value="$(arg cam_fx)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fy" value="$(arg cam_fy)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cx" value="$(arg cam_cx)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cy" value="$(arg cam_cy)" />
  <param name="/uav_model/sensing_parameters/image_width"  value="$(arg cam_width)" />
  <param name="/uav_model/sensing_parameters/image_height" value="$(arg cam_height)" />
  <param name="/uav_model/sensing_parameters/min_depth"    value="$(arg cam_min_depth)" />
  <param name="/uav_model/sensing_parameters/max_depth"    value="$(arg cam_max_depth)" />

  <!-- Transformer -->
  <param name="/transformer/pose_topic_type"     value="pose" />
  <param name="/transformer/timestamp_tolerance" value="0.02" />

  <!-- Speed limits -->
  <param name="/uav_model/dynamics_parameters/max_linear_velocity"     value="$(arg max_vel)" />
  <param name="/uav_model/dynamics_parameters/max_linear_acceleration" value="$(arg max_acc)" />
  <param name="/uav_model/dynamics_parameters/max_yaw_velocity"        value="$(arg max_yaw_vel)" />
  <param name="/uav_model/dynamics_parameters/max_yaw_acceleration"    value="$(arg max_yaw_acc)" />

  <param name="/voxel_mapping/obstacles_inflation" value="$(arg obstacles_inflation)" />
  <param name="/bspline_opt/safe_distance"         value="$(arg safe_distance)" />

  <param name="/frontier_finder/min_candidate_clearance"          value="$(arg frontier_min_clearance)" />
  <param name="/frontier_finder/min_candidate_occupied_clearance" value="$(arg frontier_min_occ_clearance)" />
  <param name="/frontier_finder/candidate_rmin"                   value="$(arg frontier_candidate_rmin)" />
  <param name="/frontier_finder/candidate_rmax"                   value="$(arg frontier_candidate_rmax)" />

  <param name="/fsm/replan_thresh1"   value="$(arg fsm_replan_thresh1)" />
  <param name="/fsm/replan_thresh2"   value="$(arg fsm_replan_thresh2)" />
  <param name="/fsm/replan_thresh3"   value="$(arg fsm_replan_thresh3)" />
  <param name="/fsm/replan_time"      value="$(arg fsm_replan_time)" />
  <param name="/fsm/thresh_replan"    value="$(arg fsm_thresh_replan)" />
  <param name="/fsm/thresh_no_replan" value="$(arg fsm_thresh_no_replan)" />

  <param name="/traj_server/init_dx" value="0.0" />
  <param name="/traj_server/init_dy" value="0.0" />
  <param name="/traj_server/init_dz" value="0.0" />

  <!-- ══════════════════════════════════════════════════════════════
       NODES
       ══════════════════════════════════════════════════════════════ -->

  <node pkg="falcon_adapter" type="sensor_gate_node.py"
        name="sensor_gate" output="screen">
    <param name="in_ns"              value="$(arg drone_ns)" />
    <param name="out_ns"             value="$(arg gated_ns)" />
    <param name="pose_topic"         value="$(arg pose_topic)" />
    <param name="depth_topic"        value="$(arg depth_topic)" />
    <param name="camera_info_topic"  value="$(arg camera_info_topic)" />
    <param name="bridge_camera_info" value="$(arg bridge_camera_info)" />
    <param name="freeze_on_turning_mode" value="$(arg sensor_gate_freeze_on_turning_mode)" />
    <param name="replay_hz"          value="30.0" />
  </node>

  <node pkg="falcon_adapter" type="falcon_adapter_node.py"
        name="falcon_adapter" output="screen">
    <param name="drone_ns"     value="$(arg gated_ns)" />
    <param name="world_frame"  value="world" />
    <param name="body_frame"   value="body" />
    <param name="cam_frame"    value="camera" />
    <param name="cam_offset_x" value="0.2" />
    <param name="odom_min_dt"  value="0.04" />
    <param name="depth_min_dt" value="0.04" />
    <param name="publish_mapping_inputs" value="$(arg publish_mapping_inputs)" />
  </node>

  <node pkg="exploration_manager" name="exploration_node" type="exploration_node"
        output="screen" respawn="false">
    <remap from="/odom_world"                    to="/odom_world"/>
    <remap from="/voxel_mapping/depth_image"     to="/map_ros/depth"/>
    <remap from="/transformer/sensor_pose_topic" to="/map_ros/pose"/>
  </node>

  <node pkg="falcon_adapter" type="bev_publisher_node.py"
        name="bev_publisher" output="screen">
    <param name="frame_id"               value="world" />
    <!-- geometry / IO -->
    <param name="resolution"             value="$(arg bev_resolution)" />
    <param name="bbox_xmin"              value="$(arg bev_xmin)" />
    <param name="bbox_ymin"              value="$(arg bev_ymin)" />
    <param name="bbox_xmax"              value="$(arg bev_xmax)" />
    <param name="bbox_ymax"              value="$(arg bev_ymax)" />
    <param name="bbox_margin_m"          value="$(arg bev_bbox_margin)" />
    <param name="publish_hz"             value="$(arg bev_publish_hz)" />
    <param name="occ_dilate_cells"       value="$(arg bev_occ_dilate)" />
    <!-- vertical column + height weighting -->
    <param name="z_floor"                value="$(arg bev_z_floor)" />
    <param name="z_ceil"                 value="$(arg bev_z_ceil)" />
    <param name="z_peak"                 value="$(arg bev_z_peak)" />
    <param name="weight_profile"         value="$(arg bev_weight_profile)" />
    <param name="weight_sigma"           value="$(arg bev_weight_sigma)" />
    <param name="voxel_size_m"           value="$(arg bev_voxel_size)" />
    <param name="occ_weight_thresh"      value="$(arg bev_occ_weight_thresh)" />
    <param name="min_occ_voxels"         value="$(arg bev_min_occ_voxels)" />
    <param name="min_free_voxels"        value="$(arg bev_min_free_voxels)" />
    <!-- 3D neighbour confirm -->
    <param name="confirm_3d"             value="$(arg bev_confirm_3d)" />
    <param name="neighbors_3d"           value="$(arg bev_neighbors_3d)" />
    <param name="min_occ_neighbors_3d"   value="$(arg bev_min_occ_neighbors_3d)" />
    <!-- door / window protection -->
    <param name="protect_openings"       value="$(arg bev_protect_openings)" />
    <param name="door_band_m"            value="$(arg bev_door_band_m)" />
    <param name="door_free_voxels"       value="$(arg bev_door_free_voxels)" />
    <param name="door_occ_tol"           value="$(arg bev_door_occ_tol)" />
    <!-- wall completion -->
    <param name="wall_fill_mode"         value="$(arg bev_wall_fill_mode)" />
    <param name="wall_fill_neighbors"    value="$(arg bev_wall_fill_neighbors)" />
    <param name="wall_fill_iters"        value="$(arg bev_wall_fill_iters)" />
    <!-- temporal confirmation (ON by default; runs before wall completion) -->
    <param name="temporal_filter"        value="$(arg bev_temporal_filter)" />
    <param name="occ_conf_full"          value="$(arg bev_occ_conf_full)" />
    <param name="t_inc"                  value="$(arg bev_t_inc)" />
    <param name="t_dec"                  value="$(arg bev_t_dec)" />
    <param name="t_max"                  value="$(arg bev_t_max)" />
    <param name="t_on"                   value="$(arg bev_t_on)" />
    <param name="t_off"                  value="$(arg bev_t_off)" />
    <!-- runtime -->
    <param name="always_recompute"       value="$(arg bev_always_recompute)" />
    <param name="skip_unchanged_publish" value="$(arg bev_skip_unchanged_publish)" />
    <!-- output topic (input topics use the node's defaults:
         /voxel_mapping/occupancy_grid_occupied and .../_free) -->
    <param name="out_topic"              value="/falcon/bev_2d" />
  </node>

  <!-- A* planner: runs in astar AND combination modes (in combination it plans the
       global route the combination_planner steers NavDP along). NOT in pure navdp. -->
  <node pkg="falcon_adapter" type="astar_planner_node.py"
        name="astar_planner" output="screen"
        if="$(eval arg('nav_mode') in ('astar', 'combination'))">
    <param name="drone_ns"           value="$(arg drone_ns)" />
    <param name="bev_topic"          value="/falcon/bev_2d" />
    <!-- Raw A* path; path_corrector recentres it and republishes /path/waypoints. -->
    <param name="path_topic"         value="/path/waypoints_astar" />
    <param name="goal_topic"         value="/waypoint_nav/goal" />
    <param name="goal_x"             value="$(arg goal_x)" />
    <param name="goal_y"             value="$(arg goal_y)" />
    <param name="waypoint_spacing_m" value="$(arg waypoint_spacing_m)" />
    <param name="inflate_radius_m"      value="$(arg inflate_radius_m)" />
    <param name="unknown_blocked"       value="$(arg unknown_blocked)" />
    <param name="unknown_cost"          value="$(arg unknown_cost)" />
    <param name="los_smoothing"         value="$(arg los_smoothing)" />
    <param name="turn_penalty"          value="$(arg turn_penalty)" />
    <param name="connectivity"          value="$(arg connectivity)" />
    <param name="search_margin_m"       value="$(arg search_margin_m)" />
    <param name="start_skip_m"          value="$(arg start_skip_m)" />
    <param name="goal_snap_radius_m"    value="$(arg goal_snap_radius_m)" />
    <param name="min_free_cells_to_plan" value="$(arg min_free_cells_to_plan)" />
    <param name="plan_period_s"         value="$(arg plan_period_s)" />
    <param name="replan_on_collision"   value="$(arg replan_on_collision)" />
    <param name="replan_on_bev"         value="$(arg replan_on_bev)" />
    <param name="replan_collision_confirm" value="$(arg replan_collision_confirm)" />
    <param name="corner_round"          value="$(arg corner_round)" />
    <param name="corner_merge_deg"      value="$(arg corner_merge_deg)" />
    <param name="corner_max_turn_deg"   value="$(arg corner_max_turn_deg)" />
    <param name="corner_chamfer_max_deg" value="$(arg corner_chamfer_max_deg)" />
    <param name="corner_chamfer_dist_m" value="$(arg corner_chamfer_dist_m)" />
    <param name="corner_min_runup_m"    value="$(arg corner_min_runup_m)" />
    <param name="replan_on_predicted_collision" value="$(arg replan_on_predicted_collision)" />
    <param name="max_predicted_replans" value="$(arg max_predicted_replans)" />
    <param name="predicted_path_topic"  value="/path/predicted" />
    <param name="frame_id"              value="world" />
    <!-- Path correction (APF recentring + force viz) now runs in path_corrector,
         which subscribes to /path/waypoints_astar; see that node below. -->
  </node>

  <!-- NavDP click-to-go planner (replaces astar_planner when use_navdp:=true).
       Publishes its RAW path on /path/waypoints_navdp; path_corrector recentres
       it (planner_path_topic auto-selects it when use_navdp) and republishes
       /path/waypoints, the world Path the follower consumes. -->
  <node pkg="falcon_adapter" type="navdp_click_node.py"
        name="navdp_click" output="screen"
        if="$(eval arg('nav_mode') == 'navdp' and arg('vla') == 'navdp')">
    <param name="drone_ns"          value="$(arg drone_ns)" />
    <param name="image_transport"   value="$(arg image_transport)" />
    <param name="rgb_topic"         value="$(arg navdp_rgb_topic)" />
    <param name="depth_topic"       value="$(arg navdp_depth_topic)" />
    <param name="pose_topic"        value="$(arg navdp_pose_topic)" />
    <param name="pose_type"         value="$(arg navdp_pose_type)" />
    <param name="camera_info_topic" value="$(arg navdp_camera_info_topic)" />
    <!-- Raw NavDP path; path_corrector recentres it and republishes /path/waypoints. -->
    <param name="path_topic"        value="/path/waypoints_navdp" />
    <param name="frame_id"          value="world" />
    <param name="port"              value="$(arg navdp_port)" />
    <param name="depth_max_m"       value="$(arg navdp_depth_max_m)" />
    <param name="fx"                value="$(arg navdp_fx)" />
    <param name="fy"                value="$(arg navdp_fy)" />
    <param name="cx"                value="$(arg navdp_cx)" />
    <param name="cy"                value="$(arg navdp_cy)" />
    <param name="img_width"         value="$(arg navdp_img_width)" />
    <param name="img_height"        value="$(arg navdp_img_height)" />
    <param name="render_cam_height" value="$(arg navdp_render_cam_height)" />
    <param name="execute_fraction"  value="$(arg navdp_execute_fraction)" />
    <param name="full_path_topic"   value="$(arg navdp_full_path_topic)" />
    <param name="display_mode"      value="$(arg navdp_display_mode)" />
  </node>

  <!-- FlowNav image-goal VLA (vla:=flownav). Drop-in for navdp_click: identical world
       Path output contract (path_corrector recentres /path/waypoints_flownav and
       republishes /path/waypoints). Image-goal, so NO depth / intrinsics / click — it
       steers toward ~goal_image continuously at ~rate_hz. Needs the FlowNav server up. -->
  <node pkg="falcon_adapter" type="flownav_node.py"
        name="flownav" output="screen"
        if="$(eval arg('nav_mode') == 'navdp' and arg('vla') == 'flownav')">
    <param name="image_transport"   value="$(arg image_transport)" />
    <param name="rgb_topic"         value="$(arg navdp_rgb_topic)" />
    <param name="pose_topic"        value="$(arg navdp_pose_topic)" />
    <param name="pose_type"         value="$(arg navdp_pose_type)" />
    <param name="goal_image"        value="$(arg flownav_goal_image)" />
    <param name="goal_image_topic"  value="$(arg flownav_goal_image_topic)" />
    <param name="path_topic"        value="$(arg flownav_path_topic)" />
    <param name="full_path_topic"   value="$(arg flownav_full_path_topic)" />
    <param name="frame_id"          value="world" />
    <param name="port"              value="$(arg flownav_port)" />
    <param name="rate_hz"           value="$(arg flownav_rate_hz)" />
    <param name="execute_fraction"  value="$(arg flownav_execute_fraction)" />
    <param name="arrival_distance"  value="$(arg flownav_arrival_distance)" />
    <!-- optional display overlay: reuses the navdp_* intrinsics for this camera -->
    <param name="display"           value="$(arg flownav_display)" />
    <param name="fx"                value="$(arg navdp_fx)" />
    <param name="fy"                value="$(arg navdp_fy)" />
    <param name="cx"                value="$(arg navdp_cx)" />
    <param name="cy"                value="$(arg navdp_cy)" />
    <param name="img_width"         value="$(arg navdp_img_width)" />
    <param name="img_height"        value="$(arg navdp_img_height)" />
    <param name="render_cam_height" value="$(arg navdp_render_cam_height)" />
  </node>

  <!-- Combination planner (nav_mode:=combination): A* plans the global route (the
       astar_planner above stays on); this node hands NavDP the farthest A* waypoint
       VISIBLE in the current frame as a local goal, anchors the returned trajectory
       to the world, and publishes the arbitrated raw path on /path/waypoints_combo
       (which planner_path_topic selects, so path_corrector recentres it and the
       trajectory_simplifier cleans it into the flown /path/waypoints). It flies each
       NavDP leg to its midpoint, then re-infers. Disabled at first it echoes A*
       straight through, so the run can start on A* and switch to the fusion on a
       'std_msgs/Bool True' on combination_enable_topic (or combination_start_enabled).
       Reuses the navdp_* camera/transport/server args. Needs the NavDP server up. -->
  <node pkg="falcon_adapter" type="combination_planner_node.py"
        name="combination_planner" output="screen"
        if="$(eval arg('nav_mode') == 'combination')">
    <param name="drone_ns"          value="$(arg drone_ns)" />
    <param name="image_transport"   value="$(arg image_transport)" />
    <param name="rgb_topic"         value="$(arg navdp_rgb_topic)" />
    <param name="depth_topic"       value="$(arg navdp_depth_topic)" />
    <param name="pose_topic"        value="$(arg navdp_pose_topic)" />
    <param name="pose_type"         value="$(arg navdp_pose_type)" />
    <param name="camera_info_topic" value="$(arg navdp_camera_info_topic)" />
    <!-- A* route in; arbitrated raw path out (-> path_corrector via planner_path_topic). -->
    <param name="astar_path_topic"  value="/path/waypoints_astar" />
    <param name="path_topic"        value="/path/waypoints_combo" />
    <param name="full_path_topic"   value="$(arg navdp_full_path_topic)" />
    <param name="frame_id"          value="world" />
    <param name="port"              value="$(arg navdp_port)" />
    <param name="depth_max_m"       value="$(arg navdp_depth_max_m)" />
    <param name="fx"                value="$(arg navdp_fx)" />
    <param name="fy"                value="$(arg navdp_fy)" />
    <param name="cx"                value="$(arg navdp_cx)" />
    <param name="cy"                value="$(arg navdp_cy)" />
    <param name="img_width"         value="$(arg navdp_img_width)" />
    <param name="img_height"        value="$(arg navdp_img_height)" />
    <!-- Combination behaviour / visibility -->
    <param name="enable_topic"             value="$(arg combination_enable_topic)" />
    <param name="start_enabled"            value="$(arg combination_start_enabled)" />
    <param name="tick_hz"                  value="$(arg combination_tick_hz)" />
    <param name="min_engage_fwd_m"         value="$(arg combination_min_engage_fwd_m)" />
    <param name="engage_confirm_ticks"     value="$(arg combination_engage_confirm_ticks)" />
    <param name="engage_settle_s"          value="$(arg combination_engage_settle_s)" />
    <param name="max_wait_s"               value="$(arg combination_max_wait_s)" />
    <param name="timeout_s"                value="$(arg combination_navdp_timeout_s)" />
    <param name="leg_execute_fraction"     value="$(arg combination_leg_fraction)" />
    <param name="final_handoff_m"          value="$(arg combination_final_handoff_m)" />
    <param name="leg_timeout_s"            value="$(arg combination_leg_timeout_s)" />
    <param name="require_unoccluded"       value="$(arg combination_require_unoccluded)" />
    <param name="visibility_depth_tol_m"   value="$(arg combination_visibility_depth_tol_m)" />
    <param name="min_goal_fwd_m"           value="$(arg combination_min_goal_fwd_m)" />
  </node>

  <!-- Path corrector (SAFETY): recentres whichever planner's raw path against the
       BEV and publishes the SAFE path on /path/waypoints_safe (+ /path/waypoints_raw
       echo and /path/forces arrows for the BEV viewer). The trajectory_simplifier
       below cleans that into the flown /path/waypoints. Always launched; ~enabled
       (=safety_correct) false makes it a verbatim passthrough. -->
  <node pkg="falcon_adapter" type="path_corrector_node.py"
        name="path_corrector" output="screen">
    <param name="input_path_topic"      value="$(arg planner_path_topic)" />
    <param name="bev_topic"             value="/falcon/bev_2d" />
    <param name="path_topic"            value="/path/waypoints_safe" />
    <param name="raw_path_topic"        value="/path/waypoints_raw" />
    <param name="frame_id"              value="world" />
    <param name="enabled"               value="$(arg safety_correct)" />
    <param name="corrector"             value="$(arg corrector)" />
    <param name="resample_min_spacing_m" value="$(arg resample_min_spacing_m)" />
    <!-- Match the planner's inflation so the collision clip uses the same model. -->
    <param name="inflate_radius_m"      value="$(arg inflate_radius_m)" />
    <param name="apf_centering"         value="$(arg apf_centering)" />
    <param name="apf_gain"              value="$(arg apf_gain)" />
    <param name="apf_max_total_shift_m" value="$(arg apf_max_total_shift_m)" />
    <param name="apf_min_clearance_m"   value="$(arg apf_min_clearance_m)" />
    <param name="apf_debug"             value="$(arg apf_debug)" />
    <param name="apf_collision_recheck" value="$(arg apf_collision_recheck)" />
    <param name="apf_treat_unknown_as_free" value="$(arg apf_treat_unknown_as_free)" />
    <param name="apf_unknown_damping"   value="$(arg apf_unknown_damping)" />
    <param name="apf_unknown_radius_m"  value="$(arg apf_unknown_radius_m)" />
    <param name="publish_forces"        value="$(arg publish_forces)" />
    <param name="forces_topic"          value="/path/forces" />
    <param name="force_arrow_scale"     value="$(arg force_arrow_scale)" />
    <param name="publish_force_field"   value="$(arg publish_force_field)" />
    <param name="force_field_stride"    value="$(arg force_field_stride)" />
    <!-- ESDF corrector knobs (used only when corrector:=esdf) -->
    <param name="esdf_target_clearance_m" value="$(arg esdf_target_clearance_m)" />
    <param name="esdf_max_total_shift_m"  value="$(arg esdf_max_total_shift_m)" />
    <param name="esdf_max_step_m"         value="$(arg esdf_max_step_m)" />
    <param name="esdf_iterations"         value="$(arg esdf_iterations)" />
    <param name="esdf_lateral_only"       value="$(arg esdf_lateral_only)" />
    <param name="esdf_smooth_sigma_m"     value="$(arg esdf_smooth_sigma_m)" />
    <param name="esdf_occ_thresh"         value="$(arg esdf_occ_thresh)" />
  </node>

  <!-- Trajectory simplifier (CLEANUP, not safety): cleans the corrector's safe
       path on /path/waypoints_safe and publishes the flown /path/waypoints. Each
       pass is validated against the BEV (inflated line-of-sight) so cleanup never
       re-introduces a collision the corrector avoided. ~enabled (=simplify) false
       passes the safe path straight through. -->
  <node pkg="falcon_adapter" type="trajectory_simplifier_node.py"
        name="trajectory_simplifier" output="screen">
    <param name="input_path_topic"   value="/path/waypoints_safe" />
    <param name="bev_topic"          value="/falcon/bev_2d" />
    <param name="path_topic"         value="/path/waypoints" />
    <param name="frame_id"           value="world" />
    <param name="enabled"            value="$(arg simplify)" />
    <param name="debug"              value="$(arg simplify_debug)" />
    <!-- Match the corrector/planner inflation so "clear" means the same thing. -->
    <param name="inflate_radius_m"   value="$(arg inflate_radius_m)" />
    <param name="merge_enabled"      value="$(arg simplify_merge)" />
    <param name="merge_radius_m"     value="$(arg simplify_merge_radius_m)" />
    <param name="zigzag_enabled"     value="$(arg simplify_zigzag)" />
    <param name="zigzag_angle_deg"   value="$(arg simplify_zigzag_angle_deg)" />
    <param name="zigzag_strength"    value="$(arg simplify_zigzag_strength)" />
    <param name="zigzag_passes"      value="$(arg simplify_zigzag_passes)" />
    <param name="collinear_enabled"  value="$(arg simplify_collinear)" />
    <param name="collinear_angle_deg" value="$(arg simplify_collinear_angle_deg)" />
    <param name="max_segment_m"      value="$(arg simplify_max_segment_m)" />
    <param name="min_spacing_enabled" value="$(arg simplify_min_spacing)" />
    <param name="min_spacing_m"      value="$(arg simplify_min_spacing_m)" />
    <param name="turn_keep_deg"      value="$(arg simplify_turn_keep_deg)" />
  </node>

  <node pkg="falcon_adapter" type="waypoint_follower_node.py"
        name="waypoint_follower" output="screen">
    <param name="drone_ns"               value="$(arg drone_ns)" />
    <param name="vel_x"                  value="$(arg vel_x)" />
    <param name="yaw_rate"               value="$(arg yaw_rate)" />
    <param name="pos_acquisition_radius" value="$(arg pos_acquisition_radius)" />
    <param name="yaw_acquisition_radius" value="$(arg yaw_acquisition_radius)" />
    <param name="yaw_lead_pct"           value="$(arg yaw_lead_pct)" />
    <param name="yaw_settle_dwell_s"     value="$(arg yaw_settle_dwell_s)" />
    <param name="yaw_coast_deg"          value="$(arg yaw_coast_deg)" />
    <param name="yaw_burst_max_deg"      value="$(arg yaw_burst_max_deg)" />
    <param name="min_motion_ticks"       value="$(arg min_motion_ticks)" />
    <!-- graded-pulse / mid-burst-feedback / anti-deadlock yaw -->
    <param name="yaw_graded_pulses"      value="$(arg yaw_graded_pulses)" />
    <param name="yaw_burst_grade_max_ticks" value="$(arg yaw_burst_grade_max_ticks)" />
    <param name="yaw_settle_dwell_per_tick" value="$(arg yaw_settle_dwell_per_tick)" />
    <param name="yaw_burst_live_feedback" value="$(arg yaw_burst_live_feedback)" />
    <param name="yaw_fb_reach_deg"       value="$(arg yaw_fb_reach_deg)" />
    <param name="yaw_fb_confirm_ticks"   value="$(arg yaw_fb_confirm_ticks)" />
    <param name="yaw_max_reversals"      value="$(arg yaw_max_reversals)" />
    <param name="yaw_accept_growth_deg"  value="$(arg yaw_accept_growth_deg)" />
    <param name="yaw_burst_max_ticks"    value="$(arg yaw_burst_max_ticks)" />
    <!-- pose estimator -->
    <param name="use_pose_estimator"     value="$(arg use_pose_estimator)" />
    <param name="est_window_s"           value="$(arg est_window_s)" />
    <param name="est_min_samples"        value="$(arg est_min_samples)" />
    <param name="est_max_buffer_s"       value="$(arg est_max_buffer_s)" />
    <param name="est_wz_cmd_eps"         value="$(arg est_wz_cmd_eps)" />
    <param name="est_vx_cmd_eps"         value="$(arg est_vx_cmd_eps)" />
    <param name="est_ff_blend_min"       value="$(arg est_ff_blend_min)" />
    <param name="est_ff_blend_max"       value="$(arg est_ff_blend_max)" />
    <param name="est_dropout_s"          value="$(arg est_dropout_s)" />
    <param name="est_max_coast_s"        value="$(arg est_max_coast_s)" />
    <param name="est_fresh_tau_s"        value="$(arg est_fresh_tau_s)" />
    <param name="cmd_commit_ticks"       value="$(arg cmd_commit_ticks)" />
    <param name="cmd_stop_eps"           value="$(arg cmd_stop_eps)" />
    <param name="yaw_acquire_max_deg"    value="$(arg yaw_acquire_max_deg)" />
    <param name="predict_hz"             value="$(arg predict_hz)" />
    <param name="predict_horizon_s"      value="$(arg predict_horizon_s)" />
    <param name="predict_yaw_tau_s"      value="$(arg predict_yaw_tau_s)" />
    <param name="predict_vx_tau_s"       value="$(arg predict_vx_tau_s)" />
    <param name="predicted_path_topic"   value="/path/predicted" />
    <param name="predicted_score_topic"  value="/path/predicted_score" />
    <param name="require_map_update"     value="$(arg require_map_update)" />
    <param name="map_update_topic"       value="$(arg map_update_topic)" />
    <param name="map_wait_timeout_s"     value="$(arg map_wait_timeout_s)" />
    <param name="mapsettle_min_s"        value="$(arg mapsettle_min_s)" />
    <param name="mapsettle_min_updates"  value="$(arg mapsettle_min_updates)" />
    <param name="auto_takeoff"           value="$(arg auto_takeoff)" />
    <param name="cruise_z"               value="$(arg cruise_z)" />
    <param name="use_posctrl"            value="$(arg use_posctrl)" />
    <param name="freeze_during_yaw"      value="$(arg freeze_during_yaw)" />
    <param name="maintain_altitude"      value="$(arg maintain_altitude)" />
    <param name="ctrl_rate_hz"           value="$(arg ctrl_rate_hz)" />
    <param name="forward_only"           value="$(arg forward_only)" />
    <param name="cmd_log_path"           value="$(arg cmd_log_path)" />
    <!-- controller selection + multi-axis tuning (only used when controller:=multi_axis) -->
    <param name="controller"             value="$(arg controller)" />
    <param name="mx_lateral_speed_max"   value="$(arg mx_lateral_speed_max)" />
    <param name="mx_yaw_rate"            value="$(arg mx_yaw_rate)" />
    <param name="mx_slow_radius"         value="$(arg mx_slow_radius)" />
    <param name="mx_arrive_speed_min"    value="$(arg mx_arrive_speed_min)" />
    <param name="mx_yaw_engage_deg"      value="$(arg mx_yaw_engage_deg)" />
    <param name="mx_yaw_release_deg"     value="$(arg mx_yaw_release_deg)" />
    <param name="mx_yaw_kp"              value="$(arg mx_yaw_kp)" />
    <param name="mx_travel_cone_deg"     value="$(arg mx_travel_cone_deg)" />
    <param name="mx_translate_suppress_deg"   value="$(arg mx_translate_suppress_deg)" />
    <param name="mx_translate_suppress_floor" value="$(arg mx_translate_suppress_floor)" />
    <param name="mx_min_vx"              value="$(arg mx_min_vx)" />
    <param name="mx_min_vy"              value="$(arg mx_min_vy)" />
    <param name="mx_min_wz_deg"          value="$(arg mx_min_wz_deg)" />
    <param name="mx_min_release_frac"    value="$(arg mx_min_release_frac)" />
    <param name="mx_hold_deadband"       value="$(arg mx_hold_deadband)" />
    <param name="mx_hold_kp"             value="$(arg mx_hold_kp)" />
    <param name="mx_hold_speed_max"      value="$(arg mx_hold_speed_max)" />
    <param name="mx_hold_reacquire_margin" value="$(arg mx_hold_reacquire_margin)" />
    <param name="mx_passed_bearing_deg"  value="$(arg mx_passed_bearing_deg)" />
    <param name="mx_demo_mode"           value="$(arg mx_demo_mode)" />
    <param name="mx_require_mode"        value="$(arg mx_require_mode)" />
    <!-- pure-pursuit controller (only used when controller:=pure_pursuit) -->
    <param name="pp_holonomic"           value="$(arg pp_holonomic)" />
    <param name="pp_cruise_speed"        value="$(arg pp_cruise_speed)" />
    <param name="pp_min_speed"           value="$(arg pp_min_speed)" />
    <param name="pp_max_speed"           value="$(arg pp_max_speed)" />
    <param name="pp_base_lookahead"      value="$(arg pp_base_lookahead)" />
    <param name="pp_min_lookahead"       value="$(arg pp_min_lookahead)" />
    <param name="pp_max_lookahead"       value="$(arg pp_max_lookahead)" />
    <param name="pp_lookahead_speed_gain" value="$(arg pp_lookahead_speed_gain)" />
    <param name="pp_goal_tolerance"      value="$(arg pp_goal_tolerance)" />
    <param name="pp_path_tolerance"      value="$(arg pp_path_tolerance)" />
    <param name="pp_max_yaw_rate"        value="$(arg pp_max_yaw_rate)" />
    <param name="pp_curvature_speed_factor"     value="$(arg pp_curvature_speed_factor)" />
    <param name="pp_curvature_lookahead_factor" value="$(arg pp_curvature_lookahead_factor)" />
    <param name="pp_slow_down_distance"  value="$(arg pp_slow_down_distance)" />
    <param name="pp_speed_smoothing"     value="$(arg pp_speed_smoothing)" />
    <param name="pp_yaw_rate_smoothing"  value="$(arg pp_yaw_rate_smoothing)" />
    <param name="pp_sample_dt"           value="$(arg pp_sample_dt)" />
    <param name="pp_closest_search_back"    value="$(arg pp_closest_search_back)" />
    <param name="pp_closest_search_forward" value="$(arg pp_closest_search_forward)" />
    <param name="pp_smooth_dt"           value="$(arg pp_smooth_dt)" />
    <param name="pp_smooth_min_point_spacing" value="$(arg pp_smooth_min_point_spacing)" />
    <param name="pp_smooth_tangent_scale" value="$(arg pp_smooth_tangent_scale)" />
    <param name="pp_smooth_nominal_speed" value="$(arg pp_smooth_nominal_speed)" />
    <param name="pp_smooth_arc_lut_samples" value="$(arg pp_smooth_arc_lut_samples)" />
    <param name="pp_smooth_zero_endpoint_velocity" value="$(arg pp_smooth_zero_endpoint_velocity)" />
    <param name="pp_min_vx"              value="$(arg pp_min_vx)" />
    <param name="pp_min_vy"              value="$(arg pp_min_vy)" />
    <param name="pp_min_wz_deg"          value="$(arg pp_min_wz_deg)" />
    <param name="pp_min_release_frac"    value="$(arg pp_min_release_frac)" />
    <param name="pp_viz_sample_dt"       value="$(arg pp_viz_sample_dt)" />
    <param name="smooth_path_topic"      value="$(arg smooth_path_topic)" />
    <param name="lookahead_topic"        value="$(arg lookahead_topic)" />
  </node>

  <!-- voxel_reset_watcher: intentionally NOT transferred (diagnostics only).
       Re-add the node here if scripts/voxel_reset_watcher.py is ever ported.
  <node pkg="falcon_adapter" type="voxel_reset_watcher.py"
        name="voxel_reset_watcher" output="screen">
    <param name="topic"     value="/voxel_mapping/occupancy_grid_occupied" />
    <param name="drop_frac" value="0.5" />
    <param name="min_prev"  value="500" />
    <param name="print_hz"  value="0.5" />
  </node>
  -->

  <node pkg="odom_visualization" name="odom_visualization"
        type="odom_visualization" output="screen">
    <remap from="~odometry" to="/odom_world"/>
  </node>

</launch>