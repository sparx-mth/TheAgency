  <arg name="dp_suppress_deg" default="110.0" />
  <arg name="dp_suppress_floor" default="0.15" />
  <arg name="dp_track_yaw_rate" default="0.35" />
  <arg name="dp_travel_cone_deg" default="70.0" />
  <arg name="dp_turn_pitch_bias" default="0.08" />
  <arg name="dp_turn_side_cone_deg" default="35.0" />
  <arg name="dp_yaw_deadband_deg" default="2.0" />
