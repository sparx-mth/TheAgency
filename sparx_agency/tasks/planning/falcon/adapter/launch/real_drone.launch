    <arg name="navdp_pose_topic"        value="$(arg real_pose_topic)" />
    <!-- Forward the localization message type so navdp_click / combination read the
         right type (real_pose_type:=pose would otherwise mismatch the PoseStamped default). -->
    <arg name="navdp_pose_type"         value="$(arg real_pose_type)" />
