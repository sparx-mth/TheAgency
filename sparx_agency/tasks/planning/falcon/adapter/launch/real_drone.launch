    <arg name="navdp_commit_timeout_s"  value="$(arg navdp_commit_timeout_s)" />
    <arg name="navdp_commit_max_deviation_m" value="$(arg navdp_commit_max_deviation_m)" />
    <arg name="navdp_display_mode"      value="$(arg navdp_display_mode)" />
  </include>

  <!-- Interactive BEV viewer + click-to-goal + system-status HUD (bev_viewer:=false
       to disable). Draws the map, the A* route / NavDP leg / flown path (default
       overlays [a]/[1]/[4]; others toggle with keys 1-9/a), and a top-left HUD:
       who is planning (nav_mode + /nav/status: A*/NavDP), the live motion mode
       (forward flight vs rotation, from /cmd_vel), and A* replan events
       (/path/astar_event). Draws the drone from the localization pose directly. -->
  <node pkg="falcon_adapter" type="bev_click_goal_node.py"
        name="bev_click_goal" output="screen" if="$(arg bev_viewer)">
    <param name="drone_ns"           value="$(arg drone_ns)" />
    <param name="nav_mode"           value="$(arg nav_mode)" />
    <param name="pose_stamped_topic" value="$(arg real_pose_topic)" />
    <param name="thinking_window"    value="$(arg thinking_window)" />
  </node>

</launch>
