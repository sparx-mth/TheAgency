<launch>
  <!--
    real_drone.launch — wrapper that points the same nav stack at a
    real drone instead of Gazebo.

    Architecture (only one new node vs. the Gazebo path):

       <real pose topic, e.g. PoseStamped>
                  │
                  ▼
            pose_adapter   (this launch)
                  │   bare Pose
                  ▼
           /<drone_ns>/gt_pose
                  │
                  └──► everything downstream is identical to
                        the Gazebo run — sensor_gate / falcon_adapter /
                        astar_planner / waypoint_follower / bev_click_goal
                        all see the same topic name and message type
                        they always saw.

    camera_info is intentionally NOT bridged for real-drone runs
    (bridge_camera_info defaults to false in nav_stack.launch).
    Camera intrinsics are passed as args below and loaded into rosparam,
    where FALCON's exploration_node reads them.

    Defaults match the xtend drone:
      pose : /xtend/localization        (PoseStamped)
      depth: /xtend/depth_frame_path    (String "<path> <sec> <nsec>" -> .npy, 504x294)
      rgb  : /xtend/rgb_frame_path      (String "<path> <sec> <nsec>" -> .jpg)
      K    : fx=322.635 fy=323.389 cx=242.065 cy=90.030
             (RAW/unrectified intrinsics from the 504x294 calibration.
              FALCON projects the RAW depth with NO undistortion, so the
              correct focals are K's — NOT the rectified P matrix. P's
              smaller, asymmetric fx (253 vs fy 287) over-scaled the cloud
              ~27%, so a 90 cm corridor mapped as ~110 cm.)

    Run example:
      roslaunch falcon_adapter real_drone.launch
  -->

  <!-- ── Forwarded to the included nav launch ─────────────────── -->
  <arg name="map_name" default="office" />
  <arg name="drone_ns" default="" />
  <arg name="gated_ns" default="/gated_drone" />

  <!-- Interactive BEV window (bev_click_goal): the map, the routes, click-to-goal,
       and the system-status HUD (who is planning A*/NavDP, forward-flight vs rotation,
       and A* replan events). On by default; needs a display. Set bev_viewer:=false to
       run headless. -->
  <arg name="bev_viewer" default="true" />

  <!-- ── Real-drone localization ──────────────────────────────── -->
  <arg name="real_pose_topic" default="/xtend/localization" />
<!--   <arg name="real_pose_topic" default="/flow_depth/pose_est" /> -->
  <arg name="real_pose_type"  default="pose_stamped" />

  <!-- ── RGB/depth transport ────────────────────────────────────────
       frame_path (default, the real drone): each frame is saved to disk and a
       tiny std_msgs/String "<path> <sec> <nsec>" is published; mapping_sync
       (depth) and navdp_click (depth+rgb) load the .npy / .jpg and reuse the
       localization-synchronized stamp. topic: raw sensor_msgs/Image straight off
       the wire (Gazebo sim via sim_adapter, or an old bag replay) — set
       image_transport:=topic and the depth/rgb topic defaults below flip to the
       raw /xtend/depth_m + /xtend/rgb. -->
  <arg name="image_transport" default="frame_path" /><!-- frame_path | topic -->

  <!-- Blank this fraction of columns on EACH side of the depth image before
       FALCON fuses it. The left/right edges of the monocular-depth frame are the
       least reliable (distortion + extrapolation) and leak spurious FOV-limit
       voxels; zeroed pixels are skipped by FALCON, image dims unchanged. -->
  <arg name="depth_edge_mask_frac" default="0.05" /><!-- 5% per side; 0 = off, must be < 0.5 -->

  <!-- ── Real-drone depth / rgb (transport-dependent topic names) ──── -->
  <arg name="real_depth_path_topic" default="$(eval '/xtend/depth_frame_path' if arg('image_transport') == 'frame_path' else '/xtend/depth_m')" />
  <arg name="real_rgb_path_topic"   default="$(eval '/xtend/rgb_frame_path' if arg('image_transport') == 'frame_path' else '/xtend/rgb')" />
  <!-- Legacy raw-depth Image topic. Kept ONLY as sensor_gate's input name; on the
       real drone nothing publishes it anymore (depth now arrives as a frame-path),
       so sensor_gate's depth path is inert here. mapping_sync is the sole voxel
       feeder and loads depth from real_depth_path_topic, so this does not affect
       the map. (sensor_gate's turning-freeze is disabled below for the same reason.) -->
  <arg name="real_depth_topic" default="/xtend/depth_m" />

  <!-- ── Camera intrinsics (xtend K-matrix defaults for 504x392) ──
       MUST match the actual depth stream. If image_width/image_height
       don't match what the drone publishes, exploration_node silently
       drops frames. Override on the command line for a different camera:
         cam_fx:=... cam_fy:=... cam_cx:=... cam_cy:=...
         cam_width:=... cam_height:=... -->
  <!-- K-matrix (raw, unrectified) intrinsics. FALCON projects the RAW depth
       image with no undistortion, so the correct focals are K's (fx~=fy, as
       expected for square pixels), NOT the rectified P matrix. Using P's
       smaller fx (253) inflated every metric dimension by fx_K/fx_P ~= 1.27
       (a 90 cm corridor read as ~110 cm). If you ever feed RECTIFIED depth
       instead, switch these back to the P-matrix values. -->
  <arg name="cam_fx"        default="322.6351083474948" />
  <arg name="cam_fy"        default="323.3893307141174" />
  <arg name="cam_cx"        default="242.06479658679714" />
  <arg name="cam_cy"        default="90.03019076680604" />
  <arg name="cam_width"     default="504" />
  <arg name="cam_height"    default="294" />
<!--   <arg name="cam_fx"        default="241.01587457199156" /> -->
<!--   <arg name="cam_fy"        default="273.842961729908" /> -->
<!--   <arg name="cam_cx"        default="224.89565972039185" /> -->
<!--   <arg name="cam_cy"        default="77.84205744139527" /> -->
<!--   <arg name="cam_width"     default="480" /> -->
<!--   <arg name="cam_height"    default="280" /> -->
  <arg name="cam_min_depth" default="0.1" />
  <arg name="cam_max_depth" default="10.0" />


  <!-- ── Optional flight-tuning overrides ────────────────────────-->
  <arg name="vel_x"     default="0.25" />
  <arg name="cruise_z"  default="1.0" />
  <arg name="goal_x"    default="0.0" />
  <arg name="goal_y"    default="-3.0" />
  <!-- Path tracker for the route follower: waypoint (one-axis, default) |
       multi_axis (vx+vy+yaw crab) | pure_pursuit | roll_assist (one-axis nav +
       cross-track ROLL to hold the line). Forwarded to nav_stack. -->
  <arg name="controller" default="roll_assist" />

  <!-- ── NavDP click-to-go (replaces A*; needs the NavDP server up) ──
       use_navdp:=true swaps astar_planner for navdp_click. It consumes the
       same /xtend/rgb_frame_path + /xtend/depth_frame_path frames FALCON maps, so
       its intrinsics inherit the cam_* (raw K) args above automatically — nothing to pass.
       The overlay tracks the live pose altitude. Set
       navdp_camera_info_topic:=/xtend/camera_info to auto-sync intrinsics from
       the (bridged) camera_info (K; must describe the 504x294 stream) instead. -->
  <arg name="use_navdp"               default="false" />
  <arg name="navdp_camera_info_topic" default="" />

  <!-- ── Nav mode selector (default: hybrid) ──────────────────────
       DEFAULT mode: nav_mode:=hybrid runs A* AND hybrid_planner together: A* plans the
       route and is flown directly on the easy stretches; hybrid_planner watches the A*
       route just ahead and, on a hard turn or a narrow passage / doorway, hands NavDP
       the farthest visible A* waypoint until the hard part is behind, then returns to A*.
       nav_mode:=combination is the always-on A*+NavDP fusion; nav_mode:=fallback rescues
       only a boxed-in A*; nav_mode:=astar is plain A*; use_navdp:=true selects pure navdp.
       hybrid / combination / fallback all need the NavDP server up. -->
<!--   <arg name="nav_mode" default="$(eval 'navdp' if use_navdp else 'combination')" /> -->
  <arg name="nav_mode" default="fallback" />  <!-- navdp | astar | combination | fallback | hybrid -->
  <!-- vla = navdp | flownav (which VLA serves nav_mode:=navdp). For FlowNav:
       nav_mode:=navdp vla:=flownav flownav_goal_image:=/path/to/target.png
       and start the FlowNav TRT server (tasks/planning/flownav/server/...). -->
  <arg name="vla"                      default="navdp" />
  <arg name="flownav_goal_image"       default="" />
  <arg name="flownav_goal_image_topic" default="" />
  <arg name="flownav_port"             default="8889" />
  <arg name="flownav_rate_hz"          default="4.0" />
  <arg name="flownav_execute_fraction" default="1.0" />
  <arg name="flownav_arrival_distance" default="0.0" />
  <arg name="flownav_display"          default="false" />
  <arg name="combination_enable_topic"   default="/combination/enable" />
  <arg name="combination_start_enabled"  default="true" />
  <arg name="combination_tick_hz"        default="5.0" />
  <arg name="combination_min_engage_fwd_m" default="1.5" /><!-- cruise A* until a visible point is at least this far ahead, then stop & engage NavDP -->
  <arg name="combination_engage_confirm_ticks" default="2" /><!-- consecutive engage-able detections before stopping (debounce flicker) -->
  <arg name="combination_engage_settle_s"  default="1.0" /><!-- brake-settle before the first inference (clean, stationary frame) -->
  <arg name="combination_max_wait_s"       default="30.0" /><!-- hold this long for a slow re-infer before giving up to A* (raise for a slow Jetson) -->
  <arg name="combination_navdp_timeout_s"  default="10.0" /><!-- NavDP HTTP step timeout for one inference; generous for a slow Jetson -->
  <arg name="combination_leg_fraction"   default="0.5" /><!-- re-infer at the leg midpoint -->
  <arg name="combination_final_handoff_m" default="1.5" /><!-- fly A* straight in for the final approach within this range -->
  <arg name="combination_leg_timeout_s"  default="8.0" /><!-- watchdog: re-infer if a leg runs this long -->
  <arg name="combination_require_unoccluded"     default="true" /><!-- visible = clear line-of-sight, not merely in-FOV -->
  <arg name="combination_visibility_depth_tol_m" default="0.5" /><!-- slack (m) on the occlusion test -->
  <arg name="combination_min_goal_fwd_m" default="0.5" /><!-- ignore A* waypoints nearer than this -->
  <!-- fallback (nav_mode:=fallback): A*-primary + NavDP rescue, hysteretic switch -->
  <arg name="fallback_astar_fail_confirm" default="3" /><!-- consecutive A* "no route" reports before stopping & engaging NavDP -->
  <arg name="fallback_astar_ok_confirm"   default="5" /><!-- consecutive A* "route found" reports before resuming A* (keep >= fail; sticky, anti-zigzag) -->
  <arg name="fallback_tick_hz"            default="5.0" />
  <arg name="fallback_engage_settle_s"    default="1.0" /><!-- brake-settle before the first inference (clean, stationary frame) -->
  <arg name="fallback_navdp_timeout_s"    default="10.0" /><!-- NavDP HTTP step timeout for one inference -->
  <arg name="fallback_leg_fraction"       default="0.5" /><!-- re-infer at the leg midpoint -->
  <arg name="fallback_leg_timeout_s"      default="8.0" /><!-- watchdog: re-infer if a leg runs this long -->
  <arg name="fallback_leg_endpoint_radius_m" default="0.4" /><!-- re-infer once within this of the leg end -->
  <arg name="fallback_arrival_radius_m"   default="0.5" /><!-- within this of the goal NavDP has arrived -> hold -->
  <!-- hybrid (nav_mode:=hybrid, the DEFAULT): A* on easy legs, NavDP on hard maneuvers -->
  <arg name="hybrid_difficulty_lookahead_m" default="2.0" /><!-- forward window (m) for the NARROWNESS/doorway test (the hard-turn engage range is hybrid_turn_engage_distance_m) -->
  <arg name="hybrid_difficulty_skip_m"    default="0.3" /><!-- skip this much past the drone (a just-finished maneuver must not keep reading as "ahead") (m) -->
  <arg name="hybrid_merge_collinear_deg"  default="15.0" /><!-- smooth the jagged raw A* first: drop vertices turning less than this before measuring (staircase noise on a straight corridor must not sum into a false hard turn); 0 = raw route -->
  <arg name="hybrid_turn_thresh_deg"      default="70.0" /><!-- a route corner turning >= this (deg) is a HARD TURN -> NavDP (the operator's ">70 deg"). Only a genuinely sharp corner engages; raise if gentle bends engage, lower if hard turns are missed -->
  <arg name="hybrid_turn_engage_distance_m" default="2.0" /><!-- engage NavDP once a hard turn is within this distance AHEAD ("close enough to the turn"); A* flies the approach up to here, NavDP takes the corner -->
  <arg name="hybrid_turn_corner_span_m"   default="0.7" /><!-- entry/exit chord (m) for a corner's net turn (robust to a split corner / grid jitter) -->
  <arg name="hybrid_passage_width_m"      default="0.75" /><!-- free width (m) below which the route is a doorway (measured perpendicular; tight on BOTH sides). Strict; raise to treat wider gaps as doorways -->
  <arg name="hybrid_min_narrow_span_m"    default="0.3" /><!-- a doorway must stay narrow over at least this arclength (m); rejects a single BEV speckle cell tripping a false doorway -->
  <arg name="hybrid_sample_step_m"        default="0.1" /><!-- perpendicular-march / sampling step (~one BEV cell) (m) -->
  <arg name="hybrid_difficulty_confirm"   default="3" /><!-- consecutive "difficult ahead" ticks before engaging NavDP -->
  <arg name="hybrid_recover_confirm"      default="5" /><!-- consecutive "easy again + A* ok" ticks before resuming A* (keep >= difficulty_confirm; sticky) -->
  <arg name="hybrid_min_pass_distance_m"  default="2.0" /><!-- do NOT return to A* until the drone has flown this far (m) through the maneuver from where NavDP engaged; 0 = off -->
  <arg name="hybrid_engage_on_astar_fail" default="false" /><!-- also engage when A* reports NO route (boxed in). OFF: hybrid is purely difficulty-triggered; a flaky bag-replay A* would otherwise drive NavDP the whole route. Use nav_mode:=fallback for real boxed-A* rescue -->
  <arg name="hybrid_astar_fail_confirm"   default="3" /><!-- consecutive A* "no route" reports before that rescue -->
  <arg name="hybrid_tick_hz"              default="5.0" />
  <arg name="hybrid_engage_settle_s"      default="1.0" /><!-- brake-settle before the first inference (clean, stationary frame) -->
  <arg name="hybrid_navdp_timeout_s"      default="10.0" /><!-- NavDP HTTP step timeout for one inference -->
  <arg name="hybrid_leg_fraction"         default="0.5" /><!-- re-infer at the leg midpoint -->
  <arg name="hybrid_final_handoff_m"      default="1.5" /><!-- hand the final approach to A* within this range -->
  <arg name="hybrid_leg_timeout_s"        default="8.0" /><!-- watchdog: re-infer if a leg runs this long -->
  <arg name="hybrid_leg_endpoint_radius_m" default="0.4" /><!-- re-infer once within this of the leg end -->
  <arg name="hybrid_max_wait_s"           default="30.0" /><!-- hold this long for a slow/blind inference before giving up to A* -->
  <arg name="hybrid_arrival_radius_m"     default="0.5" /><!-- within this of the mission goal a rescue NavDP leg has arrived -> hold -->
  <arg name="hybrid_require_unoccluded"   default="true" /><!-- visible = clear line-of-sight, not merely in-FOV -->
  <arg name="hybrid_visibility_depth_tol_m" default="0.5" /><!-- slack (m) on the occlusion test -->
  <arg name="hybrid_min_goal_fwd_m"       default="0.5" /><!-- ignore A* waypoints nearer than this -->
  <arg name="hybrid_blind_turn_target"    default="true" /><!-- at a hard turn the post-turn route leaves the FOV: drive NavDP toward the farthest A* waypoint reachable by GEOMETRY around the corner so it flies THROUGH the turn instead of holding + reverting to A*; false = hold -->

  <!-- ── Path-correction strategy ─────────────────────────────────
       corrector:=potential_field (default) | esdf. With esdf the route is
       nudged up the distance-to-wall gradient toward the corridor/doorway
       centre. esdf_target_clearance_m: 0 = centre on the ESDF ridge, >0 =
       stop once that far from walls (a safety floor). -->
  <arg name="corrector"               default="potential_field" />
  <arg name="esdf_target_clearance_m" default="0.2" />
  <arg name="esdf_max_total_shift_m"  default="0.5" />
  <!-- Thin a dense input path before correcting (NavDP zig-zag fix); no-op for A*. -->
  <arg name="resample_min_spacing_m"  default="0.3" />

  <!-- ── Wall standoff / push strength (potential_field corrector) ──
       How hard the corrector pushes A*/NavDP waypoints off walls. In the
       default line_search centering, apf_min_clearance_m is the lever: raise it
       (e.g. 0.3-0.4) to force a larger min distance to walls; apf_max_total_shift_m
       must be high enough not to clip the push. apf_gain ONLY applies when
       apf_centering=descent (line_search ignores it). -->
  <arg name="apf_centering"           default="line_search" />
  <arg name="apf_min_clearance_m"     default="0.2" />
  <arg name="apf_max_total_shift_m"   default="0.5" />
  <arg name="apf_gain"                default="0.5" />

  <!-- ── Square (Manhattan) path shape ────────────────────────────
       Produce axis-aligned, right-angle routes instead of diagonal cuts.
       Three settings must agree: connectivity=4 drops A*'s diagonal moves;
       los_smoothing=false keeps the line-of-sight string-puller from collapsing
       each L into a single diagonal; corner_round=false keeps 90 deg corners
       sharp instead of chamfering them into 45 deg bevels. turn_penalty biases
       4-connected A* toward clean single-turn L-shapes (raise it to suppress
       staircases). For the legacy diagonal behaviour set connectivity:=8
       los_smoothing:=true corner_round:=true. -->
  <arg name="connectivity"   default="4" />
  <arg name="los_smoothing"  default="false" />
  <arg name="corner_round"   default="false" />
  <arg name="turn_penalty"   default="0.3" />
  <arg name="heading_penalty_m" default="1.5" /><!-- heading-aware A*: cost (m) for turning the drone AROUND at the start (fly the way it looks; only turn around if forced); 0 = off -->

  <!-- ── NavDP execution / display ────────────────────────────────
       navdp_execute_fraction: fly only the first fraction of the route, hold at
       the prefix end until the next ENTER (NavDP drifts further out). The full
       route is still shown on the BEV viewer. navdp_display_mode: full = RGB +
       depth + snapshot panels | rgb_only = just the clickable RGB panel. -->
  <arg name="navdp_execute_fraction"  default="0.5" />
  <arg name="navdp_display_mode"      default="full" />

  <arg name="publish_mapping_inputs" value="false" />
  <!-- ══════════════════════════════════════════════════════════════
       Pose adapter — converts the real-drone localization message
       into the bare geometry_msgs/Pose every consumer expects on
       /<drone_ns>/gt_pose.
       ══════════════════════════════════════════════════════════════ -->
  <node pkg="falcon_adapter" type="pose_adapter_node.py"
        name="pose_adapter" output="screen">
    <param name="in_topic"  value="$(arg real_pose_topic)" />
    <param name="in_type"   value="$(arg real_pose_type)" />
    <param name="out_topic" value="$(arg drone_ns)/gt_pose" />
  </node>

  <node pkg="falcon_adapter" type="mapping_sync_node.py" name="mapping_sync" output="screen">
    <param name="pose_stamped_topic" value="$(arg real_pose_topic)" />               <!-- /xtend/localization -->
    <!-- Depth as a frame-path String: mapping_sync loads the .npy and rebuilds the
         32FC1 Image at the message's capture stamp. mapping_sync is the SOLE voxel
         feeder here (falcon_adapter runs with publish_mapping_inputs=false) and
         owns the authoritative rotation freeze below, so it must see true capture
         stamps: the frame-path stamp is the same capture time /xtend/localization
         carries (both derived from the depth frame), so they pair exactly. -->
    <param name="depth_transport"    value="$(arg image_transport)" />              <!-- frame_path -> load .npy from a String path; topic -> raw Image -->
    <param name="depth_topic"        value="$(arg real_depth_path_topic)" />         <!-- /xtend/depth_frame_path (frame_path) | /xtend/depth_m (topic) -->
    <param name="edge_mask_frac"     value="$(arg depth_edge_mask_frac)" />          <!-- blank the outer 5% of columns each side (unreliable monocular edges) -->
    <param name="out_pose_topic"     value="/map_ros/pose" />
    <param name="out_depth_topic"    value="/map_ros/depth" />
    <!-- Pairing tolerance. By design the depth frame-path and /xtend/localization
         carry the SAME capture stamp, so the ideal pair is an exact (dt==0) match.
         These windows are kept NON-zero on purpose: depth and AprilTag pose are
         independent consumers of the RGB stream running at DIFFERENT cadences
         (depth on nearly every frame, the tag pose ONLY while a tag is in view),
         so a given depth frame often has no byte-identical pose. sync_tolerance
         lets it pair with the NEAREST pose within 50 ms; max_interp_gap lets it
         SLERP a pose across a bracket up to 120 ms when none is near. This trades a
         small, bounded pairing error (a depth frame may fuse a pose from a slightly
         different instant) for keeping the voxel map fed when localization is not
         in lockstep; without it, strict exact-only would DROP most depth frames.
         To enforce the strict-timestamp architecture instead (exact-only, no
         mis-pair, but frames without a co-stamped pose are dropped): set
         sync_tolerance=0.0 AND max_interp_gap=0.0. Downstream FALCON pairing is
         unaffected, since mapping_sync re-stamps the emitted pose to the depth
         stamp, so /transformer (timestamp_tolerance 0.02) always matches exactly. -->
    <param name="sync_tolerance"     value="0.0" />    <!-- 0 = exact-only (dt==0) -->
    <param name="max_interp_gap"     value="0.0" />    <!-- 0 = no interpolation (nearest-only) -->
    <param name="pose_is_camera_frame" value="false" /> <!-- mirror falcon_adapter for now -->
    <param name="cam_offset_x"         value="0.2" />   <!-- see frame note below -->
    <!-- Rotation freeze (authoritative): drop the (depth,pose) pair while
         /xtend/demo_mode == turning, and drop the stale in-flight turn frame on
         resume, all in the capture clock. -->
    <param name="demo_mode_topic"      value="/xtend/demo_mode" />
    <param name="turning_mode_name"    value="turning" />
    <param name="resume_settle_sec"    value="0.0" />
    <!-- Startup warm-up: force-fuse the first N voxel pairs ignoring demo_mode
         (so a stale latched 'turning' can't freeze mapping at pickup), then reset
         to a forward-flight baseline. 0 disables the warm-up. -->
    <param name="warmup_emits"         value="2" />
  </node>
  <!-- ══════════════════════════════════════════════════════════════
       The actual nav stack — same launch as Gazebo, just with the
       real-drone depth topic and camera intrinsics passed in.
       ══════════════════════════════════════════════════════════════ -->
  <!-- ══ A* planner (route search + replanning) ══
       Defaults mirror the layer below; see nav_stack.launch for the full
       per-parameter notes. Set these from config/mission.yaml. -->
  <arg name="waypoint_spacing_m"            default="1.5" />

  <!-- How wide "in front of the next point" is. The ADVANCE gate is predictive:
       the accepted heading error is asin(yaw_acquisition_radius / distance),
       capped by yaw_acquire_max_deg. At the 1.5 m waypoint spacing above, 0.51 m
       gives ~20 deg. skip_yaw_thresh (RADIANS) is the matching decision for the
       next leg after a waypoint is retired; keep the two in step. -->
  <arg name="yaw_acquisition_radius"        default="0.51" />
  <arg name="yaw_acquire_max_deg"           default="35.0" />
  <arg name="skip_yaw_thresh"               default="0.35" /><!-- rad; 20 deg -->
  <arg name="inflate_radius_m"              default="0.1" />
  <arg name="unknown_blocked"               default="false" />
  <arg name="unknown_cost"                  default="1.0" />
  <arg name="search_margin_m"               default="3.0" />
  <arg name="start_skip_m"                  default="0.5" />
  <arg name="goal_snap_radius_m"            default="2.0" />
  <arg name="min_free_cells_to_plan"        default="80" />
  <arg name="smart_replan"                  default="true" />
  <arg name="replan_corridor_radius_m"      default="1.0" />
  <arg name="replan_min_new_cells"          default="60" />
  <arg name="replan_commit_min_s"           default="4.0" />
  <arg name="replan_improve_frac"           default="0.15" />
  <arg name="stop_on_blocked_plan_fail"     default="true" />
  <arg name="replan_collision_confirm"      default="2" />
  <arg name="plan_period_s"                 default="10.0" />
  <arg name="replan_on_collision"           default="false" />
  <arg name="replan_on_bev"                 default="false" />
  <arg name="corner_merge_deg"              default="8.0" />
  <arg name="corner_max_turn_deg"           default="14.0" />
  <arg name="corner_chamfer_max_deg"        default="28.0" />
  <arg name="corner_chamfer_dist_m"         default="0.5" />
  <arg name="corner_min_runup_m"            default="0.6" />
  <arg name="replan_on_predicted_collision" default="false" />
  <arg name="max_predicted_replans"         default="3" />

  <!-- ══ BEV map (occupancy the planner searches) ══
       Defaults mirror the layer below; see nav_stack.launch for the full
       per-parameter notes. Set these from config/mission.yaml. -->
  <arg name="bev_resolution"             default="0.10" />
  <arg name="bev_xmin"                   default="-6.0" />
  <arg name="bev_ymin"                   default="-6.0" />
  <arg name="bev_xmax"                   default="6.0" />
  <arg name="bev_ymax"                   default="6.0" />
  <arg name="bev_bbox_margin"            default="1.0" />
  <arg name="bev_publish_hz"             default="10.0" />
  <arg name="bev_occ_dilate"             default="0" />
  <arg name="bev_z_floor"                default="0.70" />
  <arg name="bev_z_ceil"                 default="1.50" />
  <arg name="bev_z_peak"                 default="$(arg cruise_z)" />
  <arg name="bev_weight_profile"         default="triangular" />
  <arg name="bev_weight_sigma"           default="0.50" />
  <arg name="bev_voxel_size"             default="$(arg bev_resolution)" />
  <arg name="bev_occ_weight_thresh"      default="2.0" />
  <arg name="bev_min_occ_voxels"         default="4" />
  <arg name="bev_min_free_voxels"        default="1" />
  <arg name="bev_confirm_3d"             default="true" />
  <arg name="bev_neighbors_3d"           default="6" />
  <arg name="bev_min_occ_neighbors_3d"   default="1" />
  <arg name="bev_min_wall_run"           default="3" />
  <arg name="bev_min_component_cells"    default="0" />
  <arg name="bev_component_connectivity" default="8" />
  <arg name="bev_protect_openings"       default="true" />
  <arg name="bev_door_band_m"            default="0.80" />
  <arg name="bev_door_free_voxels"       default="2" />
  <arg name="bev_door_occ_tol"           default="0" />
  <arg name="bev_wall_fill_mode"         default="directional" />
  <arg name="bev_wall_fill_neighbors"    default="5" />
  <arg name="bev_wall_fill_iters"        default="1" />
  <arg name="bev_temporal_filter"        default="true" />
  <arg name="bev_occ_conf_full"          default="3.0" />
  <arg name="bev_t_inc"                  default="1.0" />
  <arg name="bev_t_dec"                  default="1.0" />
  <arg name="bev_t_max"                  default="5.0" />
  <arg name="bev_t_on"                   default="2.0" />
  <arg name="bev_t_off"                  default="0.5" />
  <arg name="bev_always_recompute"       default="false" />
  <arg name="bev_skip_unchanged_publish" default="true" />

  <!-- ══ Path corrector / ESDF / simplifier ══
       Defaults mirror the layer below; see nav_stack.launch for the full
       per-parameter notes. Set these from config/mission.yaml. -->
  <arg name="esdf_max_step_m"              default="0.2" />
  <arg name="esdf_iterations"              default="12" />
  <arg name="esdf_lateral_only"            default="true" />
  <arg name="esdf_smooth_sigma_m"          default="0.1" />
  <arg name="esdf_occ_thresh"              default="0.65" />
  <arg name="simplify_debug"               default="true" />
  <arg name="simplify_merge"               default="true" />
  <arg name="simplify_merge_radius_m"      default="0.20" />
  <arg name="simplify_zigzag"              default="true" />
  <arg name="simplify_zigzag_angle_deg"    default="60.0" />
  <arg name="simplify_zigzag_strength"     default="0.5" />
  <arg name="simplify_zigzag_passes"       default="1" />
  <arg name="simplify_collinear"           default="true" />
  <arg name="simplify_collinear_angle_deg" default="10.0" />
  <arg name="simplify_max_segment_m"       default="3.0" />
  <arg name="simplify_min_spacing"         default="true" />
  <arg name="simplify_min_spacing_m"       default="1.0" />
  <arg name="simplify_turn_keep_deg"       default="25.0" />

  <!-- ══ APF / safety correction ══
       Defaults mirror the layer below; see nav_stack.launch for the full
       per-parameter notes. Set these from config/mission.yaml. -->
  <arg name="safety_correct"            default="true" />
  <arg name="apf_debug"                 default="true" />
  <arg name="apf_collision_recheck"     default="true" />
  <arg name="apf_treat_unknown_as_free" default="true" />
  <arg name="apf_unknown_damping"       default="true" />
  <arg name="apf_unknown_radius_m"      default="0.5" />
  <arg name="publish_forces"            default="true" />
  <arg name="force_arrow_scale"         default="0.5" />
  <arg name="publish_force_field"       default="true" />
  <arg name="force_field_stride"        default="4" />

  <arg name="start_go"          default="true" /><!-- gate open by default here -->
  <arg name="go_topic"          default="/mission/go" />
  <arg name="zero_on_close"     default="true" />
  <arg name="cmd_vel_raw_topic" default="$(arg drone_ns)/cmd_vel_raw" />

  <!-- Lost-localization recovery. Watches the SAME source the stack localizes
       from (real_pose_topic), not the header-less /gt_pose the follower reads. -->
  <arg name="recovery_enabled"       default="true" />
  <arg name="recovery_bearing_topic" default="/xtend/bearing" />
  <arg name="recovery_bearing_units" default="auto" />
  <arg name="recovery_stale_s"       default="0.3" />
  <arg name="recovery_ladder_s"      default="1.0" />
  <arg name="recovery_climb_enabled" default="true" />
  <arg name="recovery_climb_speed"      default="0.08" /><!-- thrust dial; mind the ceiling -->
  <arg name="recovery_climb_duration_s" default="0.4" />
  <arg name="recovery_turn_dir"      default="left" />

  <include file="$(find falcon_adapter)/launch/nav_stack.launch">
    <arg name="start_go"          value="$(arg start_go)" />
    <arg name="go_topic"          value="$(arg go_topic)" />
    <arg name="zero_on_close"     value="$(arg zero_on_close)" />
    <arg name="cmd_vel_raw_topic" value="$(arg cmd_vel_raw_topic)" />
    <!-- Lost-localization recovery -->
    <arg name="recovery_enabled"       value="$(arg recovery_enabled)" />
    <arg name="recovery_pose_topic"    value="$(arg real_pose_topic)" />
    <arg name="recovery_bearing_topic" value="$(arg recovery_bearing_topic)" />
    <arg name="recovery_bearing_units" value="$(arg recovery_bearing_units)" />
    <arg name="recovery_stale_s"       value="$(arg recovery_stale_s)" />
    <arg name="recovery_ladder_s"      value="$(arg recovery_ladder_s)" />
    <arg name="recovery_climb_enabled" value="$(arg recovery_climb_enabled)" />
    <arg name="recovery_climb_speed"      value="$(arg recovery_climb_speed)" />
    <arg name="recovery_climb_duration_s" value="$(arg recovery_climb_duration_s)" />
    <arg name="recovery_turn_dir"      value="$(arg recovery_turn_dir)" />
    <!-- A* planner (route search + replanning) -->
    <arg name="waypoint_spacing_m"            value="$(arg waypoint_spacing_m)" />
    <arg name="yaw_acquisition_radius"        value="$(arg yaw_acquisition_radius)" />
    <arg name="yaw_acquire_max_deg"           value="$(arg yaw_acquire_max_deg)" />
    <arg name="skip_yaw_thresh"               value="$(arg skip_yaw_thresh)" />
    <arg name="inflate_radius_m"              value="$(arg inflate_radius_m)" />
    <arg name="unknown_blocked"               value="$(arg unknown_blocked)" />
    <arg name="unknown_cost"                  value="$(arg unknown_cost)" />
    <arg name="search_margin_m"               value="$(arg search_margin_m)" />
    <arg name="start_skip_m"                  value="$(arg start_skip_m)" />
    <arg name="goal_snap_radius_m"            value="$(arg goal_snap_radius_m)" />
    <arg name="min_free_cells_to_plan"        value="$(arg min_free_cells_to_plan)" />
    <arg name="smart_replan"                  value="$(arg smart_replan)" />
    <arg name="replan_corridor_radius_m"      value="$(arg replan_corridor_radius_m)" />
    <arg name="replan_min_new_cells"          value="$(arg replan_min_new_cells)" />
    <arg name="replan_commit_min_s"           value="$(arg replan_commit_min_s)" />
    <arg name="replan_improve_frac"           value="$(arg replan_improve_frac)" />
    <arg name="stop_on_blocked_plan_fail"     value="$(arg stop_on_blocked_plan_fail)" />
    <arg name="replan_collision_confirm"      value="$(arg replan_collision_confirm)" />
    <arg name="plan_period_s"                 value="$(arg plan_period_s)" />
    <arg name="replan_on_collision"           value="$(arg replan_on_collision)" />
    <arg name="replan_on_bev"                 value="$(arg replan_on_bev)" />
    <arg name="corner_merge_deg"              value="$(arg corner_merge_deg)" />
    <arg name="corner_max_turn_deg"           value="$(arg corner_max_turn_deg)" />
    <arg name="corner_chamfer_max_deg"        value="$(arg corner_chamfer_max_deg)" />
    <arg name="corner_chamfer_dist_m"         value="$(arg corner_chamfer_dist_m)" />
    <arg name="corner_min_runup_m"            value="$(arg corner_min_runup_m)" />
    <arg name="replan_on_predicted_collision" value="$(arg replan_on_predicted_collision)" />
    <arg name="max_predicted_replans"         value="$(arg max_predicted_replans)" />
    <!-- BEV map (occupancy the planner searches) -->
    <arg name="bev_resolution"             value="$(arg bev_resolution)" />
    <arg name="bev_xmin"                   value="$(arg bev_xmin)" />
    <arg name="bev_ymin"                   value="$(arg bev_ymin)" />
    <arg name="bev_xmax"                   value="$(arg bev_xmax)" />
    <arg name="bev_ymax"                   value="$(arg bev_ymax)" />
    <arg name="bev_bbox_margin"            value="$(arg bev_bbox_margin)" />
    <arg name="bev_publish_hz"             value="$(arg bev_publish_hz)" />
    <arg name="bev_occ_dilate"             value="$(arg bev_occ_dilate)" />
    <arg name="bev_z_floor"                value="$(arg bev_z_floor)" />
    <arg name="bev_z_ceil"                 value="$(arg bev_z_ceil)" />
    <arg name="bev_z_peak"                 value="$(arg bev_z_peak)" />
    <arg name="bev_weight_profile"         value="$(arg bev_weight_profile)" />
    <arg name="bev_weight_sigma"           value="$(arg bev_weight_sigma)" />
    <arg name="bev_voxel_size"             value="$(arg bev_voxel_size)" />
    <arg name="bev_occ_weight_thresh"      value="$(arg bev_occ_weight_thresh)" />
    <arg name="bev_min_occ_voxels"         value="$(arg bev_min_occ_voxels)" />
    <arg name="bev_min_free_voxels"        value="$(arg bev_min_free_voxels)" />
    <arg name="bev_confirm_3d"             value="$(arg bev_confirm_3d)" />
    <arg name="bev_neighbors_3d"           value="$(arg bev_neighbors_3d)" />
    <arg name="bev_min_occ_neighbors_3d"   value="$(arg bev_min_occ_neighbors_3d)" />
    <arg name="bev_min_wall_run"           value="$(arg bev_min_wall_run)" />
    <arg name="bev_min_component_cells"    value="$(arg bev_min_component_cells)" />
    <arg name="bev_component_connectivity" value="$(arg bev_component_connectivity)" />
    <arg name="bev_protect_openings"       value="$(arg bev_protect_openings)" />
    <arg name="bev_door_band_m"            value="$(arg bev_door_band_m)" />
    <arg name="bev_door_free_voxels"       value="$(arg bev_door_free_voxels)" />
    <arg name="bev_door_occ_tol"           value="$(arg bev_door_occ_tol)" />
    <arg name="bev_wall_fill_mode"         value="$(arg bev_wall_fill_mode)" />
    <arg name="bev_wall_fill_neighbors"    value="$(arg bev_wall_fill_neighbors)" />
    <arg name="bev_wall_fill_iters"        value="$(arg bev_wall_fill_iters)" />
    <arg name="bev_temporal_filter"        value="$(arg bev_temporal_filter)" />
    <arg name="bev_occ_conf_full"          value="$(arg bev_occ_conf_full)" />
    <arg name="bev_t_inc"                  value="$(arg bev_t_inc)" />
    <arg name="bev_t_dec"                  value="$(arg bev_t_dec)" />
    <arg name="bev_t_max"                  value="$(arg bev_t_max)" />
    <arg name="bev_t_on"                   value="$(arg bev_t_on)" />
    <arg name="bev_t_off"                  value="$(arg bev_t_off)" />
    <arg name="bev_always_recompute"       value="$(arg bev_always_recompute)" />
    <arg name="bev_skip_unchanged_publish" value="$(arg bev_skip_unchanged_publish)" />
    <!-- Path corrector / ESDF / simplifier -->
    <arg name="esdf_max_step_m"              value="$(arg esdf_max_step_m)" />
    <arg name="esdf_iterations"              value="$(arg esdf_iterations)" />
    <arg name="esdf_lateral_only"            value="$(arg esdf_lateral_only)" />
    <arg name="esdf_smooth_sigma_m"          value="$(arg esdf_smooth_sigma_m)" />
    <arg name="esdf_occ_thresh"              value="$(arg esdf_occ_thresh)" />
    <arg name="simplify_debug"               value="$(arg simplify_debug)" />
    <arg name="simplify_merge"               value="$(arg simplify_merge)" />
    <arg name="simplify_merge_radius_m"      value="$(arg simplify_merge_radius_m)" />
    <arg name="simplify_zigzag"              value="$(arg simplify_zigzag)" />
    <arg name="simplify_zigzag_angle_deg"    value="$(arg simplify_zigzag_angle_deg)" />
    <arg name="simplify_zigzag_strength"     value="$(arg simplify_zigzag_strength)" />
    <arg name="simplify_zigzag_passes"       value="$(arg simplify_zigzag_passes)" />
    <arg name="simplify_collinear"           value="$(arg simplify_collinear)" />
    <arg name="simplify_collinear_angle_deg" value="$(arg simplify_collinear_angle_deg)" />
    <arg name="simplify_max_segment_m"       value="$(arg simplify_max_segment_m)" />
    <arg name="simplify_min_spacing"         value="$(arg simplify_min_spacing)" />
    <arg name="simplify_min_spacing_m"       value="$(arg simplify_min_spacing_m)" />
    <arg name="simplify_turn_keep_deg"       value="$(arg simplify_turn_keep_deg)" />
    <!-- APF / safety correction -->
    <arg name="safety_correct"            value="$(arg safety_correct)" />
    <arg name="apf_debug"                 value="$(arg apf_debug)" />
    <arg name="apf_collision_recheck"     value="$(arg apf_collision_recheck)" />
    <arg name="apf_treat_unknown_as_free" value="$(arg apf_treat_unknown_as_free)" />
    <arg name="apf_unknown_damping"       value="$(arg apf_unknown_damping)" />
    <arg name="apf_unknown_radius_m"      value="$(arg apf_unknown_radius_m)" />
    <arg name="publish_forces"            value="$(arg publish_forces)" />
    <arg name="force_arrow_scale"         value="$(arg force_arrow_scale)" />
    <arg name="publish_force_field"       value="$(arg publish_force_field)" />
    <arg name="force_field_stride"        value="$(arg force_field_stride)" />

    <arg name="map_name"      value="$(arg map_name)" />
    <arg name="drone_ns"      value="$(arg drone_ns)" />
    <arg name="gated_ns"      value="$(arg gated_ns)" />
    <arg name="publish_mapping_inputs" value="$(arg publish_mapping_inputs)" />
    <arg name="image_transport" value="$(arg image_transport)" />
    <!-- sensor_gate's raw-depth Image input name; see real_depth_topic. -->
    <arg name="depth_topic"   value="$(arg real_depth_topic)" />
    <!-- frame_path: depth never reaches sensor_gate (it arrives as a frame-path the
         voxel feeder mapping_sync loads), so its depth-driven resume can't fire —
         disable its turning-freeze (mapping_sync owns the authoritative freeze).
         topic: raw depth DOES reach sensor_gate, so keep the freeze on (the Gazebo
         default), restoring the pre-frame-path behaviour. -->
    <arg name="sensor_gate_freeze_on_turning_mode" value="$(eval 'false' if arg('image_transport') == 'frame_path' else 'true')" />

    <arg name="cam_fx"        value="$(arg cam_fx)" />
    <arg name="cam_fy"        value="$(arg cam_fy)" />
    <arg name="cam_cx"        value="$(arg cam_cx)" />
    <arg name="cam_cy"        value="$(arg cam_cy)" />
    <arg name="cam_width"     value="$(arg cam_width)" />
    <arg name="cam_height"    value="$(arg cam_height)" />
    <arg name="cam_min_depth" value="$(arg cam_min_depth)" />
    <arg name="cam_max_depth" value="$(arg cam_max_depth)" />

    <arg name="vel_x"         value="$(arg vel_x)" />
    <arg name="cruise_z"      value="$(arg cruise_z)" />
    <arg name="goal_x"        value="$(arg goal_x)" />
    <arg name="goal_y"        value="$(arg goal_y)" />
    <arg name="controller"    value="$(arg controller)" />

    <arg name="use_navdp"               value="$(arg use_navdp)" />
    <arg name="nav_mode"                value="$(arg nav_mode)" />
    <arg name="vla"                      value="$(arg vla)" />
    <arg name="flownav_goal_image"       value="$(arg flownav_goal_image)" />
    <arg name="flownav_goal_image_topic" value="$(arg flownav_goal_image_topic)" />
    <arg name="flownav_port"             value="$(arg flownav_port)" />
    <arg name="flownav_rate_hz"          value="$(arg flownav_rate_hz)" />
    <arg name="flownav_execute_fraction" value="$(arg flownav_execute_fraction)" />
    <arg name="flownav_arrival_distance" value="$(arg flownav_arrival_distance)" />
    <arg name="flownav_display"          value="$(arg flownav_display)" />
    <arg name="combination_enable_topic"       value="$(arg combination_enable_topic)" />
    <arg name="combination_start_enabled"      value="$(arg combination_start_enabled)" />
    <arg name="combination_tick_hz"            value="$(arg combination_tick_hz)" />
    <arg name="combination_min_engage_fwd_m"   value="$(arg combination_min_engage_fwd_m)" />
    <arg name="combination_engage_confirm_ticks" value="$(arg combination_engage_confirm_ticks)" />
    <arg name="combination_engage_settle_s"    value="$(arg combination_engage_settle_s)" />
    <arg name="combination_max_wait_s"         value="$(arg combination_max_wait_s)" />
    <arg name="combination_navdp_timeout_s"    value="$(arg combination_navdp_timeout_s)" />
    <arg name="combination_leg_fraction"       value="$(arg combination_leg_fraction)" />
    <arg name="combination_final_handoff_m"    value="$(arg combination_final_handoff_m)" />
    <arg name="combination_leg_timeout_s"      value="$(arg combination_leg_timeout_s)" />
    <arg name="combination_require_unoccluded"     value="$(arg combination_require_unoccluded)" />
    <arg name="combination_visibility_depth_tol_m" value="$(arg combination_visibility_depth_tol_m)" />
    <arg name="combination_min_goal_fwd_m"     value="$(arg combination_min_goal_fwd_m)" />
    <arg name="fallback_astar_fail_confirm"    value="$(arg fallback_astar_fail_confirm)" />
    <arg name="fallback_astar_ok_confirm"      value="$(arg fallback_astar_ok_confirm)" />
    <arg name="fallback_tick_hz"               value="$(arg fallback_tick_hz)" />
    <arg name="fallback_engage_settle_s"       value="$(arg fallback_engage_settle_s)" />
    <arg name="fallback_navdp_timeout_s"       value="$(arg fallback_navdp_timeout_s)" />
    <arg name="fallback_leg_fraction"          value="$(arg fallback_leg_fraction)" />
    <arg name="fallback_leg_timeout_s"         value="$(arg fallback_leg_timeout_s)" />
    <arg name="fallback_leg_endpoint_radius_m" value="$(arg fallback_leg_endpoint_radius_m)" />
    <arg name="fallback_arrival_radius_m"      value="$(arg fallback_arrival_radius_m)" />
    <arg name="hybrid_difficulty_lookahead_m"  value="$(arg hybrid_difficulty_lookahead_m)" />
    <arg name="hybrid_difficulty_skip_m"       value="$(arg hybrid_difficulty_skip_m)" />
    <arg name="hybrid_merge_collinear_deg"     value="$(arg hybrid_merge_collinear_deg)" />
    <arg name="hybrid_turn_thresh_deg"         value="$(arg hybrid_turn_thresh_deg)" />
    <arg name="hybrid_turn_engage_distance_m"  value="$(arg hybrid_turn_engage_distance_m)" />
    <arg name="hybrid_turn_corner_span_m"      value="$(arg hybrid_turn_corner_span_m)" />
    <arg name="hybrid_passage_width_m"         value="$(arg hybrid_passage_width_m)" />
    <arg name="hybrid_min_narrow_span_m"       value="$(arg hybrid_min_narrow_span_m)" />
    <arg name="hybrid_sample_step_m"           value="$(arg hybrid_sample_step_m)" />
    <arg name="hybrid_difficulty_confirm"      value="$(arg hybrid_difficulty_confirm)" />
    <arg name="hybrid_recover_confirm"         value="$(arg hybrid_recover_confirm)" />
    <arg name="hybrid_min_pass_distance_m"     value="$(arg hybrid_min_pass_distance_m)" />
    <arg name="hybrid_engage_on_astar_fail"    value="$(arg hybrid_engage_on_astar_fail)" />
    <arg name="hybrid_astar_fail_confirm"      value="$(arg hybrid_astar_fail_confirm)" />
    <arg name="hybrid_tick_hz"                 value="$(arg hybrid_tick_hz)" />
    <arg name="hybrid_engage_settle_s"         value="$(arg hybrid_engage_settle_s)" />
    <arg name="hybrid_navdp_timeout_s"         value="$(arg hybrid_navdp_timeout_s)" />
    <arg name="hybrid_leg_fraction"            value="$(arg hybrid_leg_fraction)" />
    <arg name="hybrid_final_handoff_m"         value="$(arg hybrid_final_handoff_m)" />
    <arg name="hybrid_leg_timeout_s"           value="$(arg hybrid_leg_timeout_s)" />
    <arg name="hybrid_leg_endpoint_radius_m"   value="$(arg hybrid_leg_endpoint_radius_m)" />
    <arg name="hybrid_max_wait_s"              value="$(arg hybrid_max_wait_s)" />
    <arg name="hybrid_arrival_radius_m"        value="$(arg hybrid_arrival_radius_m)" />
    <arg name="hybrid_require_unoccluded"      value="$(arg hybrid_require_unoccluded)" />
    <arg name="hybrid_blind_turn_target"       value="$(arg hybrid_blind_turn_target)" />
    <arg name="hybrid_visibility_depth_tol_m"  value="$(arg hybrid_visibility_depth_tol_m)" />
    <arg name="hybrid_min_goal_fwd_m"          value="$(arg hybrid_min_goal_fwd_m)" />
    <arg name="navdp_rgb_topic"         value="$(arg real_rgb_path_topic)" />
    <arg name="navdp_depth_topic"       value="$(arg real_depth_path_topic)" />
    <arg name="navdp_pose_topic"        value="$(arg real_pose_topic)" />
    <!-- Forward the localization message type so navdp_click / combination read the
         right type (real_pose_type:=pose would otherwise mismatch the PoseStamped default). -->
    <arg name="navdp_pose_type"         value="$(arg real_pose_type)" />
    <arg name="navdp_camera_info_topic" value="$(arg navdp_camera_info_topic)" />

    <arg name="corrector"               value="$(arg corrector)" />
    <arg name="esdf_target_clearance_m" value="$(arg esdf_target_clearance_m)" />
    <arg name="esdf_max_total_shift_m"  value="$(arg esdf_max_total_shift_m)" />
    <arg name="resample_min_spacing_m"  value="$(arg resample_min_spacing_m)" />
    <arg name="apf_centering"           value="$(arg apf_centering)" />
    <arg name="apf_min_clearance_m"     value="$(arg apf_min_clearance_m)" />
    <arg name="apf_max_total_shift_m"   value="$(arg apf_max_total_shift_m)" />
    <arg name="apf_gain"                value="$(arg apf_gain)" />
    <arg name="connectivity"            value="$(arg connectivity)" />
    <arg name="los_smoothing"           value="$(arg los_smoothing)" />
    <arg name="corner_round"            value="$(arg corner_round)" />
    <arg name="turn_penalty"            value="$(arg turn_penalty)" />
    <arg name="heading_penalty_m"       value="$(arg heading_penalty_m)" />
    <arg name="navdp_execute_fraction"  value="$(arg navdp_execute_fraction)" />
    <arg name="navdp_display_mode"      value="$(arg navdp_display_mode)" />
  </include>

  <!-- Interactive BEV viewer + click-to-goal + system-status HUD (bev_viewer:=false
       to disable). Draws the map, the A* route / NavDP leg / flown path (default
       overlays [a]/[1]/[4]; others toggle with keys 1-9/a), and a top-left HUD:
       who is planning (nav_mode + /nav/status: A*/NavDP), the live motion mode
       (forward flight vs rotation, from /cmd_vel), and A* replan events
       (/path/astar_event). Draws the drone from the localization pose directly. -->
  <node pkg="falcon_adapter" type="bev_click_goal_node.py"
        name="bev_click_goal" output="screen" if="$(arg bev_viewer)">
    <param name="drone_ns"           value="$(arg drone_ns)" />
    <param name="nav_mode"           value="$(arg nav_mode)" />
    <param name="pose_stamped_topic" value="$(arg real_pose_topic)" />
  </node>

</launch>