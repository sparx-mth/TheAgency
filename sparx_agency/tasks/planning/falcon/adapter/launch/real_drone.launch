    <arg name="hybrid_passage_width_m"         value="$(arg hybrid_passage_width_m)" />
    <arg name="hybrid_min_narrow_span_m"       value="$(arg hybrid_min_narrow_span_m)" />
    <arg name="hybrid_sample_step_m"           value="$(arg hybrid_sample_step_m)" />
    <arg name="hybrid_difficulty_confirm"      value="$(arg hybrid_difficulty_confirm)" />
    <arg name="hybrid_recover_confirm"         value="$(arg hybrid_recover_confirm)" />
