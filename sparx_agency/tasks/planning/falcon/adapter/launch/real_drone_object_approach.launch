<launch>
  <!--
    real_drone_object_approach.launch — ONE launch that brings up the whole
    "fly the route while hunting an object, then close on it" mission.

    = real_drone.launch (map + BEV + A*/NavDP planner + route follower)
    + object_approach.launch (tracker/visual-servo/scan state machine + live
      target-lock HUD viewer, fed by the external TensorRT detector sidecar)
    + the interactive BEV window (bev_click_goal: shows /falcon/bev_2d and
      click-to-set-goal on /waypoint_nav/goal).

    So a single command starts everything the mission needs:

      # in the FALCON container (see run_falcon.sh):
      roslaunch falcon_adapter real_drone_object_approach.launch \
          map_name:=office target_object:=refrigerator goal_x:=0.0 goal_y:=-3.0

    Flow: the planner flies to (goal_x, goal_y) while the detector scans in the
    background. On confirmation the object_approach node grabs /cmd_vel (via the
    visual_servoing hand-off), closes on the object with per-axis force-shaped
    commands (default multi_axis + "fixed" bang-bang) and, on reaching it (sustained
    depth range <= land_range_m, default 1.0 m), ENDS the mission by landing: it stops
    driving /cmd_vel and requests 'finish' (stop -> land -> disarm on /xtend/cmd_nav
    via the demo manager). Set land_range_m:=0 to hold a moving-target lock instead.
    A lost track re-searches, then re-asserts the goal and hands back to the planner.
    If the route reaches the goal unconfirmed, the node sweeps the room.

    Intrinsics: object_approach inherits the same raw-K cam_* as the map, so the
    detector geometry matches the voxel map. Everything is overridable below.
  -->

  <!-- ── Shared / nav ─────────────────────────────────────────────── -->
  <arg name="map_name"      default="office" />
  <arg name="drone_ns"      default="" />
  <arg name="image_transport" default="frame_path" />
  <arg name="goal_x"        default="0.0" />
  <arg name="goal_y"        default="-3.0" />
  <arg name="nav_mode"      default="combination" /><!-- navdp | astar | combination -->
  <arg name="use_navdp"     default="false" />
  <!-- Route follower tracker. Independent of closure_mode below; defaults to the
       working one-axis follower. Set multi_axis to match the closure. -->
  <arg name="controller"    default="waypoint" />

  <!-- Camera intrinsics (raw K; shared by the map AND the detector). -->
  <arg name="cam_fx"        default="322.6351083474948" />
  <arg name="cam_fy"        default="323.3893307141174" />
  <arg name="cam_cx"        default="242.06479658679714" />
  <arg name="cam_cy"        default="90.03019076680604" />
  <arg name="cam_width"     default="504" />
  <arg name="cam_height"    default="294" />

  <!-- ── Object-approach mission ──────────────────────────────────── -->
  <arg name="target_object"   default="refrigerator" />
  <arg name="start_enabled"   default="true" />
  <arg name="lock_mode"       default="detector_tracker" />  <!-- detector_tracker | detector -->
  <arg name="closure_mode"    default="multi_axis" />        <!-- multi_axis | waypoint -->
  <arg name="force_mode"      default="fixed" />             <!-- fixed | snap | none -->
  <arg name="arrive_radius_m" default="0.6" />
  <!-- Success/stop distance to the OBJECT: the visual servo declares at_target
       (HOVER_LOCK) once the depth range to the box is <= this and it is centred.
       Default 0.5 m; set 1.0 to consider the object "reached" within 1 metre.
       Needs working depth; without it, closeness falls back to target_area_frac. -->
  <arg name="target_range_m"  default="0.5" />
  <!-- Reach-and-LAND distance to the OBJECT: on a sustained depth range <= this the
       mission ends by landing. The node stops driving /cmd_vel and requests the
       'finish' demo mode (stop then land then disarm on /xtend/cmd_nav via the demo
       manager). Default 1.0 m (land one metre from the object). Needs working depth;
       set land_range_m:=0 to disable and keep the legacy hover-lock (no land). -->
  <arg name="land_range_m"       default="1.0" />
  <arg name="land_confirm_ticks" default="3" /><!-- consecutive in-range ticks before landing -->

  <!-- min_score = the confirmation gate's floor for HARD acquisition / the green
       HUD box (0.15). It forms a SOFT-CONFIRM BAND with the detector's own
       conf_thresh (set on the sidecar, e.g. -p conf_thresh:=0.05): a detection in
       [conf_thresh, min_score) is too weak to acquire from scratch, but if one sits
       ON the tracked box (IoU) it re-confirms the lock (see soft_confirm_min_score).
       Keep the sidecar's conf_thresh <= min_score. -->
  <arg name="min_score"       default="0.15" />
  <arg name="n_confirm"       default="3" />

  <!-- The detector runs as a ROS2 sidecar on the HOST (the FALCON image has no
       CUDA/TensorRT/pycuda). Start it there and bridge its two String topics; it
       takes its own engine/weights parameters, so none appear here. See the README. -->

  <!-- ── Viewers (on by default; need a display) ──────────────────── -->
  <arg name="viewer"          default="true" />              <!-- live target-lock HUD window -->
  <arg name="bev_viewer"      default="true" />              <!-- interactive BEV / click-to-goal -->
  <!-- Render the HUD overlay Image at all. viewer:=false only closes the window
       (the overlay is still drawn + published); publish_overlay:=false also stops
       the rendering, saving the draw cost. Set both false to fully disable the HUD. -->
  <arg name="publish_overlay" default="true" />

  <!-- ══ The nav stack pointed at the real drone ══════════════════── -->
  <include file="$(find falcon_adapter)/launch/real_drone.launch">
    <arg name="map_name"        value="$(arg map_name)" />
    <arg name="drone_ns"        value="$(arg drone_ns)" />
    <arg name="image_transport" value="$(arg image_transport)" />
    <arg name="goal_x"          value="$(arg goal_x)" />
    <arg name="goal_y"          value="$(arg goal_y)" />
    <arg name="nav_mode"        value="$(arg nav_mode)" />
    <arg name="use_navdp"       value="$(arg use_navdp)" />
    <arg name="controller"      value="$(arg controller)" />
    <arg name="cam_fx"          value="$(arg cam_fx)" />
    <arg name="cam_fy"          value="$(arg cam_fy)" />
    <arg name="cam_cx"          value="$(arg cam_cx)" />
    <arg name="cam_cy"          value="$(arg cam_cy)" />
    <arg name="cam_width"       value="$(arg cam_width)" />
    <arg name="cam_height"      value="$(arg cam_height)" />
    <!-- real_drone.launch owns the interactive BEV window; do NOT also launch one
         below, or roslaunch aborts on a duplicate /bev_click_goal node name. -->
    <arg name="bev_viewer"      value="$(arg bev_viewer)" />
  </include>

  <!-- ══ The object-approach mission (detector + servo + HUD) ═══════── -->
  <include file="$(find falcon_adapter)/launch/object_approach.launch">
    <arg name="cmd_vel_topic"   value="$(arg drone_ns)/cmd_vel_raw" />
    <arg name="drone_ns"        value="$(arg drone_ns)" />
    <arg name="image_transport" value="$(arg image_transport)" />
    <arg name="target_object"   value="$(arg target_object)" />
    <arg name="start_enabled"   value="$(arg start_enabled)" />
    <arg name="lock_mode"       value="$(arg lock_mode)" />
    <arg name="closure_mode"    value="$(arg closure_mode)" />
    <arg name="force_mode"      value="$(arg force_mode)" />
    <arg name="arrive_radius_m" value="$(arg arrive_radius_m)" />
    <arg name="target_range_m"  value="$(arg target_range_m)" />
    <arg name="land_range_m"       value="$(arg land_range_m)" />
    <arg name="land_confirm_ticks" value="$(arg land_confirm_ticks)" />
    <arg name="min_score"       value="$(arg min_score)" />
    <arg name="n_confirm"       value="$(arg n_confirm)" />
    <!-- The route's goal, so arrival -> scan works and give-up re-injects it. -->
    <arg name="goal_x"          value="$(arg goal_x)" />
    <arg name="goal_y"          value="$(arg goal_y)" />
    <!-- Detector geometry MUST match the map (same raw K). -->
    <arg name="fx"              value="$(arg cam_fx)" />
    <arg name="fy"              value="$(arg cam_fy)" />
    <arg name="cx"              value="$(arg cam_cx)" />
    <arg name="cy"              value="$(arg cam_cy)" />
    <arg name="img_width"       value="$(arg cam_width)" />
    <arg name="img_height"      value="$(arg cam_height)" />
    <arg name="viewer"          value="$(arg viewer)" />
    <arg name="publish_overlay" value="$(arg publish_overlay)" />
  </include>

  <!-- The interactive BEV window (map + click-to-set-goal) is launched by
       real_drone.launch above (bev_viewer forwarded). It is NOT launched here too:
       two nodes named /bev_click_goal would make roslaunch abort. -->
</launch>
