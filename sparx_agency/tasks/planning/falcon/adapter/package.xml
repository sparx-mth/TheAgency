<?xml version="1.0"?>
<package format="2">
  <name>falcon_adapter</name>
  <version>0.2.0</version>
  <description>Bridges FALCON planner topics to sjtu_drone in Gazebo (sensing + closed-loop control)</description>
  <maintainer email="dev@example.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build-time dependencies (required for find_package in CMakeLists.txt) -->
  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>quadrotor_msgs</build_depend>

  <!-- Runtime dependencies (required to run the package) -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
</package>