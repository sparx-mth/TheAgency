-    for (size_t i = 0; i < track.size(); ++i)
+    // The span below reads only the last PINNED_WINDOW_S of the history;
+    for (size_t i = 0; i < track.size(); ++i) {
+      if (track[i].first < now_s - PINNED_WINDOW_S)
+        continue;   // the pinned test owns only the recent tail of the history
       span = std::max(span, (track[i].second - pos).norm());
-    if (!at_target && track.front().first <= now_s - 25.0 && span < 2.0) {
+      // whether that history is long ENOUGH is asked of track.front().
+    }
+
+    // ...and the same failure with the aircraft MOVING, which the span test
+    // above cannot see. The follower's own recovery ladder is bigger than that
+    // threshold -- a contact retreat backs out 1.3 m, an unstick runs 0.20 m/s
+    // for 6 s -- so an aircraft in a strike-retreat-reapproach loop spans more
+    // than 2 m and reads as healthy while getting nowhere. Measured in run h04:
+    // "commanded 1.9 m of travel and moved 0.06 m" at (5.2, 1.6), the tour
+    // aiming at one viewpoint forty times, and this guard silent throughout.
+    //
+    // What separates a loop from a transit is what the path BUYS. A transit
+    // spends its path on displacement and on closing the gap to the target; a
+    // loop spends it on neither. Requiring all three -- no closing progress, a
+    // path worth measuring, and a path much longer than the displacement it
+    // produced -- keeps a legitimate detour around a wall out of it, because a
+    // detour still goes somewhere even when it is briefly no nearer.
+    double path = 0.0;
+    for (size_t i = 1; i < track.size(); ++i)
+      path += (track[i].second - track[i - 1].second).norm();
+    const double net = (pos - track.front().second).norm();
+    const double closed =
+        (track.front().second - next_pos).norm() - (pos - next_pos).norm();
+    // `closed` must be NEGATIVE, not merely small. Measured in run h05: seven
+    // fires at a 0.5 m bar, of which two -- "closed 0.49 m" and "closed
+    // 0.33 m" -- were an aircraft genuinely arriving, only slowly. It plans at
+    // 0.15 m/s and legitimately crawls at 0.34-0.61x that through a doorway, so
+    // half a metre of straight-line closure in 25 s is ordinary progress, not a
+    // dead end; and rounding a corner converts path into almost no closure at
+    // all while still being exactly the right thing to do. Ending the window
+    // FURTHER from the viewpoint than it started, having flown several metres,
+    // admits no such reading. The five genuine fires in that run were all
+    // negative (-0.44 to -1.45 m); both false positives were positive.
+    // Over 60 s at a 0.15 m/s plan the aircraft can cover about 9 m, so 5 m of
+    // path is still a modest bar; what carries the verdict is that none of it
+    // became displacement or closure.
+    const bool looping = path > 5.0 && path > 2.0 * net && closed < 0.0;
+
+    if (!at_target && track.front().first <= now_s - LOOP_WINDOW_S && looping) {
+      frontier_finder_->addBlockedRegion(next_pos);
