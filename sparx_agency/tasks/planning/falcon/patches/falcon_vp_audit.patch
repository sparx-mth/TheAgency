+// ── Viewpoint-placement attribution ────────────────────────────────────────
+//
+// A cluster retires to dormant when sampleViewpoints() returns nothing, and
+// there are two entirely different reasons that happens which no log
+// distinguishes today: either no candidate POSITION is in observed free space,
+// or candidate positions exist and every ray from them to the frontier is
+// judged blocked. Those need opposite fixes -- the first is about where the
+// aircraft is allowed to stand, the second about what counts as seeing -- and
+// a premature FINISH looks identical either way from outside.
+//
+// So record which, for every cluster that retires, in the same spirit as the
+// follower's binding-limiter histogram: attribute, do not guess.
+//
+// File scope rather than a member deliberately. frontier_finder.h is shared by
+// four packages, and adding a member to it while rebuilding only the owning
+// package is an ODR violation that corrupts the heap at startup and ships an
+// empty voxel map. This costs one translation unit and no header change.
+struct ViewpointAudit {
+  int candidates;      // ring positions considered
+  int keep_out;        // rejected: inside a declared keep-out volume
+  int out_of_box;      // rejected: outside the map box
+  int occupied;        // rejected: standing inside an obstacle
+  int unknown;         // rejected: standing in never-observed space
+  int near_unknown;    // rejected: too close to never-observed space
+  int placeable;       // survived every position test
+  int zero_visible;    // placeable, but saw not one frontier cell
+  int below_bar;       // placeable, saw something, under the visibility bar
+  int accepted;        // became a viewpoint
+  int max_visible;     // best visibility any placeable candidate achieved
+  long rays;                  // rays cast to frontier cells this call
+  long ray_outside_fov;       // cell not in the camera cone at all
+  long ray_blocked_occupied;  // blocked by mapped structure -- a real wall
+  long ray_blocked_unknown;   // blocked by UNOBSERVED space
+  long ray_clear;             // cell seen
+  void reset() {
+    candidates = keep_out = out_of_box = occupied = unknown = near_unknown = 0;
+    placeable = zero_visible = below_bar = accepted = max_visible = 0;
+    rays = ray_outside_fov = ray_blocked_occupied = ray_blocked_unknown = ray_clear = 0;
+  }
+};
+ViewpointAudit g_vp_audit;
+
 }  // namespace
 
