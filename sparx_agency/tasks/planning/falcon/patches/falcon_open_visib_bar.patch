+// ── How much of a frontier an OPEN-SPACE viewpoint must see ────────────────
+//
+// min_visib_num is an absolute count of downsampled frontier cells, but the
+// most any viewpoint CAN see is the cluster's own size. Against a 100-cell
+// cluster it asks for a few percent; against an 18-cell one it asks for 16 of
+// 18. The bar is hardest exactly where the cluster is smallest, and small
+// leftover clusters are what remains late in a mission -- which is why runs
+// stop growing with clusters still retired behind it. Measured on two hospital
+// legs: 96.9% and 100% of ALL retirements were "saw something, under the bar",
+// one of them ending with 46 clusters dormant.
+//
+// A relative bar was tried globally and REGRESSED THE WAREHOUSE, turning a
+// finish into a pinned abort. The mechanism was specific: relaxing the bar
+// admits frontiers bounding the hollow ClutteringC crates' sealed interior
+// cavities, which can never be observed and so never stop being frontiers, and
+// the aircraft grinds across the crate tops chasing them.
+//
+// The discriminator was already in this function. Those cavity viewpoints are
+// all isNearOccupied -- wedged against the shell they are trying to see past.
+// A frontier in an open hospital room is not. So the relaxation applies ONLY to
+// candidates with real clearance, and anything standing near structure still
+// faces upstream's full absolute bar. That keeps the warehouse's sealed pockets
+// unreachable while letting an open-space leftover be observed.
+//
+// Fraction <= 0 restores the absolute bar everywhere, which is upstream exactly.
+int openSpaceVisibilityBar(const int cluster_cells, const int absolute_bar) {
+  static bool loaded = false;
+  static double fraction = 0.0;
+  static int floor_cells = 0;
+  if (!loaded) {
+    ros::param::param("/frontier_finder/open_visib_fraction", fraction, 0.0);
+    ros::param::param("/frontier_finder/open_visib_floor", floor_cells, 0);
+    loaded = true;
+    ROS_WARN("[open_bar] absolute=%d fraction=%.2f floor=%d (applies only to "
+             "candidates that are NOT near occupied; fraction <= 0 restores the "
+             "absolute bar everywhere)", absolute_bar, fraction, floor_cells);
+  }
+  if (fraction <= 0.0)
+    return absolute_bar;
+  int bar = static_cast<int>(fraction * static_cast<double>(cluster_cells));
+  if (bar > absolute_bar) bar = absolute_bar;   // relax only, never tighten
+  if (bar < floor_cells) bar = floor_cells;
+  return bar;
+}
