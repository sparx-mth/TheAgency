+double FrontierFinder::blockedRadiusFor(int strikes) const {
+  if (blocked_region_radius_max_ <= blocked_region_radius_)
+    return blocked_region_radius_;
+  int doublings = strikes - 1;
+  if (doublings < 0)
+    doublings = 0;
+  // Bound the shift itself, not just its result: strikes is unbounded and
+  // 1 << 31 is undefined behaviour long before the std::min would save it.
+  if (doublings > blocked_region_ttl_max_doubling_)
+    doublings = blocked_region_ttl_max_doubling_;
+  if (doublings > 16)
+    doublings = 16;
+  const double r = blocked_region_radius_ * double(1 << doublings);
+  return r < blocked_region_radius_max_ ? r : blocked_region_radius_max_;
+}
