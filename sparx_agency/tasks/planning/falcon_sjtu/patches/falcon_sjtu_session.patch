+  // the config still forbids the volume the author meant.
+  for (size_t i = 0; i + 5 < flat.size(); i += 6)
+    for (int k = 0; k < 3; ++k)
+      if (flat[i + k] > flat[i + 3 + k])
+        std::swap(flat[i + k], flat[i + 3 + k]);
