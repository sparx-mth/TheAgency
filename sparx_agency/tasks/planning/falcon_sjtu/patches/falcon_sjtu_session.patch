+void Astar::buildInflateOffsets() {
+  inflate_offsets_.clear();
+  if (inflate_radius_ <= 0.0)
+    return;
+
+  const double resolution = map_server_ ? map_server_->getResolution() : 0.0;
+  if (resolution <= 0.0) {
+    ROS_ERROR("[Astar] inflate_radius is %.2f m but the map has no usable "
+              "resolution (%.3f); leaving A* as a point-robot planner rather "
+              "than building a stencil of unbounded size",
+              inflate_radius_, resolution);
+    return;
+  }
+  // Half a voxel: fine enough that a sample lands in every voxel the disc
+  // touches, coarse enough that the stencil stays small.
+  const double step = std::max(resolution * 0.5, 1e-3);
+  const int extent = (int)std::ceil(inflate_radius_ / step);
+  const double radius_sq = inflate_radius_ * inflate_radius_;
+
+  std::vector<std::pair<double, std::pair<double, double> > > ranked;
+  for (int ix = -extent; ix <= extent; ++ix) {
+    for (int iy = -extent; iy <= extent; ++iy) {
+      if (ix == 0 && iy == 0)
+        continue;
+      const double ox = ix * step, oy = iy * step;
+      const double d2 = ox * ox + oy * oy;
+      if (d2 > radius_sq)
+        continue;
+      ranked.push_back(std::make_pair(d2, std::make_pair(ox, oy)));
+    }
+  }
+  // Farthest first. A node beside a wall is rejected by an outer sample, so
+  // ordering outward-in makes the common rejection the cheapest one.
+  std::sort(ranked.begin(), ranked.end(),
+            [](const std::pair<double, std::pair<double, double> > &a,
+               const std::pair<double, std::pair<double, double> > &b) {
+              return a.first > b.first;
+            });
+  for (size_t i = 0; i < ranked.size(); ++i)
+    inflate_offsets_.push_back(ranked[i].second);
+
+  ROS_WARN("[Astar] obstacles inflated by %.2f m in XY (%lu samples per node, "
+           "map resolution %.2f m); inflation suppressed within %.2f m of the "
+           "start", inflate_radius_, (unsigned long)inflate_offsets_.size(),
+           resolution, start_clearance_);
+}
+
+void Astar::refreshNoGoRegions() {
+  if (no_go_radius_ <= 0.0)
+    return;
+  const double now = ros::Time::now().toSec();
+  if (now - no_go_last_read_ < no_go_refresh_s_)
+    return;
+  no_go_last_read_ = now;
+  std::vector<double> flat;
+  if (!ros::param::get("/astar/no_go_runtime", flat))
+    flat.clear();
+  no_go_.swap(flat);
+}
+
+void Astar::buildInflateOffsetsIfNeeded() {
+  if (inflate_offsets_built_)
+    return;
+  // One attempt per usable resolution: if the map still has none there is
+  // nothing to build from, and retrying every node would cost more than the
+  // stencil saves.
+  if (map_server_ && map_server_->getResolution() > 0.0) {
+    inflate_offsets_built_ = true;
+    buildInflateOffsets();
+  }
+}
+
+bool Astar::isBlockedInflated(const Eigen::Vector3d &pos, const Eigen::Vector3d &start) {
+  buildInflateOffsetsIfNeeded();
+
+  const voxel_mapping::OccupancyType here =
+      map_server_->getOccupancyGrid()->getVoxel(pos).value;
+  if (here == voxel_mapping::OccupancyType::OCCUPIED ||
+      here == voxel_mapping::OccupancyType::UNKNOWN)
+    return true;
+  if (inflate_offsets_.empty())
+    return false;
+  // NOTE: no early return on !inflate_enabled_ -- the fallback pass keeps a
+  // reduced skirt (see below) rather than becoming a point-robot test.
+  // An aircraft that has drifted against a wall is inside its own skirt. Keep
+  // the skirt off near the start or it can never plan away from it.
+  if (start_clearance_ > 0.0 && (pos - start).head<2>().norm() < start_clearance_)
+    return false;
+
+  // On the fallback pass the aircraft still has a WIDTH: fall back to half the
+  // radius, never to a point robot.
+  //
+  // Dropping the clearance requirement entirely is what let a warehouse leg be
+  // routed back into 0.14-0.38 m clutter slots -- 61 fallbacks, 278 bumper
+  // reports over 32 episodes on four piles, and a CAPSIZE at 103.9 m3, against
+  // CLEAN at 352.1 m3 with zero contacts on the same world when the inflation
+  // was mandatory. The hospital needed the fallback for the opposite reason:
+  // its 0.930 m doorways leave a 0.53 m band after full inflation and the 0.5 m
+  // search lattice need not land a node inside it, so a doorway the aircraft
+  // fits through read as sealed (1068 no-path lines in one run).
+  //
+  // Half the radius separates the two. Against a 0.5 m lattice it leaves a
+  // 0.73 m band in a 0.930 m doorway, which a node reaches, and a 0.18 m band
+  // in a 0.38 m clutter slot, which one does not.
+  const double limit = inflate_enabled_ ? inflate_radius_ : 0.5 * inflate_radius_;
+  const double limit_sq = limit * limit;
+  for (size_t i = 0; i < inflate_offsets_.size(); ++i) {
+    const double ox = inflate_offsets_[i].first, oy = inflate_offsets_[i].second;
+    if (ox * ox + oy * oy > limit_sq)
+      continue;   // sorted farthest-first, so this skips the outer ring
+    const Eigen::Vector3d p(pos.x() + ox, pos.y() + oy, pos.z());
+    const voxel_mapping::OccupancyType v =
+        map_server_->getOccupancyGrid()->getVoxel(p).value;
+    if (v == voxel_mapping::OccupancyType::OCCUPIED ||
+        v == voxel_mapping::OccupancyType::UNKNOWN)
+      return true;
+  }
+  return false;
+}
