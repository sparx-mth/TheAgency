+void FrontierFinder::grantFinishAmnesty() {
+  if (finish_amnesty_used_ >= finish_amnesty_max_)
+    return;
+  if (blocked_regions_.empty() && dormant_frontiers_.empty())
+    return;
+  ++finish_amnesty_used_;
+  ROS_WARN("[FrontierFinder] Frontier set is empty with %lu shadow(s) still "
+           "standing and %lu cluster(s) retired behind them. The world is not "
+           "finished, it is unexamined -- dropping every shadow and re-offering "
+           "every retired cluster (amnesty %d of %d)",
+           blocked_regions_.size(), dormant_frontiers_.size(),
+           finish_amnesty_used_, finish_amnesty_max_);
+
+  // Relax viewpoint placement for the single pass that follows. The clusters
+  // handed back include ones no shadow ever touched -- retired because
+  // sampleViewpoints() could not find anywhere legal to look at them from --
+  // and re-offering those under the same rules that rejected them just retires
+  // them again, which is exactly what was measured.
+  amnesty_relax_ = true;
+
+  blocked_regions_.clear();
+  blocked_regions_stamp_.clear();
+  blocked_regions_strikes_.clear();
+  ros::param::set("/frontier_finder/blocked_regions_runtime", std::vector<double>());
+
+  // Hand the retired clusters back through the ordinary categorisation path
+  // rather than resurrecting them by hand: with the shadows gone they get
+  // sampleViewpoints() called on them exactly as a freshly detected cluster
+  // would, and anything still unviewable returns to dormant on its own.
+  //
+  // The strike HISTORY is deliberately not cleared. A pocket that defeated the
+  // aircraft before starts its second life at the strike count it already
+  // earned, so it retires faster this time and the mission still terminates.
+  for (list<Frontier>::iterator it = dormant_frontiers_.begin();
+       it != dormant_frontiers_.end(); ++it) {
+    // sampleViewpoints() asserts the cluster it is handed is CLEAN
+    // (CHECK_EQ(frontier.viewpoints_.size(), 0)), and the clusters
+    // sweepBlockedFrontiers() retires come off frontiers_ still carrying the
+    // viewpoints they were selected on. Handing one of those back unmodified
+    // aborts the node from inside the frontier finder and takes the voxel map
+    // with it -- measured, exit code -6 at "Frontier already has viewpoints
+    // (4 vs. 0)" the instant the first amnesty fired. So the amnesty hands back
+    // a cluster in the state a freshly detected one would be in, and lets
+    // categorisation recompute the rest; visib_num_ is reset by
+    // sampleViewpoints itself.
+    Frontier revived = *it;
+    revived.viewpoints_.clear();
+    revived.visib_num_ = 0;
+    tmp_frontiers_.push_back(revived);
+  }
