+std::vector<double> loadKeepOutBoxes() {
+  std::vector<double> flat;
+  if (!ros::param::get("/map_config/keep_out_boxes", flat))
+    return std::vector<double>();
+  if (flat.size() % 6 != 0) {
+    ROS_ERROR("[keep_out] /map_config/keep_out_boxes has %lu values, which is "
+              "not a multiple of 6 (xmin ymin zmin xmax ymax zmax); ignoring "
+              "the remainder", (unsigned long)flat.size());
