+void FrontierFinder::sweepBlockedFrontiers() {
+  if ((blocked_regions_.empty() && keep_out_.empty()) || frontiers_.empty())
+    return;
+  int retired = 0;
+  for (list<Frontier>::iterator it = frontiers_.begin(); it != frontiers_.end();) {
+    bool in_blocked = insideKeepOut(keep_out_, it->average_.x(),
+                                    it->average_.y(), it->average_.z());
+    for (size_t i = 0; !in_blocked && i < blocked_regions_.size(); ++i)
+      if ((blocked_regions_[i] - it->average_).norm() <
+          blockedRadiusFor(blocked_regions_strikes_[i])) {
+        in_blocked = true;
+        break;
+      }
+    if (!in_blocked) {
+      ++it;
+      continue;
+    }
