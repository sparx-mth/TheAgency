+
+bool insideKeepOut(const std::vector<double> &boxes, const double x,
+                   const double y, const double z) {
+  for (size_t i = 0; i + 5 < boxes.size(); i += 6) {
+    if (x >= boxes[i] && x <= boxes[i + 3] && y >= boxes[i + 1] &&
+        y <= boxes[i + 4] && z >= boxes[i + 2] && z <= boxes[i + 5])
+      return true;
+  }
+  return false;
+}
