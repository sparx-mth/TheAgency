+void FrontierFinder::addBlockedRegion(const Vector3d &pos) {
+  // Coalesce nearby reports so a wall the aircraft grinds along a few times
+  // does not fill the list; one marker per radius is enough to shadow it.
+  // A repeat report REFRESHES the shadow rather than being dropped: the
+  // aircraft is telling us it is still stuck there, which is exactly the
+  // evidence that should keep the region shadowed for another full TTL.
+  // One strike per report against the coarse history, whether or not this
+  // report becomes a new shadow. This is what makes a pocket that keeps
+  // defeating the aircraft retire, even though it never fails twice in the
+  // same spot.
+  int strikes = 1;
+  bool found_history = false;
+  for (size_t i = 0; i < blocked_history_.size(); ++i)
+    if ((blocked_history_[i] - pos).norm() < blocked_region_escalate_radius_) {
+      strikes = ++blocked_history_strikes_[i];
+      found_history = true;
+      break;
+    }
+  if (!found_history) {
+    blocked_history_.push_back(pos);
+    blocked_history_strikes_.push_back(1);
+  }
+
+  for (size_t i = 0; i < blocked_regions_.size(); ++i)
+    if ((blocked_regions_[i] - pos).norm() <
+        blockedRadiusFor(blocked_regions_strikes_[i])) {
+      blocked_regions_stamp_[i] = ros::Time::now().toSec();
+      blocked_regions_strikes_[i] = strikes;
+      ROS_WARN("[FrontierFinder] Blocked region (%.2f, %.2f, %.2f) re-reported "
+               "on strike %d; shadow now %.1f m for %.0f s",
+               blocked_regions_[i].x(), blocked_regions_[i].y(),
+               blocked_regions_[i].z(), strikes, blockedRadiusFor(strikes),
+               blocked_region_ttl_s_ *
+                   double(1 << std::min(strikes - 1,
+                                        blocked_region_ttl_max_doubling_)));
+      return;
+    }
+  blocked_regions_.push_back(pos);
+  blocked_regions_stamp_.push_back(ros::Time::now().toSec());
+  blocked_regions_strikes_.push_back(strikes);
+  // Persist to the param server: this node respawns after LKH crashes and a
+  // fresh process would otherwise forget every hard-won shadow, sending the
+  // coverage tour straight back to viewpoints physics already vetoed.
+  {
+    std::vector<double> flat;
+    ros::param::get("/frontier_finder/blocked_regions_runtime", flat);
+    flat.push_back(pos.x());
+    flat.push_back(pos.y());
+    flat.push_back(pos.z());
+    ros::param::set("/frontier_finder/blocked_regions_runtime", flat);
+  }
+  ROS_WARN("[FrontierFinder] Blocked unreachable viewpoint (%.2f, %.2f, %.2f) "
+           "on strike %d; %lu region(s) now shadowed from the coverage tour",
+           pos.x(), pos.y(), pos.z(), strikes, blocked_regions_.size());
+}
