+bool FrontierFinder::confineRetires(const Eigen::Vector3d &p) const {
+  // NO start exemption here, deliberately, and it is the difference between
+  // this and the A* test. A* must let the aircraft plan its way OUT of a
+  // blocked doorway it is sitting in; the frontier finder must never OFFER a
+  // cluster outside the room, however close the aircraft happens to be to it.
+  // Retiring the out-of-room clusters is what stops FALCON WANTING to leave --
+  // sealing the doors alone would leave the coverage tour targeting the rest
+  // of the building, A* returning NO_PATH at the seal, and the publish-fail
+  // blacklist casting shadows over the very doorway we must fly back out of.
+  if (confine_keep_in_.empty() && confine_keep_out_.empty())
+    return false;
+  if (!confine_keep_in_.empty() &&
+      !insideKeepOut(confine_keep_in_, p.x(), p.y(), p.z()))
+    return true;
+  return insideKeepOut(confine_keep_out_, p.x(), p.y(), p.z());
+}
