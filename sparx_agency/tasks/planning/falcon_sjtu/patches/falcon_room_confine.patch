+void Astar::refreshConfinement() {
+  const double now = ros::Time::now().toSec();
+  if (now - confine_last_read_ < confine_refresh_s_)
+    return;
+  confine_last_read_ = now;
+  // The DEADLINE is read first, and the geometry is not read at all when the
+  // lease is dead. That ordering is the fail-open: no host, no block, and the
+  // planner does not even pay for the parameter reads.
+  double deadline = 0.0;
+  ros::param::param("/map_config/confine_deadline", deadline, 0.0);
+  confine_deadline_ = deadline;
+  if (!(confine_deadline_ > now)) {   // absent, expired, or NaN
+    keep_in_.clear();
+    keep_out_runtime_.clear();
+    return;
+  }
+  keep_in_ = loadBoxes("/map_config/keep_in_runtime");
+  keep_out_runtime_ = loadBoxes("/map_config/keep_out_runtime");
+}
+
+bool Astar::confineBlocks(const Eigen::Vector3d &pos,
+                          const Eigen::Vector3d &start) {
+  if (keep_in_.empty() && keep_out_runtime_.empty())
+    return false;
+  // The aircraft's own neighbourhood is never confined. A drone that has
+  // drifted into a blocked doorway -- or that is handed a room whose box it
+  // is standing just outside of -- must still be able to plan its way out.
+  // Same asymmetry start_clearance_ already grants the inflation skirt, and
+  // for the same reason: a fence the aircraft is inside of is a trap.
+  if (confine_start_exempt_ > 0.0 &&
+      (pos - start).head<2>().norm() < confine_start_exempt_)
+    return false;
+  if (!keep_in_.empty() && !insideAnyBox(keep_in_, pos.x(), pos.y(), pos.z()))
+    return true;
+  return insideAnyBox(keep_out_runtime_, pos.x(), pos.y(), pos.z());
+}
