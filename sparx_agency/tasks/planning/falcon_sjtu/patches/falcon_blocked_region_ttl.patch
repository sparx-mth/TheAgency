+void FrontierFinder::expireBlockedRegions() {
+  if (blocked_region_ttl_s_ <= 0.0 || blocked_regions_.empty())
+    return;
+  const double now = ros::Time::now().toSec();
+  vector<Vector3d> kept;
+  vector<double> kept_stamp;
+  vector<int> kept_strikes;
+  kept.reserve(blocked_regions_.size());
+  kept_stamp.reserve(blocked_regions_stamp_.size());
+  kept_strikes.reserve(blocked_regions_strikes_.size());
+  for (size_t i = 0; i < blocked_regions_.size(); ++i) {
+    // A stamp in the future means the clock was reset under us (sim restart).
+    // Treat that as fresh rather than as infinitely old.
+    double age = now - blocked_regions_stamp_[i];
+    int doublings = blocked_regions_strikes_[i] - 1;
+    if (doublings > blocked_region_ttl_max_doubling_)
+      doublings = blocked_region_ttl_max_doubling_;
+    double ttl = blocked_region_ttl_s_ * double(1 << doublings);
+    if (age < 0.0 || age <= ttl) {
+      kept.push_back(blocked_regions_[i]);
+      kept_stamp.push_back(blocked_regions_stamp_[i]);
+      kept_strikes.push_back(blocked_regions_strikes_[i]);
+    } else {
+      ROS_WARN("[FrontierFinder] Blocked region (%.2f, %.2f, %.2f) has expired "
+               "after %.0f s (strike %d, ttl %.0f s); the coverage tour may try "
+               "it again", blocked_regions_[i].x(), blocked_regions_[i].y(),
+               blocked_regions_[i].z(), age, blocked_regions_strikes_[i], ttl);
+    }
+  }
+  if (kept.size() == blocked_regions_.size())
+    return;
+  blocked_regions_.swap(kept);
+  blocked_regions_stamp_.swap(kept_stamp);
+  blocked_regions_strikes_.swap(kept_strikes);
+  // Keep the persisted copy in step, or a respawn would restore the shadows
+  // that have just been retired and make the TTL unobservable across a crash.
+  std::vector<double> flat;
+  flat.reserve(blocked_regions_.size() * 3);
+  for (const auto &b : blocked_regions_) {
+    flat.push_back(b.x());
+    flat.push_back(b.y());
+    flat.push_back(b.z());
+  }
+  ros::param::set("/frontier_finder/blocked_regions_runtime", flat);
+}
