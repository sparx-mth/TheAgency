@@ -944,6 +944,43 @@ int ExplorationManager::planExploreMotionHGrid(const Vector3d &pos, const Vector
   LOG(INFO) << "[ExplorationManager] Next pos: " << next_pos[0] << ", " << next_pos[1] << ", "
             << next_pos[2] << ", yaw: " << next_yaw;
 
+  // ── Dead-end guard: retire a viewpoint the aircraft cannot physically reach.
+  // FALCON routes A* through obstacles that sit inside the depth near clip
+  // (~0.95 m) and so never enter the map, then re-selects the same blocked
+  // viewpoint forever. The controller sees the collision but not the frontiers;
+  // this node sees the frontiers but not the collision. Close the gap with the
+  // one thing this node has -- the drone pose and its own chosen target: if the
+  // aircraft has not closed on next_pos for a sustained spell, the route is a
+  // fiction, so hand the spot to the frontier finder to shadow and move on.
+  {
+    // Block a viewpoint the aircraft cannot reach. "Cannot reach" shows up two
+    // ways, both of which are simply "went nowhere": pinned in contact, or
+    // wandering a tight region between viewpoints it keeps almost-reaching
+    // without ever clearing the frontier behind them (so coverage stops but the
+    // aircraft still drifts >1 m, which fooled a simple pinned test). Track it
+    // over a window: if its whole excursion stays under 2 m for 25 s while it is
+    // still not AT the viewpoint it is being sent to, the route is a fiction (an
+    // obstacle inside the depth near clip the map never caught) -- shadow it so
+    // the frontier finder retires the cluster and the tour moves on.
+    static std::vector<std::pair<double, Vector3d>> track;
+    const double now_s = ros::Time::now().toSec();
+    track.push_back(std::make_pair(now_s, pos));
+    while (track.size() > 1 && track.front().first < now_s - 25.0)
+      track.erase(track.begin());
+    const bool at_target = (pos - next_pos).norm() < 0.6;
+    double span = 0.0;
+    for (size_t i = 0; i < track.size(); ++i)
+      span = std::max(span, (track[i].second - pos).norm());
+    if (!at_target && track.front().first <= now_s - 25.0 && span < 2.0) {
+      frontier_finder_->addBlockedRegion(next_pos);
+      ROS_WARN("[ExplorationManager] Aircraft confined to <2 m for 25 s short of "
+               "viewpoint (%.2f, %.2f, %.2f); blocking it so the coverage tour "
+               "moves on",
+               next_pos[0], next_pos[1], next_pos[2]);
+      track.clear();
+    }
+  }
+
   // Local planner
   // Require next_pos, next_yaw from global planner
   // pos, vel, acc, yaw: current states
