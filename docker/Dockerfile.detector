# ============================================================
# Sibling layer to `robotican` (and the future `xtend`) off `perception`:
# the YOLO-World object-detector sidecar (yolo_world_trt), kept in its own
# container rather than folded into `robotican` or the shared `perception`
# layer.
#
# Why not `perception`: that Dockerfile's own comment states torch is
# deliberately absent there ("nothing in THIS container's dependency set
# needs it") -- adding it there would affect every future robot image built
# on top (ROBOTICAN now, XTEND later), not just the detector.
#
# Why not a `robotican` addition: yolo_world_trt
# (sparx_agency/tasks/mapping/yolo_world_trt) is shared task-level infra,
# not ROBOTICAN/Rooster-specific -- any robot's camera feed can use it. A
# dedicated sibling keeps `robotican_dev` focused on ROS2/Rooster concerns
# (frame capture, depth, localization) and lets this container be rebuilt
# independently (heavier/slower to build: torch + CLIP).
#
# torch==2.11.0 is the version already validated working on the host venv
# 2026-07-29 (see LESSONS.md's "broken torch import" entry) -- that entry's
# cu12/cu13 conflict came from a STALE leftover install on an existing venv;
# a fresh image build like this one resolves cleanly from scratch since
# nothing here installs a cu12 variant first.
# ============================================================
FROM theagency:perception

ENV DEBIAN_FRONTEND=noninteractive

# --timeout/--retries: torch's CUDA 13 wheels are large; pip's default read
# timeout can trip mid-download well before anything is actually wrong (same
# rationale as Dockerfile.perception's tensorrt install).
RUN pip3 install --no-cache-dir --timeout 600 --retries 8 \
      torch==2.11.0 torchvision==0.26.0

RUN pip3 install --no-cache-dir ultralytics==8.4.110

# ultralytics' YOLO-World auto-installs this CLIP dependency on first use
# (git+https://github.com/ultralytics/CLIP.git) if missing -- baked in here
# instead so the container needs no network/git access at runtime and the
# detector sidecar starts immediately instead of pausing for an AutoUpdate.
RUN pip3 install --no-cache-dir "git+https://github.com/ultralytics/CLIP.git"

# Container user matching the host's UID/GID (user1:1000:1000) -- same
# rationale as Dockerfile.robotican (repo mounted at the SAME absolute path
# as the host, so file ownership must match).
ARG USERNAME=user1
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME} \
    && usermod -aG video,dialout ${USERNAME}

USER ${USERNAME}
WORKDIR /home/${USERNAME}/GIT/TheAgency
ENV PYTHONUNBUFFERED=1

CMD ["bash"]
