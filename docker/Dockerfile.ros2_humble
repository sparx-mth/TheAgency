# ============================================================
# Layer 2/4: ros2_humble -- ROS 2 Humble on top of base_cuda.
#
# Generic ROS install only -- no GStreamer, no TensorRT, no vendor msgs.
# Humble on both PC and the eventual Jetson build (matches Sphera's own
# `drone_simulator` container, confirmed Humble/py3.10). If a different
# distro is ever needed, add a sibling Dockerfile.ros2_<distro>, don't
# parametrize this one.
# ============================================================
FROM theagency:base_cuda

ENV ROS_DISTRO=humble
ENV DEBIAN_FRONTEND=noninteractive

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
       http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) main" \
       > /etc/apt/sources.list.d/ros2.list

# The packages every robot's mapping/localization/replay-viewer path needs:
# cv_bridge (depth nodes), tf2_ros (TF), rmw_cyclonedds_cpp (matches Sphera's
# DDS config), octomap-server + rviz2 (mapping/replay verification), colcon
# (to build any robot's vendor workspace).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-ros-base \
      ros-humble-cv-bridge \
      ros-humble-tf2-ros \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-octomap-server \
      ros-humble-rviz2 \
      python3-colcon-common-extensions \
      python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
